      allow create: if selectorStaffDeductionsCreate(newData());
      function selectorStaffDeductionsUpdate(data,before) {
        return ownerDeductionKind(before,deductId) || ownerDeductionKind(data,deductId)
        ? (data.status == 'Paid' ? ownerDeductionCompanionPaid(before,data,deductId,before.reviewRevision) : ownerDeductionChargeReview(before,data,deductId))
        : cashShortageKind(before,deductId) || cashShortageKind(data,deductId)
        ? (data.status == 'Paid' ? cashShortageCompanionPaid(before,data,deductId,before.reviewRevision) : cashShortageChargeReview(before,data,deductId))
        : before.get('type', '') == 'Online Order Refund' || data.get('type', '') == 'Online Order Refund' || deductId.matches('online-refund-.*')
        ? (offlineOwner() && before.type == 'Online Order Refund' && data.amount == 0
          && before.status == 'Pending Review'
          && data.diff(before).affectedKeys().hasOnly(['status','responseRecorded','reviewedAt','reviewedBy'])
          && data.responseRecorded == true
          && data.status in ['Pending Review','Dismissed']
          && data.status == nextData('online_order_incidents',deductId).status
          && data.reviewedAt == reqTime() && data.reviewedBy == reqEmail()) || (before.get('type','') == 'Online Order Refund' && (directChargeReview(before,data,deductId) || refundPaid(before,data,deductId)))
