        && data.staffId == row.staffId && data.staffName == row.staffName
        && data.sourceSaleId == row.sourceSaleId && data.sourceReceiptId == row.sourceReceiptId
        && data.sourcePlatform == row.sourcePlatform && data.proposedAmount == row.refundAmount
        && data.dateAdded == reqTime() && data.loggedBy == reqEmail();
    }

      function directIncidentCharge(data,id) {
      let row = nextData('online_order_incidents',id);
      return offlineOwner() && row.version == 2 && data.type == 'Online Order Refund' && data.category == 'Online Order Refunds'
        && data.incidentId == id && data.staffId == row.staffId && data.staffName == row.staffName
        && data.branch == row.staffBranch && data.sourceBranch == row.branch && data.sourceSaleId == row.sourceSaleId
        && data.sourceReceiptId == row.sourceReceiptId && data.sourcePlatform == row.sourcePlatform
        && data.status == row.status && data.amount == row.amount && data.authorizedAmount == row.amount
        && data.proposedAmount == row.refundAmount && data.noticeRevision == 1 && data.dateAdded == reqTime() && data.loggedBy == reqEmail();
    }

      function directChargeReview(before,after,id) {
      let row = nextData('online_order_incidents',id);
      return offlineOwner() && before.type == 'Online Order Refund' && before.status in ['Pending Review','Unpaid']
        && after.diff(before).affectedKeys().hasOnly(['status','amount','authorizedAmount','noticeRevision','responseRecorded','reviewedAt','reviewedBy'])
        && after.status == row.status && after.amount == row.amount && after.authorizedAmount == row.amount
        && after.noticeRevision == before.get('noticeRevision',0) + 1 && row.reviewedAt == reqTime() && after.reviewedAt == reqTime() && after.reviewedBy == reqEmail() && after.responseRecorded == true;
