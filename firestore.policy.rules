      function complianceFileMeta(data) {
      return {'id':data.id,'kind':data.kind,'recordId':data.recordId,'fileName':data.fileName,'contentType':data.contentType,'size':data.size,'sha256':data.sha256,'chunkCount':data.chunkCount};
    }

      allow get: if complianceOwner();
      allow list, update, delete: if false;
      function ownerRecordManifestCreate(data) {
        return complianceOwner() && data.keys().hasOnly(['schemaVersion','id','kind','recordId','fileName','contentType','size','sha256','chunkCount','chunkSize','operationId','createdAt','createdByUid','createdByEmail'])
          && data.schemaVersion == 1 && data.id == id
          && data.kind in ['government_permit','sss_remittance','bookkeeper_payment']
          && complianceFileDescriptor(complianceFileMeta(data),data.kind,data.recordId)
          && data.chunkSize == 147456 && complianceId(data.operationId)
