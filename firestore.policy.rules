      function onlineIncidentCharge(data, id) {
      let row = nextData('online_order_incidents',id);
      return offlineOwner() && data.type == 'Online Order Refund' && data.amount == 0
        && data.category == 'Online Order Refunds' && data.status == 'Pending Review'
