      function ownerDeductionChargeCreate(data,id) {
      let row = nextData('owner_deduction_reviews',id);
      // The source must be newly created in this atomic request. Its create
      // rule validates all three exact links; keep this public schema strict.
      return ownerDeductionOwner() && !exists(/databases/$(database)/documents/owner_deduction_reviews/$(id))
        && row.status == 'Pending Review' && data.status == 'Pending Review' && data.amount == 0
        && data.dateAdded == reqTime() && data.loggedBy == reqEmail()
        && data.remarks == 'Owner custom deduction review only; no payroll charge is authorized.'
        && data.keys().hasOnly(['incidentId','type','staffId','staffName','branch','sourcePlatform','sourceReceiptId','label','category','incidentDate','amount','effectiveDate','status','ownerDeductionVersion','authorizedAmount','reviewRevision','dateAdded','loggedBy','remarks']);
    }

      function ownerDeductionChargeReview(before,after,id) {
      let prior = readData('owner_deduction_reviews',id);
      let row = nextData('owner_deduction_reviews',id);
      return ownerDeductionOwner() && before.status in ['Pending Review','Unpaid'] && !before.keys().hasAny(paidKeys())
        && after.diff(before).affectedKeys().hasOnly(['status','amount','authorizedAmount','effectiveDate','reviewRevision','reviewedAt','reviewedBy'])
        && after.reviewRevision == before.reviewRevision + 1 && after.reviewedAt == reqTime() && after.reviewedBy == reqEmail()
        // A changed source revision forces its authoritative update rule in
        // this atomic request. That rule checks both complete companion links.
        && row.revision == prior.revision + 1 && after.reviewRevision == row.revision
        && after.status == (row.status == 'Approved' ? 'Unpaid' : 'Dismissed') && row.reviewedAt == reqTime();
    }

      function cashShortageChargeCreate(data,id) {
      let row = nextData('cash_shortage_reviews',id);
      let notice = nextData('staff_deduction_notices',id);
      return offlineOwner() && !exists(/databases/$(database)/documents/cash_shortage_reviews/$(id))
        && cashShortageLinks(row,data,notice,id) && row.status == 'Pending Review' && data.status == 'Pending Review' && data.amount == 0
        && data.dateAdded == reqTime() && data.loggedBy == reqEmail()
        && data.keys().hasOnly(['incidentId','type','staffId','staffName','branch','sourceShiftId','sourceReceiptId','sourcePlatform','amount','effectiveDate','status','cashShortageVersion','sourceBranch','authorizedAmount','reviewRevision','dateAdded','loggedBy','remarks']);
    }

      function cashShortageChargeReview(before,after,id) {
      let row = nextData('cash_shortage_reviews',id);
      let notice = nextData('staff_deduction_notices',id);
      return offlineOwner() && before.status in ['Pending Review','Unpaid'] && !before.keys().hasAny(paidKeys())
        && after.diff(before).affectedKeys().hasOnly(['status','amount','authorizedAmount','effectiveDate','reviewRevision','reviewedAt','reviewedBy'])
        && after.reviewRevision == before.reviewRevision + 1 && after.reviewedAt == reqTime() && after.reviewedBy == reqEmail()
