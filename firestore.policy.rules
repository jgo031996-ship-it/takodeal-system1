      }
      allow create, update: if selectorStaffSssAllocationTotalsCreateUpdate(newData(),resource == null ? null : oldData());
      allow delete: if false;
    }
    match /bookkeeper_payments/{id} {
      allow read: if complianceOwner();
      function bookkeeperPaymentCreate(data) {
        return complianceOwner() && data.keys().hasOnly(['schemaVersion','recordId','payee','branch','serviceMonth','paidDate','amountCents','paymentMethod','reference','notes','attachment','intent','recordedAt','recordedByUid','recordedByEmail'])
          && data.schemaVersion == 1 && data.recordId == id && id.matches('^bookkeeper-[a-f0-9]{64}$')
          && complianceText(data.payee,120) && data.payee.size()>0
          && complianceText(data.branch,100) && data.branch.size()>0
          && complianceMonth(data.serviceMonth) && complianceDay(data.paidDate)
          && data.amountCents is int && data.amountCents>0 && data.amountCents<=99999999999
          && data.paymentMethod in ['Cash','Bank transfer','GCash','Other']
          && complianceText(data.reference,120) && data.reference.size()>0
