      allow read: if true;
      function selectorStaffDeductionsCreate(data) {
        return ownerDeductionKind(data,deductId) ? ownerDeductionChargeCreate(data,deductId)
        : cashShortageKind(data,deductId) ? cashShortageChargeCreate(data,deductId)
