      return data.purchaseId == id && !exists(/databases/$(database)/documents/transactions/$(id))
        && purchase.get('cancelledFoodSourceId', '') != ''
        && purchase.branch == data.branch && purchase.cancelledFoodStaffId == data.staffId
        && purchase.customerName == data.staffName && purchase.netTotal == data.amount
        && (purchase.get('cancelledFoodPortionVersion',0) != 1 || data.purchasedItems == purchase.cart);
