          let eligible = complianceOwner() && data.keys().hasOnly(['schemaVersion','fileId','index','size','sha256','data'])
            && data.schemaVersion == 1 && data.fileId == id
            && data.index is int && data.index>=0 && data.index<15
            && chunkId == (data.index<10 ? '000'+string(data.index) : '00'+string(data.index))
            && data.size is int && data.size>0 && data.size<=147456
            && data.sha256.matches('^[a-f0-9]{64}$')
            && data.data is string && data.data.size()>0 && data.data.size()<=196608
            && data.data.matches('^[A-Za-z0-9+/]*={0,2}$')
            && !exists(manifestPath);
