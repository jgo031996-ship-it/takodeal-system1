    match /owner_record_files/{id} {
      function complianceFileParent(data,id) {
      let parent = data.kind == 'government_permit'
        ? nextData('government_permits',data.recordId)
        : data.kind == 'sss_remittance' ? nextData('staff_sss_remittances',data.recordId)
        : nextData('bookkeeper_payments',data.recordId);
