      }
      allow update: if selectorStaffDeductionsUpdate(newData(),resource == null ? null : oldData());
      function selectorStaffDeductionsDelete(before) {
        return !ownerDeductionKind(before,deductId) && !cashShortageKind(before,deductId) && before.get('type', '') != 'Online Order Refund'
        && (before.get('type', '') == 'Cancelled Food Purchase' ? verifiedHQ(before.branch) : isHQUser());
