    }
    // Owner compliance records are independent of payroll and bank postings.
    function complianceOwner() {
      return offlineOwner() && reqProvider() == 'google.com';
    }
    function complianceText(value, maximum) { return value is string && value.size() <= maximum; }
    function complianceId(value) { return value is string && value.matches('^[A-Za-z0-9_-]{1,180}$'); }
    function complianceDay(value) { return value is string && value.matches('^2[01][0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'); }
    function complianceMonth(value) { return value is string && value.matches('^2[01][0-9]{2}-(0[1-9]|1[0-2])$'); }

    function complianceCents(value) { return value is int && value >= 0 && value <= 1000000000; }
    function complianceFileDescriptor(value, kind, recordId) {
      return value is map && value.keys().hasOnly(['id','kind','recordId','fileName','contentType','size','sha256','chunkCount'])
        && value.id is string && value.id.matches('^[a-fA-F0-9-]{36}$') && value.kind == kind && value.recordId == recordId
        && complianceText(value.fileName,160) && value.fileName.size() > 0
        && value.contentType in ['application/pdf','image/jpeg','image/png']
        && value.size is int && value.size > 0 && value.size <= 2097152
        && value.sha256 is string && value.sha256.matches('^[a-f0-9]{64}$')
        && value.chunkCount is int && value.chunkCount >= 1 && value.chunkCount <= 15
        && value.chunkCount == int(math.ceil(value.size / 147456.0));
    }
    function complianceAttachment(value, kind, recordId) {
      return value == null || (complianceFileDescriptor(value,kind,recordId)
        && nextData('owner_record_files',value.id).diff(value).affectedKeys().hasOnly([
          'schemaVersion','chunkSize','operationId','createdAt','createdByUid','createdByEmail']));
    }
    function permitBusiness(data) {
      return {'branch':data.branch,'permitType':data.permitType,'permitName':data.permitName,'agency':data.agency,
        'permitNumber':data.permitNumber,'issueDate':data.issueDate,'expiryDate':data.expiryDate,'renewalStatus':data.renewalStatus,
        'notes':data.notes,'attachment':data.attachment,'archived':data.archived};
    }


    match /government_permits/{id} {
      function permitRecordDay(value) { return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'); }

      function permitShape(data, id) {
      return data.keys().hasOnly(['schemaVersion','recordId','branch','permitType','permitName','agency','permitNumber','issueDate','expiryDate','renewalStatus','notes','attachment','archived','revision','createdAt','createdByUid','createdByEmail','updatedAt','updatedByUid','updatedByEmail','lastChangeId'])
        && data.schemaVersion == 1 && data.recordId == id && complianceId(id)
        && complianceText(data.branch,120) && data.branch.size() > 0
        && complianceText(data.permitType,80) && data.permitType.size() > 0
        && complianceText(data.permitName,160) && data.permitName.size() > 0
        && complianceText(data.agency,160) && complianceText(data.permitNumber,120)
        && (data.issueDate == '' || permitRecordDay(data.issueDate)) && (data.expiryDate == '' || permitRecordDay(data.expiryDate))
        && (data.issueDate == '' || data.expiryDate == '' || data.expiryDate >= data.issueDate)
        && data.renewalStatus in ['Not started','Preparing','Submitted','Completed','Not required']
        && complianceText(data.notes,4000) && data.archived is bool && data.revision is int && data.revision > 0
        && complianceAttachment(data.attachment,'government_permit',id) && complianceId(data.lastChangeId)
        && data.updatedAt == reqTime() && data.updatedByUid == reqUid() && data.updatedByEmail == reqEmail();
    }

      function permitChange(data,id,before,action) {
      let event = getAfter(/databases/$(database)/documents/government_permits/$(id)/changes/$(data.lastChangeId)).data;
      return event.schemaVersion == 1 && event.operationId == data.lastChangeId && event.recordId == id
        && event.revision == data.revision && event.action == action && event.before == before && event.after == permitBusiness(data)
        && event.recordedAt == reqTime() && event.recordedByUid == reqUid() && event.recordedByEmail == reqEmail();
    }

      allow read: if complianceOwner();
      function selectorGovernmentPermitsCreateUpdate(data,before) {
        return complianceOwner() && permitShape(data,id)
        && data.revision == (resource == null ? 1 : before.revision + 1)
        && data.createdAt == (resource == null ? reqTime() : before.createdAt)
        && data.createdByUid == (resource == null ? reqUid() : before.createdByUid)
        && data.createdByEmail == (resource == null ? reqEmail() : before.createdByEmail)
        && (resource == null || data.lastChangeId != before.lastChangeId)
        && permitChange(data,id,resource == null ? null : permitBusiness(before),
          resource == null ? 'Created' : data.archived != before.archived
          ? (data.archived ? 'Archived' : 'Restored') : 'Updated');
      }
      allow create, update: if selectorGovernmentPermitsCreateUpdate(newData(),resource == null ? null : oldData());
      allow delete: if false;
      match /changes/{changeId} {
        allow read: if complianceOwner();
        function selectorGovernmentPermitsChangesCreate(data) {
          return complianceOwner() && data.keys().hasOnly(['schemaVersion','operationId','recordId','revision','action','before','after','reason','recordedAt','recordedByUid','recordedByEmail','intent'])
          && data.schemaVersion == 1 && data.operationId == changeId
          && data.recordId == id && data.revision is int
          && data.action in ['Created','Updated','Archived','Restored']
          && complianceText(data.reason,1000) && data.intent.matches('^[a-f0-9]{64}$')
          && data.recordedAt == reqTime() && data.recordedByUid == reqUid() && data.recordedByEmail == reqEmail()
          && nextData('government_permits',id).lastChangeId == changeId
          && nextData('government_permits',id).revision == data.revision
          && data.after == permitBusiness(nextData('government_permits',id));
        }
        allow create: if selectorGovernmentPermitsChangesCreate(newData());
        allow update, delete: if false;
      }
    }
    function sssFrozenCents(value) {
      return value is number && value >= 0 ? math.round(value * 100)
        : value is string && value.matches('^[0-9]+([.][0-9]{1,2})?$') ? math.round(float(value) * 100) : -1;
    }
    function sssSavedPayroll(row,staffId,staffName) {
      let saved = readData('payroll_records',row.payrollRecordId);
      let frozen = saved.frozenData;
      let net = saved.get('finalNetPay',null);
      let frozenNet = frozen.get('finalNetPay',net);
      let ids = [saved.get('staffId',''),frozen.get('staffId',''),frozen.get('profile',{}).get('staffId','')];
      let start = row.startDate;
      let end = row.endDate;
      return [saved.startDate,saved.endDate,frozen.get('start',start),frozen.get('end',end)] == [start,end,start,end]
        && start <= end && complianceDay(start) && complianceDay(end)
        && ids.toSet().hasOnly(['',staffId]) && (staffId in ids
          || (saved.get('staffName','') == staffName && frozen.get('name',staffName) == staffName))
        && frozen is map && saved.get('isPaid',true) != false && frozen.get('isPaid',true) != false
        && !(saved.get('status','').lower() in ['draft','unpaid','pending','cancelled','canceled','voided','failed'])
        && sssFrozenCents(net) >= 0 && (frozenNet == net || sssFrozenCents(frozenNet) == sssFrozenCents(net))
        && sssFrozenCents(frozen.get('sss',null)) == row.deductedCents;
    }







    match /staff_sss_remittances/{id} {
      function sssAllocationSum(rows) {
      let n = rows.size();
      return (n>0?rows[0].amountCents:0)+(n>1?rows[1].amountCents:0);
    }

      function sssPayrollAt(rows,at,staffId,staffName) {
      return rows.size()<=at || sssSavedPayroll(rows[at],staffId,staffName);
    }

      function sssRecord(data,id) {
      let staff = readData('cashiers',data.staffId);
      let ledger = nextData('staff_sss_allocation_totals',data.staffId);
      let rows = data.allocations;
      let employee = data.employeeShareCents;
      let employer = data.employerShareCents;
      let ec = data.ecShareCents;
      let total = data.totalCents;
      return data.keys().hasOnly(['version','recordId','staffId','staffName','branch','contributionMonth','remittedDate','employeeShareCents','employerShareCents','ecShareCents','totalCents','reference','referenceKey','notes','evidenceReference','allocations','proof','intent','recordedAt','recordedByUid','recordedBy'])
        && data.version == 1 && data.recordId == id && id.matches('^sss-[a-f0-9]{64}$') && complianceId(data.staffId)
        && data.staffName == staff.get('cashierName',staff.get('fullName',staff.get('name',''))) && data.branch == staff.branch
        && complianceMonth(data.contributionMonth) && complianceDay(data.remittedDate)
        && complianceText(data.reference,120) && data.reference.size() >= 3 && complianceText(data.referenceKey,240) && data.referenceKey.size()>0
        && complianceText(data.notes,1500) && complianceText(data.evidenceReference,500) && complianceText(data.intent,30000)
        && complianceCents(employee) && complianceCents(employer) && complianceCents(ec)
        && complianceCents(total) && total > 0 && total == employee+employer+ec
        && rows is list && rows.size() <= 2
        // One monthly remittance can link the two payroll cutoffs. Split the
        // immutable frozen proofs across the required atomic pair to stay within
        // Firestore's expression limit without trusting the client allocation.
        && sssPayrollAt(rows,0,data.staffId,data.staffName)
        && employee == sssAllocationSum(rows)
        && complianceAttachment(data.proof,'sss_remittance',id) && ledger.lastRemittanceId == id
        && ledger.updatedAt == reqTime() && ledger.updatedByUid == reqUid()
        && data.recordedAt == reqTime() && data.recordedByUid == reqUid() && data.recordedBy == reqEmail();
    }

      allow read: if complianceOwner();
      allow create: if complianceOwner() && sssRecord(newData(),id);
      allow update, delete: if false;
    }
    match /staff_sss_allocation_totals/{staffId} {
      function sssAllocationIds(rows) {
      let n = rows.size();
      return [n>0?rows[0].payrollRecordId:'',n>1?rows[1].payrollRecordId:''];
    }

      function sssLedgerAllocation(row,staffId,staffName,before,after) {
      let id = row.payrollRecordId;
      let old = before.get(id,0);
      let next = after.get(id,0);
      let amount = row.amountCents;
      let deducted = row.deductedCents;
      return row.keys().hasOnly(['payrollRecordId','startDate','endDate','deductedCents','amountCents'])
        && complianceId(id) && complianceCents(deducted) && complianceCents(amount)
        && amount > 0 && amount <= deducted
        && old is int && old >= 0 && next == old + amount && next <= deducted && next > 0;
    }

      function sssLedgerAt(rows,at,staffId,staffName,before,after) {
      return rows.size()<=at || (sssLedgerAllocation(rows[at],staffId,staffName,before,after)
        && (at<1 || sssSavedPayroll(rows[at],staffId,staffName)));
    }

      function sssLedgerWrite(data,staffId,before,revision) {
      let record = nextData('staff_sss_remittances',data.lastRemittanceId);
      let rows = record.allocations;
      let ids = sssAllocationIds(rows);
      let totals = data.allocatedCentsByPayroll;
      return data.keys().hasOnly(['version','staffId','revision','allocatedCentsByPayroll','lastRemittanceId','updatedAt','updatedByUid'])
        && data.version == 1 && data.staffId == staffId && data.revision == revision+1
        && totals is map && totals.size() <= 500
        && !totals.keys().hasAny(['']) && data.lastRemittanceId.matches('^sss-[a-f0-9]{64}$')
        && !exists(/databases/$(database)/documents/staff_sss_remittances/$(data.lastRemittanceId))
        && record.recordId == data.lastRemittanceId && record.staffId == staffId && record.recordedAt == reqTime()
        && rows.size() <= 2 && ids.toSet().size() == rows.size() + (rows.size()<2?1:0)
        && totals.diff(before).affectedKeys().hasOnly(ids)
        && sssLedgerAt(rows,0,staffId,record.staffName,before,totals) && sssLedgerAt(rows,1,staffId,record.staffName,before,totals)
        && data.updatedAt == reqTime() && data.updatedByUid == reqUid();
    }

      allow read: if complianceOwner();
      function selectorStaffSssAllocationTotalsCreateUpdate(data,before) {
