          return eligible && data.index<manifest.chunkCount
            && manifest.createdAt==reqTime();
        }
        allow create: if ownerRecordChunkCreate(newData());
      }
    }

    // Private Staff document vault. These new collections never use the legacy
    // isHQUser() helper or public cashiers/branches/settings as authority.
    function docVaultOwner() { return offlineOwner(); }
    function docVaultAnonymous() {
      return isSignedIn() && reqProvider() == 'anonymous';
    }
    function docVaultId(value) {
      return value is string && value.matches('^[A-Za-z0-9_-]{1,128}$');
    }
    function docVaultKind(value) { return value in ['valid_id', 'health_card', 'clearance']; }
    function docVaultEnabled() {
      let path = /databases/$(database)/documents/staff_document_config/current;
      let present = exists(path);
      let config = present ? get(path).data : {};
      return present && config.enabled == true && config.policyVersion == 2
        && config.brokerEndpoint == 'https://asia-southeast1-takodeal-pos.cloudfunctions.net/staffDocumentBroker';
    }
    function docVaultHQ(branch) {
      let email = isSignedIn() ? request.auth.token.get('email', '') : '';
      let path = /databases/$(database)/documents/hq_email_access/$(email);
      let owner = docVaultOwner();
      let eligible = !owner && isSignedIn() && reqVerified() == true && email != '';
      let grant = eligible && exists(path) ? get(path).data : {};
      return owner || (grant.get('active', false) == true
        && grant.get('permissions', []) is list
        && grant.get('permissions', []).hasAny(['all', 'branches'])
        && grant.get('allowedBranches', []) is list
        && grant.get('allowedBranches', []).hasAny(['All', branch]));
    }
    function docVaultHQAll() {
      let email = isSignedIn() ? request.auth.token.get('email', '') : '';
      let path = /databases/$(database)/documents/hq_email_access/$(email);
      let owner = docVaultOwner();
      let eligible = !owner && isSignedIn() && reqVerified() == true && email != '';
      let grant = eligible && exists(path) ? get(path).data : {};
      return owner || (grant.get('active', false) == true
        && grant.get('permissions', []) is list
        && 'all' in grant.get('permissions', [])
        && grant.get('allowedBranches', []) is list
        && 'All' in grant.get('allowedBranches', []));
    }
    function docVaultOwn(staffId) {
      let uid = isSignedIn() ? reqUid() : '__unauthenticated__';
      let path = /databases/$(database)/documents/staff_document_devices/$(uid);
      let present = docVaultAnonymous() && exists(path);
      let binding = present ? get(path).data : {};
      return present && binding.uid == reqUid()
        && binding.active == true && binding.staffId == staffId;
    }
    function docVaultScope(staffId) {
      let path = /databases/$(database)/documents/staff_private_documents/$(staffId);
      let global = docVaultHQAll();
      let present = !global && exists(path);
      let profile = present ? get(path).data : {};
      return global || (present && profile.staffId == staffId && docVaultHQ(profile.branch));
    }


    function docVaultUpload(staffId, kind, data) {
      return docVaultEnabled() && docVaultOwn(staffId) && docVaultKind(kind)
        && data.keys().hasOnly(['staffId', 'branch', 'group', 'uploadId', 'uploadedByUid',
          'storagePath', 'contentType', 'size', 'sha256', 'clearanceType', 'expiresOn', 'status',
          'reviewNote', 'version', 'uploadedAt', 'updatedAt'])
        && data.staffId == staffId
        && data.branch == readData('staff_document_devices',reqUid()).branch && data.group == kind
        && docVaultId(data.uploadId) && data.uploadedByUid == reqUid()
        && data.storagePath == 'staff_private_documents/' + reqUid() + '/' + staffId + '/' + kind + '/' + data.uploadId + '.jpg'
        && data.contentType == 'image/jpeg' && data.size is int && data.size > 0 && data.size <= 2097152
        && data.sha256 is string && data.sha256.matches('^[a-f0-9]{64}$')
        && data.clearanceType is string
        && ((kind == 'clearance' && data.clearanceType in ['NBI', 'POLICE'])
          || (kind != 'clearance' && data.clearanceType == ''))
        && data.expiresOn is string && (data.expiresOn == '' || data.expiresOn.matches('^\\d{4}-\\d{2}-\\d{2}$'))
        && data.status == 'pending_review' && data.reviewNote == ''
        && data.version is int && data.version > 0
        && data.uploadedAt == reqTime() && data.updatedAt == reqTime();
    }
    function docVaultReview(staffId, kind, before, after) {
      let audit = getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/reviews/$(after.reviewId)).data;
      return docVaultHQ(before.branch) && docVaultKind(kind)
        && before.staffId == staffId && before.group == kind
        && after.diff(before).affectedKeys().hasOnly(['status', 'reviewId', 'reviewNote',
          'reviewedByUid', 'reviewedAt', 'updatedAt', 'version'])
        && after.status in ['approved', 'rejected'] && docVaultId(after.reviewId)
        && after.reviewNote is string && after.reviewNote.size() <= 300
        && (after.status != 'rejected' || after.reviewNote.size() >= 3)
        && after.reviewedByUid == reqUid() && after.reviewedAt == reqTime()
        && after.updatedAt == reqTime() && after.version == before.version + 1
        && audit.staffId == staffId && audit.branch == before.branch && audit.group == kind
        && audit.uploadId == before.uploadId && audit.recordVersion == after.version
        && audit.status == after.status && audit.note == after.reviewNote
        && audit.actorUid == reqUid() && audit.recordedAt == reqTime();
    }
    match /staff_document_config/{id} {
      allow get: if id == 'current';
      allow list, delete: if false;
      function selectorStaffDocumentConfigCreateUpdate(data) {
        return id == 'current' && docVaultOwner()
        && data.keys().hasOnly(['enabled', 'policyVersion', 'brokerEndpoint'])
        && data.enabled is bool && data.policyVersion == 2
        && data.brokerEndpoint == 'https://asia-southeast1-takodeal-pos.cloudfunctions.net/staffDocumentBroker';
      }
      allow create, update: if selectorStaffDocumentConfigCreateUpdate(newData());
    }
    match /staff_document_requests/{uid} {
      function docVaultRequest(uid, data) {
      let path = /databases/$(database)/documents/staff_document_devices/$(uid);
      let eligible = docVaultEnabled() && docVaultAnonymous() && reqUid() == uid
        && data.keys().hasOnly(['uid', 'staffId', 'deviceId', 'deviceName', 'status', 'requestedAt'])
        && data.uid == uid && docVaultId(data.staffId)
        && data.deviceId is string && data.deviceId.size() <= 128
        && data.deviceName is string && data.deviceName.size() > 0 && data.deviceName.size() <= 80
        && data.status == 'pending' && data.requestedAt == reqTime();
      let present = eligible && exists(path);
      let binding = present ? get(path).data : {};
      return eligible && (!present || (binding.staffId == data.staffId && binding.active == false));
    }

      allow read: if (request.method == 'get' && isSignedIn() && request.auth.uid == uid) || docVaultHQAll();

      allow create: if docVaultRequest(uid, newData());
      function selectorStaffDocumentRequestsUpdate(data,before) {
        return (docVaultRequest(uid, data)
          && before.uid == uid && data.staffId == before.staffId)
        || (docVaultHQAll()
          && data.diff(before).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedByUid', 'reviewNote'])
          && data.status in ['approved', 'rejected']
          && data.reviewedAt == reqTime() && data.reviewedByUid == reqUid()
          && data.reviewNote is string && data.reviewNote.size() <= 300
          && (data.status != 'approved'
            || (nextData('staff_document_devices',uid).active == true
              && nextData('staff_document_devices',uid).staffId == before.staffId)));
      }
      allow update: if selectorStaffDocumentRequestsUpdate(newData(),resource == null ? null : oldData());
      allow delete: if false;
    }
    match /staff_document_devices/{uid} {
      function docVaultBinding(uid, data) {
      return docVaultId(uid) && data.keys().hasOnly(['uid', 'staffId', 'branch', 'active',
          'deviceId', 'deviceName', 'approvedAt', 'approvedByUid', 'updatedAt', 'updatedByUid', 'audit'])
        && data.uid == uid && docVaultId(data.staffId)
        && data.branch is string && data.branch.size() > 0 && data.branch.size() <= 128
        && data.active is bool && data.approvedAt is timestamp && data.approvedByUid is string
        && data.updatedAt == reqTime() && data.updatedByUid == reqUid()
        && data.get('deviceId', '') is string && data.get('deviceId', '').size() <= 128
        && data.get('deviceName', '') is string && data.get('deviceName', '').size() <= 80
        && data.audit is map && data.audit.size() > 0 && data.audit.size() <= 100
        && data.audit.values().hasAny([{'active': data.active, 'actorUid': reqUid(), 'recordedAt': reqTime()}]);
    }

      allow read: if (request.method == 'get' && isSignedIn() && request.auth.uid == uid) || docVaultHQAll();

      function docVaultDeviceCreate(data) {
          let requestPath = /databases/$(database)/documents/staff_document_requests/$(uid);
        let eligible = docVaultHQAll() && docVaultBinding(uid, data)
          && data.active == true && data.approvedAt == reqTime()
          && data.audit.size() == 1
          && data.approvedByUid == reqUid();
          let prior = eligible ? get(requestPath).data : {};
          return eligible && prior.status == 'pending'
          && prior.staffId == data.staffId
          && getAfter(requestPath).data.status == 'approved'
          && nextData('staff_private_documents',data.staffId).branch == data.branch;
      }
      allow create: if docVaultDeviceCreate(newData());
      function docVaultDeviceUpdate(data,before) {
        return docVaultHQAll() && docVaultBinding(uid, data)
          && data.diff(before).affectedKeys().hasOnly(['active', 'updatedAt', 'updatedByUid', 'audit'])
          && data.audit.diff(before.audit).changedKeys().size() == 0
          && data.audit.diff(before.audit).removedKeys().size() == 0
          && data.audit.diff(before.audit).addedKeys().size() == 1;
      }
      allow update: if docVaultDeviceUpdate(newData(),resource == null ? null : oldData());
      allow delete: if false;
    }
    match /staff_private_documents/{staffId} {
      allow get: if docVaultOwn(staffId) || docVaultScope(staffId);
      allow list: if docVaultHQAll();
      function docVaultProfileWrite(data,before) {
        return docVaultHQAll()
          && data.keys().hasOnly(['staffId', 'branch', 'version', 'updatedAt', 'updatedByUid'])
          && data.staffId == staffId && docVaultId(staffId)
          && data.branch is string && data.branch.size() > 0 && data.branch.size() <= 128
          && data.version == 1 && data.updatedAt == reqTime()
          && data.updatedByUid == reqUid()
          && (before == null || (data.staffId == before.staffId && data.branch == before.branch));
      }
      allow create, update: if docVaultProfileWrite(newData(),resource == null ? null : oldData());
      allow delete: if false;
      match /files/{kind} {
        allow get, list: if docVaultOwn(staffId) || docVaultScope(staffId);
        function docVaultFileCreate(data) {
          return docVaultUpload(staffId, kind, data)
            && data.version == 1
            && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/versions/$(data.uploadId)).data == data;
        }
        allow create: if docVaultFileCreate(newData());
        function docVaultFileUpdate(data,before) {
          return (docVaultUpload(staffId, kind, data)
              && data.version == before.version + 1 && data.uploadId != before.uploadId
              && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/versions/$(data.uploadId)).data == data)
            || (docVaultReview(staffId, kind, before, data)
              && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/versions/$(before.uploadId)).data == data);
        }
        allow update: if docVaultFileUpdate(newData(),resource == null ? null : oldData());
        allow delete: if false;
      }
      match /versions/{uploadId} {
        allow read: if docVaultOwn(staffId) || ((request.method == 'list' || resource != null) && docVaultHQ(oldData().branch));

        function docVaultVersionCreate(data) {
          return docVaultUpload(staffId, data.group, data)
            && uploadId == data.uploadId
            && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/files/$(data.group)).data == data;
        }
        allow create: if docVaultVersionCreate(newData());
        function docVaultVersionUpdate(data,before) {
          return docVaultReview(staffId, before.group, before, data)
            && uploadId == before.uploadId
            && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/files/$(before.group)).data == data;
        }
        allow update: if docVaultVersionUpdate(newData(),resource == null ? null : oldData());
        allow delete: if false;
      }
      match /reviews/{reviewId} {
        allow read: if docVaultOwn(staffId) || ((request.method == 'list' || resource != null) && docVaultHQ(oldData().branch));

        function docVaultAuditCreate(data) {
          let eligible = docVaultId(reviewId)
            && data.keys().hasOnly(['staffId', 'branch', 'recordVersion', 'group', 'uploadId', 'status', 'note', 'actorUid', 'recordedAt']) && data.size() == 9
            && data.staffId == staffId && docVaultHQ(data.branch)
            && docVaultKind(data.group) && docVaultId(data.uploadId)
            && data.status in ['approved', 'rejected']
            && data.note is string && data.note.size() <= 300
            && data.actorUid == reqUid() && data.recordedAt == reqTime();
          let saved = eligible ? getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/files/$(data.group)).data : {};
          return eligible && saved.reviewId == reviewId
            && saved.version == data.recordVersion
            && saved.branch == data.branch
            && saved.uploadId == data.uploadId;
        }
        allow create: if docVaultAuditCreate(newData());
        allow update, delete: if false;
      }
    }
  }
}
