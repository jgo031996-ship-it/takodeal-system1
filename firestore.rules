rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner() {
      return isSignedIn() && (
        request.auth.token.email == 'jgo031996@gmail.com' ||
        (request.auth.token.email_verified == true && request.auth.token.email == 'jgo031996@gmail.com')
      );
    }
    function isHQUser() { return isSignedIn(); }
    function offlineOwner() {
      return isSignedIn() && request.auth.token.get('email', '') == 'jgo031996@gmail.com'
        && request.auth.token.get('email_verified', false) == true;
    }
    function offlineGate(branch) {
      return branch is string
        && exists(/databases/$(database)/documents/offline_policy/$(branch))
        && get(/databases/$(database)/documents/offline_policy/$(branch)).data.get('requireCashierForCustomerOrders', false) == true;
    }
    function protectedSales(branch) {
      return branch is string
        && exists(/databases/$(database)/documents/offline_policy/$(branch))
        && get(/databases/$(database)/documents/offline_policy/$(branch)).data.get('protectSalesV2', false) == true;
    }
    function verifiedHQ(branch) {
      let email = isSignedIn() ? request.auth.token.get('email', '') : '';
      return offlineOwner() || (isSignedIn()
        && request.auth.token.get('email_verified', false) == true
        && email != ''
        && exists(/databases/$(database)/documents/hq_email_access/$(email))
        && get(/databases/$(database)/documents/hq_email_access/$(email)).data.get('active', false) == true
        && ('All' in get(/databases/$(database)/documents/hq_email_access/$(email)).data.get('allowedBranches', [])
          || branch in get(/databases/$(database)/documents/hq_email_access/$(email)).data.get('allowedBranches', [])));
    }
    function approvedUID(uid, branch) {
      return exists(/databases/$(database)/documents/pos_bindings/$(uid))
        && get(/databases/$(database)/documents/pos_bindings/$(uid)).data.get('status', '') == 'Active'
        && get(/databases/$(database)/documents/pos_bindings/$(uid)).data.get('branch', '') == branch;
    }
    function trustedPOS(branch) {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && approvedUID(request.auth.uid, branch);
    }
    // Retain the staged policy for existing PIN-based Cashier devices. Locked
    // branches still require the same Owner-approved UID; revoked bindings are
    // never admitted through the compatibility route.
    function cancelledFoodWriter(branch) {
      return isSignedIn() && (request.auth.token.firebase.sign_in_provider == 'anonymous'
        ? (exists(/databases/$(database)/documents/pos_bindings/$(request.auth.uid))
          ? approvedUID(request.auth.uid, branch) : !protectedSales(branch) && !offlineGate(branch))
        : verifiedHQ(branch));
    }
    function ownTrustedDevice() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && exists(/databases/$(database)/documents/pos_bindings/$(request.auth.uid))
        && get(/databases/$(database)/documents/pos_bindings/$(request.auth.uid)).data.status == 'Active';
    }
    function freshCashier(branch) {
      let lease = get(/databases/$(database)/documents/cashier_leases/$(branch)).data;
      return lease.get('seenAt', null) is timestamp
        && lease.seenAt <= request.time
        && request.time < lease.seenAt + duration.value(3, 'm')
        && approvedUID(lease.get('uid', ''), branch);
    }
    function admittedCustomer(data) {
      let branch = data.get('branch', '');
      let state = get(/databases/$(database)/documents/settings/$('status_' + branch)).data;
      return isSignedIn() && request.auth.token.get('email_verified', false) == true
        && data.get('customerEmail', '') == request.auth.token.get('email', '')
        && data.get('status', '') == 'mobile_queue'
        && data.get('paymentStatus', 'unpaid') != 'paid'
        && data.get('totalAmount', -1) is number && data.totalAmount >= 0
        && data.get('items', []) is list && data.items.size() > 0
        && state.get('mobileOrdersActive', true) == true && freshCashier(branch);
    }
    function incomingCreate(data) {
      let branch = data.get('branch', '');
      return !offlineGate(branch) || trustedPOS(branch) || verifiedHQ(branch) || admittedCustomer(data);
    }
    function incomingUpdate(before, after) {
      let oldBranch = before.get('branch', '');
      let newBranch = after.get('branch', '');
      return (!offlineGate(oldBranch) && !offlineGate(newBranch))
        || (oldBranch == newBranch && (trustedPOS(oldBranch) || verifiedHQ(oldBranch)
          || !after.diff(before).affectedKeys().hasAny([
            'branch', 'items', 'totalAmount', 'customerEmail', 'customerName',
            'orderCode', 'orderType', 'contactNumber', 'deliveryAddress', 'mapLink',
            'preferredTime', 'paymentMode', 'paymentReference', 'changeFor',
            'deliveryFee', 'timestamp'
          ])));
    }
    // Sale-safety compatibility. Keep the existing staged branch policy.
    function saleWriter(branch) {
      return branch is string && branch.size() > 0
        && (!protectedSales(branch) || verifiedHQ(branch) || trustedPOS(branch));
    }
    function safetySale(data, id) {
      let marker = getAfter(/databases/$(database)/documents/pos_sale_commits/$(id)).data;
      return data.get('saleVersion', 0) == 2 && data.get('saleId', '') == id
        && data.get('inventoryMovements', null) is list
        && data.get('inventoryState', '') in ['applied', 'deferred']
        && marker.saleId == id && marker.branch == data.branch && marker.receiptId == data.receiptId;
    }
    function preparedShift(before, after) {
      let shift = get(/databases/$(database)/documents/shifts/$(before.shiftId)).data;
      let next = getAfter(/databases/$(database)/documents/shifts/$(before.shiftId)).data;
      return shift.branch == before.branch && shift.active == true && shift.get('status', '') != 'Closed'
        && next.active == true && next.get('salesRevision', 0) == shift.get('salesRevision', 0) + 1;
    }
    function preparedCancellation(before, after, id) {
      let detail = after.get('preparedCancellation', {});
      return before.get('saleVersion', 0) == 2 && before.get('saleId', '') == id
        && before.get('paymentMethod', '') is string
        && before.paymentMethod.trim().lower() in ['grab','foodpanda','panda']
        && before.get('status', '') != 'Voided' && before.get('status', '') != 'Parked'
        && before.get('inventoryState', '') in ['applied','deferred']
        && after.get('status', '') == 'Voided' && after.inventoryState == before.inventoryState
        && after.voidTime == request.time && after.voidedBy is string
        && detail.keys().hasOnly(['reason','label','platform','prepared']) && detail.prepared == true
        && detail.reason in ['customer','rider']
        && detail.label == (detail.reason == 'customer' ? 'Prepared but customer cancelled' : 'Prepared but rider cancelled')
        && detail.platform == (before.paymentMethod.trim().lower() == 'grab' ? 'Grab' : 'Foodpanda')
        && after.diff(before).affectedKeys().hasOnly(['status','voidTime','voidedBy','preparedCancellation'])
        && preparedShift(before, after);
    }
    function cancelledDiscount(config) {
      let value = config.get('cancelledFoodDiscountPct', 20);
      return value is number ? value
        : value is string && value.trim().matches('^[+]?([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][+-]?[0-9]+)?$') ? float(value.trim()) : -1;
    }
    function cancelledStaffPin(staff) {
      let value = staff.get('pin', null);
      return value == null || value == '' ? string(staff.get('securityPin', '')) : string(value);
    }
    function cancelledFoodSource(source, id, fingerprint) {
      let marker = get(/databases/$(database)/documents/pos_sale_commits/$(id)).data;
      return source.get('saleVersion', 0) == 2 && source.get('saleId', '') == id
        && source.get('paymentMethod', '') is string
        && source.paymentMethod.trim().lower() in ['grab','foodpanda','panda']
        && source.get('inventoryState', '') in ['applied','deferred']
        && source.get('inventoryMovements', null) is list
        && source.get('cart', null) is list && source.cart.size() > 0
        && marker.saleId == id && marker.branch == source.branch && marker.receiptId == source.receiptId
        && marker.fingerprint == fingerprint;
    }
    function cancelledFoodPurchase(data, id) {
      let prior = get(/databases/$(database)/documents/transactions/$(data.cancelledFoodSourceId)).data;
      let source = getAfter(/databases/$(database)/documents/transactions/$(data.cancelledFoodSourceId)).data;
      let staff = get(/databases/$(database)/documents/cashiers/$(data.cancelledFoodStaffId)).data;
      let config = exists(/databases/$(database)/documents/settings/global_pos_config)
        ? get(/databases/$(database)/documents/settings/global_pos_config).data : {};
      let charge = getAfter(/databases/$(database)/documents/staff_deductions/$(id)).data;
      let base = source.get('subTotalBeforeDiscount', null) == null ? source.netTotal : source.subTotalBeforeDiscount;
      let percent = cancelledDiscount(config);
      let baseCents = math.round(base * 100);
      let discountCents = math.round(baseCents * percent / 100.0);
      let quoted = data.get('cancelledFoodQuote', {});
      return id.matches('cancelled-food-.+') && !exists(/databases/$(database)/documents/transactions/$(id))
        && data.get('saleVersion', 0) == 2 && data.get('saleId', '') == id
        && config.get('cancelledFoodPurchaseEnabled', true) == true
        && cancelledFoodSource(prior, data.cancelledFoodSourceId, quoted.get('fingerprint', ''))
        && prior.status == 'Voided' && prior.get('preparedCancellation', {}).get('prepared', false) == true
        && prior.get('cancelledFoodPurchaseId', '') == ''
        && source.diff(prior).affectedKeys().hasOnly(['cancelledFoodPurchaseId'])
        && source.status == 'Voided' && source.get('preparedCancellation', {}).get('prepared', false) == true
        && source.cancelledFoodPurchaseId == id && data.branch == source.branch && data.shiftId == source.shiftId
        && preparedShift(source, source)
        && data.cart == source.cart && data.inventoryMovements == [] && data.inventoryState == 'applied'
        && data.status == 'Paid' && data.paymentMethod == 'Salary Deduction' && data.paymentVerified == true
        && data.cancelledFoodSourceReceiptId == source.receiptId && data.globalDiscountType == 'cancelled_food' && data.amountReceived == 0
        && data.timestamp == request.time && data.receiptId == 'CF-' + source.receiptId
        && base is number && base >= 0 && percent >= 0 && percent <= 100
        && data.globalDiscountValue == percent
        && data.subTotalBeforeDiscount == baseCents / 100.0
        && data.netTotal == (baseCents - discountCents) / 100.0
        && data.globalDiscountAmount == discountCents / 100.0
        && quoted.keys().hasOnly(['sourceSaleId','branch','shiftId','sourceReceiptId','platform','baseAmount','discountPct','discountAmount','amount','fingerprint'])
        && quoted.sourceSaleId == data.cancelledFoodSourceId && quoted.branch == data.branch && quoted.shiftId == data.shiftId
        && quoted.sourceReceiptId == source.receiptId
        && quoted.platform == (source.paymentMethod.trim().lower() == 'grab' ? 'Grab' : 'Foodpanda')
        && quoted.baseAmount == data.subTotalBeforeDiscount && quoted.discountPct == percent
        && quoted.discountAmount == data.globalDiscountAmount && quoted.amount == data.netTotal
        && quoted.fingerprint is string && quoted.fingerprint.size() > 0
        && cancelledStaffPin(staff).trim().upper() != 'REVOKED'
        && staff.get('active', true) != false && staff.get('archived', false) != true
        && !string(staff.get('status', '')).lower().matches('.*(blocked|inactive|terminated|archived|resigned|deleted).*')
        && staff.get('role', 'Staff') is string
        && staff.get('role', 'Staff').trim().lower() in ['staff','staff crew','crew','cashier','manager']
        && staff.get('cashierName', staff.get('fullName', staff.get('name', ''))) == data.customerName
        && charge.purchaseId == id && charge.staffId == data.cancelledFoodStaffId && charge.staffName == data.customerName
        && charge.branch == data.branch && charge.sourceSaleId == data.cancelledFoodSourceId
        && charge.amount == data.netTotal && charge.type == 'Cancelled Food Purchase'
        && charge.originalAmount == data.subTotalBeforeDiscount && charge.discountPct == percent
        && charge.discountAmount == data.globalDiscountAmount
        && charge.sourceReceiptId == source.receiptId && charge.sourcePlatform == quoted.platform
        && charge.receiptId == data.receiptId
        && charge.category == 'Foods' && charge.status == 'Unpaid' && charge.dateAdded == request.time;
    }
    function preparedPurchaseTransition(before, after, id) {
      let purchaseId = after.get('cancelledFoodPurchaseId', '');
      return before.get('saleVersion', 0) == 2 && before.get('saleId', '') == id
        && before.get('preparedCancellation', {}).get('prepared', false) == true && before.status == 'Voided'
        && before.get('cancelledFoodPurchaseId', '') == '' && purchaseId is string && purchaseId != ''
        && after.diff(before).affectedKeys().hasOnly(['cancelledFoodPurchaseId'])
        // A genuinely new companion receipt must pass its own complete create
        // validator. Do not repeat that validator here (Rules expression cap).
        && !exists(/databases/$(database)/documents/transactions/$(purchaseId))
        && getAfter(/databases/$(database)/documents/transactions/$(purchaseId)).data.cancelledFoodSourceId == id;
    }
    function cancelledFoodChargeLink(data, id) {
      let purchase = getAfter(/databases/$(database)/documents/transactions/$(id)).data;
      // The receipt create rule validates both this charge and its source
      // transition atomically. A prior receipt cannot authorize a new charge.
      return data.purchaseId == id && !exists(/databases/$(database)/documents/transactions/$(id))
        && purchase.get('cancelledFoodSourceId', '') != ''
        && purchase.branch == data.branch && purchase.cancelledFoodStaffId == data.staffId
        && purchase.customerName == data.staffName && purchase.netTotal == data.amount;
    }
    function cancelledPolicyWrite(id, before, after) {
      // Protect only this feature's policy fields. Existing unrelated settings
      // and staged branch policy behavior remain compatible.
      return id != 'global_pos_config'
        || !after.diff(before).affectedKeys().hasAny(['cancelledFoodPurchaseEnabled', 'cancelledFoodDiscountPct'])
        || ((offlineOwner() || verifiedHQ('All'))
          && (!after.keys().hasAny(['cancelledFoodPurchaseEnabled']) || after.cancelledFoodPurchaseEnabled is bool)
          && (!after.keys().hasAny(['cancelledFoodDiscountPct'])
            || (after.cancelledFoodDiscountPct is number && after.cancelledFoodDiscountPct >= 0 && after.cancelledFoodDiscountPct <= 100)));
    }
    function safetyTransition(before, after, id) {
      let changed = after.diff(before).affectedKeys();
      return before.get('saleVersion', 0) == 2 && before.get('saleId', '') == id
        && (
          (before.get('inventoryState', '') == 'deferred' && after.get('inventoryState', '') == 'applied'
            && after.inventoryAppliedAt == request.time && changed.hasOnly(['inventoryState', 'inventoryAppliedAt']))
          || (before.get('status', '') == 'Voided' && before.get('preparedCancellation', {}).get('prepared', false) != true && before.get('inventoryState', '') == 'deferred'
            && after.get('inventoryState', '') == 'cancelled' && changed.hasOnly(['inventoryState']))
          || (before.get('status', '') != 'Voided' && before.get('cancelledFoodSourceId', '') == '' && before.get('inventoryState', '') in ['applied', 'deferred']
            && after.get('status', '') == 'Voided' && after.get('voidedBy', null) is string
            && after.voidTime == request.time
            && after.get('inventoryState', '') == (before.inventoryState == 'applied' ? 'reversed' : 'cancelled')
            && changed.hasOnly(['status', 'voidedBy', 'voidTime', 'inventoryState']))
          || preparedCancellation(before, after, id) || preparedPurchaseTransition(before, after, id)
        );
    }
    function parkedAccountability(data, id) {
      let parkedId = data.get('parkedOrderId', '');
      return parkedId is string && parkedId.size() > 0 && id == 'parked-delete-' + parkedId
        && data.get('status', '') == 'Voided' && data.get('inventoryState', '') == 'none'
        && data.get('inventoryMovements', null) == []
        && exists(/databases/$(database)/documents/parked_orders/$(parkedId))
        && get(/databases/$(database)/documents/parked_orders/$(parkedId)).data.branch == data.branch
        && !existsAfter(/databases/$(database)/documents/parked_orders/$(parkedId));
    }
    function saleCounterWrite() {
      let after = request.resource.data;
      let id = after.get('lastSaleId', '');
      let branch = after.get('lastSaleBranch', '');
      let direction = after.get('lastSaleDirection', 0);
      let sale = getAfter(/databases/$(database)/documents/transactions/$(id)).data;
      let marker = getAfter(/databases/$(database)/documents/pos_sale_commits/$(id)).data;
      let prior = exists(/databases/$(database)/documents/settings/global_stats) ? resource.data : {};
      let beforeSale = exists(/databases/$(database)/documents/transactions/$(id))
        ? get(/databases/$(database)/documents/transactions/$(id)).data : {};
      return saleWriter(branch) && id is string && id.size() > 0 && direction in [1, -1]
        && sale.get('saleVersion', 0) == 2 && sale.saleId == id && sale.branch == branch
        && marker.saleId == id && marker.branch == branch && marker.receiptId == sale.receiptId
        && sale.ballsCounted is number && sale.ballsCounted > 0
        && after.diff(prior).affectedKeys().hasOnly([
          'totalTakoyakiBalls', 'balls_' + branch, 'lastSaleId', 'lastSaleBranch', 'lastSaleDirection'])
        && after.totalTakoyakiBalls == prior.get('totalTakoyakiBalls', 0) + direction * sale.ballsCounted
        && after.get('balls_' + branch, 0) == prior.get('balls_' + branch, 0) + direction * sale.ballsCounted
        && ((direction == 1 && !exists(/databases/$(database)/documents/transactions/$(id))
              && sale.get('status', '') != 'Voided')
          || (direction == -1 && beforeSale.get('saleVersion', 0) == 2
              && beforeSale.get('saleId', '') == id && beforeSale.get('branch', '') == branch
              && beforeSale.get('ballsCounted', 0) == sale.ballsCounted
              && beforeSale.get('status', '') != 'Voided' && sale.get('status', '') == 'Voided'));
    }
    function saleAuditWrite(id) {
      let data = request.resource.data;
      let branch = data.get('branch', '');
      // The present branch names use ASCII letters, spaces, dots and hyphens.
      // Other names keep the existing signed-in settings path.
      return branch is string && branch.matches('[A-Za-z0-9 _.-]+')
        && id == 'audit_' + branch.replace(' ', '%20').replace('[.]', '%2E')
        && saleWriter(branch) && data.keys().hasOnly(['active', 'branch', 'updatedBy', 'updatedAt'])
        && data.active is bool && data.updatedBy is string && data.updatedAt == request.time;
    }
    match /pos_sale_commits/{id} {
      // Missing markers must be readable before the first atomic sale commit.
      // Existing legacy-branch receipts already have public reads in this policy.
      allow get: if resource == null
        || !protectedSales(resource.data.branch) || verifiedHQ(resource.data.branch) || trustedPOS(resource.data.branch);
      allow list: if offlineOwner() || verifiedHQ(resource.data.branch) || trustedPOS(resource.data.branch);
      allow create: if saleWriter(request.resource.data.get('branch', ''))
        && request.resource.data.keys().hasOnly(['saleId', 'branch', 'receiptId', 'fingerprint', 'committedAt'])
        && request.resource.data.saleId == id && request.resource.data.receiptId is string
        && request.resource.data.fingerprint is string && request.resource.data.committedAt == request.time
        && !exists(/databases/$(database)/documents/transactions/$(id))
        && safetySale(getAfter(/databases/$(database)/documents/transactions/$(id)).data, id);
      allow update, delete: if false;
    }
    match /offline_policy/{branch} { allow read: if true; allow write: if offlineOwner(); }
    match /hq_email_access/{email} {
      allow read: if offlineOwner() || (isSignedIn() && request.auth.token.get('email', '') == email);
      allow write: if offlineOwner();
    }
    match /pos_bindings/{uid} {
      allow read: if offlineOwner() || (isSignedIn() && request.auth.uid == uid);
      allow create: if offlineOwner() || (isSignedIn()
        && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().hasOnly(['uid', 'deviceId', 'deviceName', 'branch', 'legacyDeviceDocId', 'status', 'requestedAt'])
        && request.resource.data.uid == uid && request.resource.data.status == 'Pending'
        && request.resource.data.branch is string && request.resource.data.branch.size() > 0
        && request.resource.data.deviceId is string && request.resource.data.legacyDeviceDocId is string
        && request.resource.data.deviceName is string && request.resource.data.requestedAt == request.time);
      allow update, delete: if offlineOwner();
    }
    match /cashier_presence/{uid} {
      allow read: if offlineOwner() || (isSignedIn() && request.auth.uid == uid) || verifiedHQ(resource.data.branch);
      allow create, update: if trustedPOS(request.resource.data.branch) && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'branch', 'deviceId', 'deviceName', 'cashier', 'shiftId', 'seenAt', 'accepting', 'pendingSales', 'pendingOperations', 'ownerReviews', 'lastReceipt', 'setupProblem'])
        && request.resource.data.uid == uid && request.resource.data.seenAt == request.time
        && request.resource.data.accepting is bool && request.resource.data.pendingSales is int
        && request.resource.data.pendingSales >= 0
        && request.resource.data.deviceId == get(/databases/$(database)/documents/pos_bindings/$(uid)).data.deviceId;
      allow delete: if offlineOwner();
    }
    match /cashier_leases/{branch} {
      allow read: if true;
      allow create, update: if trustedPOS(branch)
        && request.resource.data.keys().hasOnly(['branch', 'uid', 'seenAt'])
        && request.resource.data.branch == branch && request.resource.data.uid == request.auth.uid
        && request.resource.data.seenAt == request.time
        && getAfter(/databases/$(database)/documents/cashier_presence/$(request.auth.uid)).data.accepting == true
        && getAfter(/databases/$(database)/documents/cashier_presence/$(request.auth.uid)).data.seenAt == request.time;
      allow delete: if offlineOwner();
    }
    match /pos_operation_commits/{id} {
      allow get: if offlineOwner()
        || (!exists(/databases/$(database)/documents/pos_operation_commits/$(id)) && ownTrustedDevice())
        || verifiedHQ(resource.data.branch) || trustedPOS(resource.data.branch);
      allow list: if offlineOwner() || verifiedHQ(resource.data.branch) || trustedPOS(resource.data.branch);
      allow create: if offlineOwner() || (trustedPOS(request.resource.data.branch)
        && request.resource.data.state in ['synced', 'owner_review']);
      allow update: if offlineOwner();
      allow delete: if false;
    }
    match /pos_operation_reviews/{id} {
      allow get: if offlineOwner()
        || (!exists(/databases/$(database)/documents/pos_operation_reviews/$(id)) && ownTrustedDevice())
        || verifiedHQ(resource.data.branch) || trustedPOS(resource.data.branch);
      allow list: if offlineOwner() || verifiedHQ(resource.data.branch) || trustedPOS(resource.data.branch);
      allow create: if offlineOwner() || (trustedPOS(request.resource.data.branch)
        && request.resource.data.status == 'Pending' && request.resource.data.id == id
        && request.resource.data.deviceId == get(/databases/$(database)/documents/pos_bindings/$(request.auth.uid)).data.deviceId);
      allow update: if offlineOwner();
      allow delete: if false;
    }
    match /pos_branch_shifts/{branch} {
      allow read: if offlineOwner() || verifiedHQ(branch) || trustedPOS(branch);
      allow create, update: if offlineOwner() || (trustedPOS(branch) && request.resource.data.branch == branch);
      allow delete: if false;
    }
    match /pos_attendance_heads/{staff} {
      allow read: if isSignedIn();
      allow create, update: if offlineOwner() || trustedPOS(request.resource.data.branch);
      allow delete: if false;
    }
    match /pos_staff_meal_claims/{id} {
      allow get: if offlineOwner() || ownTrustedDevice();
      allow list: if offlineOwner();
      allow create: if offlineOwner() || (
        trustedPOS(request.resource.data.branch)
        && request.resource.data.deviceId == get(/databases/$(database)/documents/pos_bindings/$(request.auth.uid)).data.deviceId
        && request.resource.data.staffId is string && request.resource.data.day is string
        && id == request.resource.data.staffId + '__' + request.resource.data.day
        && exists(/databases/$(database)/documents/cashiers/$(request.resource.data.staffId))
        && get(/databases/$(database)/documents/cashiers/$(request.resource.data.staffId)).data.cashierName == request.resource.data.staffName
        && (
          (request.resource.data.get('saleId', '') != ''
            && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.saleId)).data.get('staffMealClaimId', '') == id
            && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.saleId)).data.branch == request.resource.data.branch
            && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.saleId)).data.globalDiscountType == 'staff_meal')
          || (request.resource.data.get('requestId', '') != ''
            && getAfter(/databases/$(database)/documents/staff_requests/$(request.resource.data.requestId)).data.get('staffId', '') == request.resource.data.staffId
            && getAfter(/databases/$(database)/documents/staff_requests/$(request.resource.data.requestId)).data.branch == request.resource.data.branch
            && getAfter(/databases/$(database)/documents/staff_requests/$(request.resource.data.requestId)).data.type == 'Staff Meal')
        )
      );
      allow update: if offlineOwner();
      allow delete: if false;
    }
    match /pos_staff_meal_exceptions/{id} { allow read, create: if offlineOwner(); allow update, delete: if false; }
    match /shift_metric_commits/{id} { allow read: if offlineOwner(); allow write: if false; }

    match /hq_managers/{managerId} { allow read: if isSignedIn(); allow write: if isOwner(); }
    match /settings/{docId} {
      allow read: if true;
      allow create: if (isHQUser() || docId.matches("status_.*"))
        && cancelledPolicyWrite(docId, {}, request.resource.data);
      allow update: if (isHQUser() || docId.matches("status_.*"))
        && cancelledPolicyWrite(docId, resource.data, request.resource.data);
      allow delete: if (isHQUser() || docId.matches("status_.*"))
        && cancelledPolicyWrite(docId, resource.data, {});
      // PIN-only legacy Cashiers can update counters only with their atomic sale
      // or first void, with exact deltas. No general settings write is opened.
      allow create, update: if docId == 'global_stats' && saleCounterWrite();
      allow create, update: if docId.matches('audit_.*') && saleAuditWrite(docId);
    }
    match /global_addons/{addonId} { allow read: if true; allow write: if isOwner(); }
    match /bom/{bomId} { allow read: if true; allow write: if isOwner(); }
    match /branches/{branchId} { allow read, write: if true; }
    match /menu/{menuId} { allow read, update: if true; allow create, delete: if isOwner(); }
    match /announcements/{document=**} { allow read, write: if true; }
    match /acknowledgments/{document=**} { allow read, write: if true; }
    match /reviews/{document=**} { allow read, create: if true; allow update, delete: if isHQUser(); }
    match /customer_feedback/{document=**} { allow create: if true; allow read, update, delete: if isHQUser(); }
    match /franchise_leads/{document=**} { allow create: if true; allow read, update, delete: if isHQUser(); }
    match /customer_app_categories/{document=**} { allow read, write: if isHQUser(); }

    match /transactions/{txId} {
      allow read: if true;
      allow create: if request.resource.data.get('cancelledFoodSourceId', '') != ''
        ? (cancelledFoodWriter(request.resource.data.branch)
          && cancelledFoodPurchase(request.resource.data, txId) && safetySale(request.resource.data, txId))
        : (!protectedSales(request.resource.data.get('branch', ''))
        || verifiedHQ(request.resource.data.get('branch', ''))
        || (trustedPOS(request.resource.data.get('branch', ''))
          && ((request.resource.data.get('localSaleId', '') == txId && request.resource.data.get('syncVersion', 0) == 2)
            || safetySale(request.resource.data, txId) || parkedAccountability(request.resource.data, txId))));
      allow update: if (!protectedSales(resource.data.get('branch', '')) && !protectedSales(request.resource.data.get('branch', '')))
        || (resource.data.get('branch', '') == request.resource.data.get('branch', '')
          && (verifiedHQ(resource.data.get('branch', ''))
            || (trustedPOS(resource.data.get('branch', ''))
              && ((resource.data.get('inventoryState', '') == 'audit_pending'
                && request.resource.data.get('inventoryState', '') == 'applied'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inventoryState']))
                || safetyTransition(resource.data, request.resource.data, txId)))));
      allow delete: if (!protectedSales(resource.data.get('branch', '')) && isHQUser()) || isOwner();
    }
    match /stock_logs/{logId} { allow read, create, update: if true; allow delete: if isOwner(); }
    match /attendance_logs/{logId} { allow read, create, update: if true; allow delete: if isHQUser(); }
    match /manager_alerts/{alertId} { allow read, create, update: if true; allow delete: if isHQUser(); }
    match /sop_logs/{sopId} { allow read, create, update: if true; allow delete: if isHQUser(); }
    match /shift_swaps/{swapId} { allow read, create, update: if true; allow delete: if isHQUser(); }
    match /shifts/{shiftId} { allow read, create, update: if true; allow delete: if isOwner(); }
    match /expenses/{expenseId} { allow read, create, update: if true; allow delete: if isHQUser(); }
    match /remittances/{remitId} { allow read, create, update: if true; allow delete: if isOwner(); }
    match /store_use_logs/{document=**} { allow read, create, update: if true; allow delete: if isHQUser(); }
    match /account_logs/{logId} { allow read, create, update: if true; allow delete: if isHQUser(); }
    match /cash_accounts/{accountId} { allow read, create, update: if true; allow delete: if isHQUser(); }
    match /inventory/{itemId} { allow read, create, update: if true; allow delete: if isOwner(); }
    match /stock_counts/{countId} { allow read, create, update: if true; allow delete: if isOwner(); }
    match /inventory_logs/{document=**} { allow read, create, update: if true; allow delete: if isHQUser(); }
    match /purchase_orders/{poId} { allow read, create, update: if true; allow delete: if isHQUser(); }
    match /dispatch_logs/{dispatchId} { allow read, create, update: if true; allow delete: if isHQUser(); }
    match /incoming_orders/{orderId} {
      allow read: if true;
      allow create: if incomingCreate(request.resource.data);
      allow update: if incomingUpdate(resource.data, request.resource.data);
      allow delete: if (!offlineGate(resource.data.get('branch', '')) && isHQUser()) || verifiedHQ(resource.data.get('branch', ''));
    }
    match /parked_orders/{orderId} { allow read, write: if true; }
    match /pos_devices/{deviceId} { allow read, create, update: if true; allow delete: if isHQUser(); }
    // Daily-rate audit is private and immutable. Public legacy profile fields
    // remain compatible, but cannot issue or replace an audited raise marker.
    function staffRateHQAny() {
      let email = isSignedIn() ? request.auth.token.get('email', '') : '';
      let path = /databases/$(database)/documents/hq_email_access/$(email);
      return offlineOwner() || (isSignedIn()
        && request.auth.token.get('email_verified', false) == true && email != ''
        && exists(path) && get(path).data.get('active', false) == true
        && get(path).data.get('permissions', []) is list
        && get(path).data.get('permissions', []).hasAny(['all', 'payroll', 'feed'])
        && get(path).data.get('allowedBranches', []) is list
        && get(path).data.allowedBranches.size() > 0);
    }
    function staffRateHQ(branch) {
      let email = isSignedIn() ? request.auth.token.get('email', '') : '';
      let path = /databases/$(database)/documents/hq_email_access/$(email);
      return offlineOwner() || (branch is string && staffRateHQAny()
        && get(path).data.allowedBranches.hasAny(['All', branch]));
    }
    function staffRateValue(profile) {
      let value = profile.get('hourlyRate', null) != null ? profile.hourlyRate : profile.get('dailyRate', null);
      return value == null || (value is string && value.trim() == '') ? null
        : value is number ? value
        : value is string && value.trim().matches('^[+]?([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][+-]?[0-9]+)?$') ? float(value.trim()) : -1;
    }
    function staffRateValid(value) {
      return value == null || (value is number && value >= 0 && value - value == 0);
    }
    function staffRateEvent(before, after) {
      return before == null || before == 0 ? 'baseline'
        : after > before ? 'increase' : after < before ? 'decrease' : 'unchanged';
    }
    function staffRateMarker(before, event, id) {
      return event == 'increase' ? {'eventId': id, 'version': 1}
        : event == 'unchanged' ? before.get('latestRateRaise', null) : null;
    }
    function staffRateAuditCreate(data, id) {
      let profile = /databases/$(database)/documents/cashiers/$(data.staffId);
      let before = exists(profile) ? get(profile).data : {};
      let after = getAfter(profile).data;
      let oldRate = staffRateValue(before);
      let newRate = staffRateValue(after);
      return data.keys().hasOnly(['version', 'staffId', 'staffName', 'branch', 'previousBranch', 'eventType',
          'fromDailyRate', 'toDailyRate', 'inputHash', 'actorUid', 'actorEmail', 'actorName', 'recordedAt'])
        && data.keys().hasAll(['version', 'staffId', 'staffName', 'branch', 'previousBranch', 'eventType',
          'fromDailyRate', 'toDailyRate', 'inputHash', 'actorUid', 'actorEmail', 'actorName', 'recordedAt'])
        && id.matches('^[A-Za-z0-9_-]{1,128}$') && data.version == 1
        && data.staffId is string && data.staffId.matches('^[A-Za-z0-9_-]{1,128}$')
        && staffRateHQ(data.branch) && (!exists(profile) || staffRateHQ(before.get('branch', '')))
        && data.staffName == after.cashierName && data.branch == after.branch
        && data.previousBranch == before.get('branch', '')
        && staffRateValid(oldRate) && staffRateValid(newRate) && newRate != null
        && data.fromDailyRate == oldRate && data.toDailyRate == newRate
        && data.eventType == staffRateEvent(oldRate, newRate)
        && after.get('staffRateAuditId', '') == id
        && after.get('latestRateRaise', null) == staffRateMarker(before, data.eventType, id)
        && data.actorUid == request.auth.uid
        && data.actorEmail == request.auth.token.get('email', '').lower()
        && data.actorName is string && data.actorName.size() > 0 && data.actorName.size() <= 256
        && data.inputHash is string && data.inputHash.matches('^[a-f0-9]{64}$')
        && data.recordedAt == request.time;
    }
    function staffRateProfileLink(id, before, after) {
      let auditId = after.get('staffRateAuditId', '');
      let path = /databases/$(database)/documents/staff_rate_changes/$(auditId);
      let audit = getAfter(path).data;
      return auditId is string && auditId.matches('^[A-Za-z0-9_-]{1,128}$')
        && !exists(path) && staffRateHQ(after.get('branch', ''))
        && (!before.keys().hasAny(['branch']) || staffRateHQ(before.branch))
        && audit.staffId == id && audit.branch == after.branch
        && audit.actorUid == request.auth.uid && audit.recordedAt == request.time
        && after.get('latestRateRaise', null) == staffRateMarker(before, audit.eventType, auditId);
    }
    match /staff_rate_changes/{auditId} {
      allow get: if (resource == null && staffRateHQAny()) || (resource != null && staffRateHQ(resource.data.branch));
      allow list: if staffRateHQ(resource.data.branch);
      allow create: if staffRateAuditCreate(request.resource.data, auditId);
      allow update, delete: if false;
    }
    match /cashiers/{cashierId} {
      allow read: if true;
      allow create: if isHQUser() && !request.resource.data.keys().hasAny(['rateHistory'])
        && (!request.resource.data.keys().hasAny(['latestRateRaise', 'staffRateAuditId'])
          || staffRateProfileLink(cashierId, {}, request.resource.data));
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rateHistory'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['latestRateRaise', 'staffRateAuditId'])
          || staffRateProfileLink(cashierId, resource.data, request.resource.data));
      allow delete: if isHQUser();
    }
    match /staff_requests/{reqId} { allow read, create, update: if true; allow delete: if isHQUser(); }
    match /hr_sanctions/{sanctionId} { allow read, create, update: if true; allow delete: if isHQUser(); }
    match /acknowledgments/{ackId} { allow read, create, update: if true; allow delete: if isHQUser(); }
    match /payroll_records/{recordId} { allow read, update: if true; allow create, delete: if isHQUser(); }
    match /staff_ledger/{ledgerId} { allow read: if true; allow write: if isHQUser(); }
    function onlineIncidentCreate(data, id) {
      let sale = get(/databases/$(database)/documents/transactions/$(data.sourceSaleId)).data;
      let staff = get(/databases/$(database)/documents/cashiers/$(data.staffId)).data;
      let charge = getAfter(/databases/$(database)/documents/staff_deductions/$(id)).data;
      return offlineOwner() && data.version == 1 && data.id == id
        && id == 'online-refund-' + data.sourceSaleId
        && data.sourceReceiptId == sale.receiptId && data.branch == sale.branch
        && sale.paymentMethod.lower() in ['grab','foodpanda','panda']
        && sale.get('cancelledFoodSourceId', '') == '' && !sale.keys().hasAny(['preparedCancellation'])
        && !(sale.get('status', '') in ['Voided','Parked','mobile_queue'])
        && data.staffName == staff.get('cashierName', staff.get('fullName', staff.get('name', '')))
        && staff.get('active', true) == true && staff.get('archived', false) == false
        && data.type == 'Online Order Refund' && data.category == 'Online Order Refunds'
        && data.status == 'Pending Review' && data.amount == 0 && data.reviewRevision == 0
        && data.refundAmount is number && data.refundAmount >= 0 && data.refundAmount <= sale.netTotal
        && data.orderAmount == sale.netTotal && data.refundConfirmed is bool
        && (data.refundConfirmed || data.refundAmount == 0)
        && data.createdBy == request.auth.token.email && data.createdAt == request.time
        && data.evidence is string && data.evidence.size() > 0 && data.evidence.size() <= 1000
        && data.details is string && data.details.size() > 0 && data.details.size() <= 1500
        && data.reason in ['wrong_food','wrong_instructions','missing_item','other']
        && charge.incidentId == id && charge.sourceSaleId == data.sourceSaleId
        && charge.staffId == data.staffId && charge.staffName == data.staffName
        && charge.proposedAmount == data.refundAmount && charge.status == data.status && charge.amount == 0;
    }
    function onlineIncidentReview(before, after, id) {
      let charge = getAfter(/databases/$(database)/documents/staff_deductions/$(id)).data;
      return offlineOwner() && before.status == 'Pending Review' && before.amount == 0
        && after.diff(before).affectedKeys().hasOnly(['status','staffResponse','reviewNote','reviewedAt','reviewedBy','reviewRevision'])
        && after.status in ['Pending Review','Dismissed'] && after.reviewRevision == before.reviewRevision + 1
        && after.staffResponse is string && after.staffResponse.size() > 0 && after.staffResponse.size() <= 1500
        && after.reviewNote is string && after.reviewNote.size() > 0 && after.reviewNote.size() <= 1500
        && after.reviewedAt == request.time && after.reviewedBy == request.auth.token.email
        && charge.status == after.status && charge.amount == 0
        && charge.responseRecorded == true && charge.reviewedAt == request.time;
    }
    function onlineIncidentCharge(data, id) {
      let row = getAfter(/databases/$(database)/documents/online_order_incidents/$(id)).data;
      return offlineOwner() && data.type == 'Online Order Refund' && data.amount == 0
        && data.category == 'Online Order Refunds' && data.status == 'Pending Review'
        && data.incidentId == id && row.id == id && row.status == data.status
        && data.staffId == row.staffId && data.staffName == row.staffName
        && data.sourceSaleId == row.sourceSaleId && data.sourceReceiptId == row.sourceReceiptId
        && data.sourcePlatform == row.sourcePlatform && data.proposedAmount == row.refundAmount
        && data.dateAdded == request.time && data.loggedBy == request.auth.token.email;
    }
    match /online_order_incidents/{id} {
      allow get, list: if offlineOwner();
      allow create: if onlineIncidentCreate(request.resource.data, id);
      allow update: if onlineIncidentReview(resource.data, request.resource.data, id);
      allow delete: if false;
    }
    match /staff_deductions/{deductId} {
      allow read: if true;
      allow create: if request.resource.data.get('type', '') == 'Online Order Refund' || deductId.matches('online-refund-.*')
        ? onlineIncidentCharge(request.resource.data, deductId)
        : request.resource.data.get('type', '') == 'Cancelled Food Purchase'
        ? (cancelledFoodWriter(request.resource.data.branch)
          && cancelledFoodChargeLink(request.resource.data, deductId))
        : isHQUser();
      allow update: if resource.data.get('type', '') == 'Online Order Refund' || request.resource.data.get('type', '') == 'Online Order Refund' || deductId.matches('online-refund-.*')
        ? (offlineOwner() && resource.data.type == 'Online Order Refund' && request.resource.data.amount == 0
          && resource.data.status == 'Pending Review'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','responseRecorded','reviewedAt','reviewedBy'])
          && request.resource.data.responseRecorded == true
          && request.resource.data.status in ['Pending Review','Dismissed']
          && request.resource.data.status == getAfter(/databases/$(database)/documents/online_order_incidents/$(deductId)).data.status
          && request.resource.data.reviewedAt == request.time && request.resource.data.reviewedBy == request.auth.token.email)
        : resource.data.get('type', '') == 'Cancelled Food Purchase'
        ? verifiedHQ(resource.data.branch) : isHQUser();
      allow delete: if resource.data.get('type', '') != 'Online Order Refund'
        && (resource.data.get('type', '') == 'Cancelled Food Purchase' ? verifiedHQ(resource.data.branch) : isHQUser());
    }
    match /staff_bonuses/{bonusId} { allow read: if true; allow write: if isHQUser(); }
    match /budgets/{budgetId} { allow read, write: if isHQUser(); }
    match /equipment_assets/{assetId} { allow read, write: if isHQUser(); }
    match /yield_logs/{yieldId} { allow read, write: if isHQUser(); }
    match /grab_payouts/{payoutId} { allow read, create: if true; allow update, delete: if isHQUser(); }
    match /foodpanda_payouts/{payoutId} { allow read, create: if true; allow update, delete: if isHQUser(); }
    match /payables/{payableId} { allow read, write: if isHQUser(); }
    match /hq_restocks/{restockId} { allow read, write: if isHQUser(); }
    match /suppliers/{document=**} { allow read, write: if isHQUser(); }
    match /daily_metrics/{document=**} { allow read, write: if isHQUser(); }
    match /archived_months/{document=**} { allow read, write: if isHQUser(); }
    match /franchise_ledger/{ledgerId} { allow read, create, update: if true; allow delete: if isHQUser(); }
    match /franchise_comms/{commId} { allow read, create, update: if true; allow delete: if isHQUser(); }
    match /franchise_accounts/{document=**} { allow read, write: if isHQUser(); }
    match /franchise_budgets/{document=**} { allow read, write: if isHQUser(); }
    match /riders/{riderId} { allow read, write: if isHQUser(); }
    match /rider_topups/{topupId} { allow read, write: if isHQUser(); }

    // Private Staff document vault. These new collections never use the legacy
    // isHQUser() helper or public cashiers/branches/settings as authority.
    function docVaultOwner() { return offlineOwner(); }
    function docVaultAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function docVaultId(value) {
      return value is string && value.matches('^[A-Za-z0-9_-]{1,128}$');
    }
    function docVaultKind(value) { return value in ['valid_id', 'health_card', 'clearance']; }
    function docVaultEnabled() {
      return exists(/databases/$(database)/documents/staff_document_config/current)
        && get(/databases/$(database)/documents/staff_document_config/current).data.enabled == true
        && get(/databases/$(database)/documents/staff_document_config/current).data.policyVersion == 2
        && get(/databases/$(database)/documents/staff_document_config/current).data.brokerEndpoint == 'https://asia-southeast1-takodeal-pos.cloudfunctions.net/staffDocumentBroker';
    }
    function docVaultHQ(branch) {
      let email = isSignedIn() ? request.auth.token.get('email', '') : '';
      let path = /databases/$(database)/documents/hq_email_access/$(email);
      return docVaultOwner() || (isSignedIn()
        && request.auth.token.get('email_verified', false) == true && email != ''
        && exists(path) && get(path).data.get('active', false) == true
        && get(path).data.get('permissions', []) is list
        && get(path).data.get('permissions', []).hasAny(['all', 'branches'])
        && get(path).data.get('allowedBranches', []) is list
        && get(path).data.get('allowedBranches', []).hasAny(['All', branch]));
    }
    function docVaultHQAll() {
      let email = isSignedIn() ? request.auth.token.get('email', '') : '';
      let path = /databases/$(database)/documents/hq_email_access/$(email);
      return docVaultOwner() || (isSignedIn()
        && request.auth.token.get('email_verified', false) == true && email != ''
        && exists(path) && get(path).data.get('active', false) == true
        && get(path).data.get('permissions', []) is list
        && 'all' in get(path).data.get('permissions', [])
        && get(path).data.get('allowedBranches', []) is list
        && 'All' in get(path).data.get('allowedBranches', []));
    }
    function docVaultOwn(staffId) {
      let uid = isSignedIn() ? request.auth.uid : '__unauthenticated__';
      let path = /databases/$(database)/documents/staff_document_devices/$(uid);
      return docVaultAnonymous() && exists(path)
        && get(path).data.uid == request.auth.uid
        && get(path).data.active == true && get(path).data.staffId == staffId;
    }
    function docVaultScope(staffId) {
      let path = /databases/$(database)/documents/staff_private_documents/$(staffId);
      return docVaultHQAll() || (exists(path) && get(path).data.staffId == staffId
        && docVaultHQ(get(path).data.branch));
    }
    function docVaultRequest(uid, data) {
      let path = /databases/$(database)/documents/staff_document_devices/$(uid);
      return docVaultEnabled() && docVaultAnonymous() && request.auth.uid == uid
        && data.keys().hasOnly(['uid', 'staffId', 'deviceId', 'deviceName', 'status', 'requestedAt'])
        && data.keys().hasAll(['uid', 'staffId', 'deviceId', 'deviceName', 'status', 'requestedAt'])
        && data.uid == uid && docVaultId(data.staffId)
        && data.deviceId is string && data.deviceId.size() <= 128
        && data.deviceName is string && data.deviceName.size() > 0 && data.deviceName.size() <= 80
        && data.status == 'pending' && data.requestedAt == request.time
        && (!exists(path) || (get(path).data.staffId == data.staffId && get(path).data.active == false));
    }
    function docVaultBinding(uid, data) {
      return docVaultId(uid) && data.keys().hasOnly(['uid', 'staffId', 'branch', 'active',
          'deviceId', 'deviceName', 'approvedAt', 'approvedByUid', 'updatedAt', 'updatedByUid', 'audit'])
        && data.keys().hasAll(['uid', 'staffId', 'branch', 'active', 'approvedAt',
          'approvedByUid', 'updatedAt', 'updatedByUid', 'audit'])
        && data.uid == uid && docVaultId(data.staffId)
        && data.branch is string && data.branch.size() > 0 && data.branch.size() <= 128
        && data.active is bool && data.approvedAt is timestamp && data.approvedByUid is string
        && data.updatedAt == request.time && data.updatedByUid == request.auth.uid
        && data.get('deviceId', '') is string && data.get('deviceId', '').size() <= 128
        && data.get('deviceName', '') is string && data.get('deviceName', '').size() <= 80
        && data.audit is map && data.audit.size() > 0 && data.audit.size() <= 100
        && data.audit.values().hasAny([{'active': data.active, 'actorUid': request.auth.uid, 'recordedAt': request.time}]);
    }
    function docVaultUpload(staffId, kind, data) {
      return docVaultEnabled() && docVaultOwn(staffId) && docVaultKind(kind)
        && data.keys().hasOnly(['staffId', 'branch', 'group', 'uploadId', 'uploadedByUid',
          'storagePath', 'contentType', 'size', 'sha256', 'clearanceType', 'expiresOn', 'status',
          'reviewNote', 'version', 'uploadedAt', 'updatedAt'])
        && data.keys().hasAll(['staffId', 'branch', 'group', 'uploadId', 'uploadedByUid',
          'storagePath', 'contentType', 'size', 'sha256', 'clearanceType', 'expiresOn', 'status',
          'reviewNote', 'version', 'uploadedAt', 'updatedAt'])
        && data.staffId == staffId
        && data.branch == get(/databases/$(database)/documents/staff_document_devices/$(request.auth.uid)).data.branch && data.group == kind
        && docVaultId(data.uploadId) && data.uploadedByUid == request.auth.uid
        && data.storagePath == 'staff_private_documents/' + request.auth.uid + '/' + staffId + '/' + kind + '/' + data.uploadId + '.jpg'
        && data.contentType == 'image/jpeg' && data.size is int && data.size > 0 && data.size <= 2097152
        && data.sha256 is string && data.sha256.matches('^[a-f0-9]{64}$')
        && data.clearanceType is string
        && ((kind == 'clearance' && data.clearanceType in ['NBI', 'POLICE'])
          || (kind != 'clearance' && data.clearanceType == ''))
        && data.expiresOn is string && (data.expiresOn == '' || data.expiresOn.matches('^\\d{4}-\\d{2}-\\d{2}$'))
        && data.status == 'pending_review' && data.reviewNote == ''
        && data.version is int && data.version > 0
        && data.uploadedAt == request.time && data.updatedAt == request.time;
    }
    function docVaultReview(staffId, kind, before, after) {
      let audit = getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/reviews/$(after.reviewId)).data;
      return docVaultHQ(before.branch) && docVaultKind(kind)
        && before.staffId == staffId && before.group == kind
        && after.diff(before).affectedKeys().hasOnly(['status', 'reviewId', 'reviewNote',
          'reviewedByUid', 'reviewedAt', 'updatedAt', 'version'])
        && after.status in ['approved', 'rejected'] && docVaultId(after.reviewId)
        && after.reviewNote is string && after.reviewNote.size() <= 300
        && (after.status != 'rejected' || after.reviewNote.size() >= 3)
        && after.reviewedByUid == request.auth.uid && after.reviewedAt == request.time
        && after.updatedAt == request.time && after.version == before.version + 1
        && audit.staffId == staffId && audit.branch == before.branch && audit.group == kind
        && audit.uploadId == before.uploadId && audit.recordVersion == after.version
        && audit.status == after.status && audit.note == after.reviewNote
        && audit.actorUid == request.auth.uid && audit.recordedAt == request.time;
    }
    match /staff_document_config/{id} {
      allow get: if id == 'current';
      allow list, delete: if false;
      allow create, update: if id == 'current' && docVaultOwner()
        && request.resource.data.keys().hasOnly(['enabled', 'policyVersion', 'brokerEndpoint'])
        && request.resource.data.keys().hasAll(['enabled', 'policyVersion', 'brokerEndpoint'])
        && request.resource.data.enabled is bool && request.resource.data.policyVersion == 2
        && request.resource.data.brokerEndpoint == 'https://asia-southeast1-takodeal-pos.cloudfunctions.net/staffDocumentBroker';
    }
    match /staff_document_requests/{uid} {
      allow get: if (isSignedIn() && request.auth.uid == uid) || docVaultHQAll();
      allow list: if docVaultHQAll();
      allow create: if docVaultRequest(uid, request.resource.data);
      allow update: if (docVaultRequest(uid, request.resource.data)
          && resource.data.uid == uid && request.resource.data.staffId == resource.data.staffId)
        || (docVaultHQAll()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedByUid', 'reviewNote'])
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.reviewedAt == request.time && request.resource.data.reviewedByUid == request.auth.uid
          && request.resource.data.reviewNote is string && request.resource.data.reviewNote.size() <= 300
          && (request.resource.data.status != 'approved'
            || (getAfter(/databases/$(database)/documents/staff_document_devices/$(uid)).data.active == true
              && getAfter(/databases/$(database)/documents/staff_document_devices/$(uid)).data.staffId == resource.data.staffId)));
      allow delete: if false;
    }
    match /staff_document_devices/{uid} {
      allow get: if (isSignedIn() && request.auth.uid == uid) || docVaultHQAll();
      allow list: if docVaultHQAll();
      allow create: if docVaultHQAll() && docVaultBinding(uid, request.resource.data)
        && request.resource.data.active == true && request.resource.data.approvedAt == request.time
        && request.resource.data.audit.size() == 1
        && request.resource.data.approvedByUid == request.auth.uid
        && get(/databases/$(database)/documents/staff_document_requests/$(uid)).data.status == 'pending'
        && get(/databases/$(database)/documents/staff_document_requests/$(uid)).data.staffId == request.resource.data.staffId
        && getAfter(/databases/$(database)/documents/staff_document_requests/$(uid)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/staff_private_documents/$(request.resource.data.staffId)).data.branch == request.resource.data.branch;
      allow update: if docVaultHQAll() && docVaultBinding(uid, request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'updatedAt', 'updatedByUid', 'audit'])
        && request.resource.data.audit.diff(resource.data.audit).changedKeys().size() == 0
        && request.resource.data.audit.diff(resource.data.audit).removedKeys().size() == 0
        && request.resource.data.audit.diff(resource.data.audit).addedKeys().size() == 1;
      allow delete: if false;
    }
    match /staff_private_documents/{staffId} {
      allow get: if docVaultOwn(staffId) || docVaultScope(staffId);
      allow list: if docVaultHQAll();
      allow create, update: if docVaultHQAll()
        && request.resource.data.keys().hasOnly(['staffId', 'branch', 'version', 'updatedAt', 'updatedByUid'])
        && request.resource.data.keys().hasAll(['staffId', 'branch', 'version', 'updatedAt', 'updatedByUid'])
        && request.resource.data.staffId == staffId && docVaultId(staffId)
        && request.resource.data.branch is string && request.resource.data.branch.size() > 0 && request.resource.data.branch.size() <= 128
        && request.resource.data.version == 1 && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid
        && (resource == null || (request.resource.data.staffId == resource.data.staffId && request.resource.data.branch == resource.data.branch));
      allow delete: if false;
      match /files/{kind} {
        allow get: if docVaultOwn(staffId) || docVaultScope(staffId);
        allow list: if docVaultOwn(staffId) || docVaultScope(staffId);
        allow create: if docVaultUpload(staffId, kind, request.resource.data)
          && request.resource.data.version == 1
          && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/versions/$(request.resource.data.uploadId)).data == request.resource.data;
        allow update: if (docVaultUpload(staffId, kind, request.resource.data)
            && request.resource.data.version == resource.data.version + 1 && request.resource.data.uploadId != resource.data.uploadId
            && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/versions/$(request.resource.data.uploadId)).data == request.resource.data)
          || (docVaultReview(staffId, kind, resource.data, request.resource.data)
            && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/versions/$(resource.data.uploadId)).data == request.resource.data);
        allow delete: if false;
      }
      match /versions/{uploadId} {
        allow get: if docVaultOwn(staffId) || (resource != null && docVaultHQ(resource.data.branch));
        allow list: if docVaultOwn(staffId) || docVaultHQ(resource.data.branch);
        allow create: if docVaultUpload(staffId, request.resource.data.group, request.resource.data)
          && uploadId == request.resource.data.uploadId
          && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/files/$(request.resource.data.group)).data == request.resource.data;
        allow update: if docVaultReview(staffId, resource.data.group, resource.data, request.resource.data)
          && uploadId == resource.data.uploadId
          && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/files/$(resource.data.group)).data == request.resource.data;
        allow delete: if false;
      }
      match /reviews/{reviewId} {
        allow get: if docVaultOwn(staffId) || (resource != null && docVaultHQ(resource.data.branch));
        allow list: if docVaultOwn(staffId) || docVaultHQ(resource.data.branch);
        allow create: if docVaultId(reviewId)
          && request.resource.data.keys().hasOnly(['staffId', 'branch', 'recordVersion', 'group', 'uploadId', 'status', 'note', 'actorUid', 'recordedAt'])
          && request.resource.data.keys().hasAll(['staffId', 'branch', 'recordVersion', 'group', 'uploadId', 'status', 'note', 'actorUid', 'recordedAt'])
          && request.resource.data.staffId == staffId && docVaultHQ(request.resource.data.branch)
          && docVaultKind(request.resource.data.group) && docVaultId(request.resource.data.uploadId)
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.note is string && request.resource.data.note.size() <= 300
          && request.resource.data.actorUid == request.auth.uid && request.resource.data.recordedAt == request.time
          && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/files/$(request.resource.data.group)).data.reviewId == reviewId
          && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/files/$(request.resource.data.group)).data.version == request.resource.data.recordVersion
          && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/files/$(request.resource.data.group)).data.branch == request.resource.data.branch
          && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/files/$(request.resource.data.group)).data.uploadId == request.resource.data.uploadId;
        allow update, delete: if false;
      }
    }
  }
}
