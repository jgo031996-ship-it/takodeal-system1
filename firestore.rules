        && data.details == row.details && data.evidence == row.evidence && data.sourceShortageCents == row.sourceShortageCents
        && data.replyRevision == 0 && data.readRevision == 0 && data.createdAt == request.time && data.updatedAt == request.time
        && data.keys().hasOnly(['incidentId','type','staffId','staffName','branch','sourceShiftId','sourceReceiptId','sourcePlatform','amount','effectiveDate','status','version','id','sourceShortageCents','reasonLabel','details','evidence','noticeRevision','readRevision','replyRevision','createdAt','updatedAt']);
    }
    function cashShortageChargeReview(before,after,id) {
      let row = getAfter(/databases/$(database)/documents/cash_shortage_reviews/$(id)).data;
      let notice = getAfter(/databases/$(database)/documents/staff_deduction_notices/$(id)).data;
      return offlineOwner() && before.status in ['Pending Review','Unpaid'] && !before.keys().hasAny(['paidAt','payrollRecordId','partialPaid','amountPaid','payrollFrozen'])
        && after.diff(before).affectedKeys().hasOnly(['status','amount','authorizedAmount','effectiveDate','reviewRevision','reviewedAt','reviewedBy'])
        && after.reviewRevision == before.reviewRevision + 1 && after.reviewedAt == request.time && after.reviewedBy == request.auth.token.email
        && cashShortageLinks(row,after,notice,id) && after.status == (row.status == 'Approved' ? 'Unpaid' : 'Dismissed') && row.reviewedAt == request.time;
    }
    function cashShortageNoticeReview(before,after,id) {
      let row = getAfter(/databases/$(database)/documents/cash_shortage_reviews/$(id)).data;
      let charge = getAfter(/databases/$(database)/documents/staff_deductions/$(id)).data;
      return offlineOwner() && before.status in ['Pending Review','Approved']
        && after.diff(before).affectedKeys().hasOnly(['status','amount','effectiveDate','noticeRevision','lawfulBasis','authorityReference','finding','ownerReply','updatedAt'])
        && after.noticeRevision == before.noticeRevision + 1 && after.updatedAt == request.time && after.status == row.status
        && cashShortageLinks(row,charge,after,id) && row.reviewedAt == request.time
        && (row.status == 'Dismissed' ? after.ownerReply == row.dismissalReason : (after.ownerReply == row.finding && after.lawfulBasis == row.lawfulBasis && after.authorityReference == row.authorityReference && after.finding == row.finding));
    }
    function cashShortagePayrollRow(item,map,recordId) {
      let row = getAfter(/databases/$(database)/documents/cash_shortage_reviews/$(item.id)).data;
      return item.keys().hasOnly(['id','amount']) && item.id is string && item.amount is number && item.amount > 0 && map[item.id] == item.amount
        && row.status == 'Paid' && row.amount == item.amount && row.payrollRecordId == recordId && row.paidAt == request.time;
    }
    function cashShortageRow(rows,map,index,recordId) { return rows.size() <= index || cashShortagePayrollRow(rows[index],map,recordId); }
    function cashShortageProtectedPayroll(payroll) {
      return payroll.get('cashShortageSettlements',{}).size() > 0 || payroll.get('frozenData',{}).get('cashShortages',0) > 0 || payroll.get('frozenData',{}).get('cashShortageRows',[]).size() > 0;
    }
    // Validate the full tuple list once per payroll, not once for each of the three protected case records.
    function cashShortagePayrollMetadata(payroll,recordId) {
      let rows = payroll.get('frozenData',{}).get('cashShortageRows',[]);
      let map = payroll.get('cashShortageSettlements',{});
      return rows is list && rows.size() <= 6 && rows.toSet().size() == rows.size()
        && map is map && map.size() == rows.size()
        && cashShortageRow(rows,map,0,recordId) && cashShortageRow(rows,map,1,recordId) && cashShortageRow(rows,map,2,recordId) && cashShortageRow(rows,map,3,recordId) && cashShortageRow(rows,map,4,recordId) && cashShortageRow(rows,map,5,recordId)
        && payroll.get('frozenData',{}).get('cashShortages',0) == (rows.size() > 0 ? rows[0].amount : 0) + (rows.size() > 1 ? rows[1].amount : 0) + (rows.size() > 2 ? rows[2].amount : 0) + (rows.size() > 3 ? rows[3].amount : 0) + (rows.size() > 4 ? rows[4].amount : 0) + (rows.size() > 5 ? rows[5].amount : 0)
        && (rows.size() == 0 || (offlineOwner() && payroll.frozenData.isPaid == true && payroll.processedAt == request.time && payroll.processedBy == request.auth.token.email && rows.size() + payroll.get('refundSettlements',{}).size() <= 6));
    }
    function cashShortagePaidChange(before,after) {
      return offlineOwner() && before.type == 'Cash Shortage' && before.status in ['Approved','Unpaid'] && before.amount > 0
        && !before.keys().hasAny(['paidAt','payrollRecordId','partialPaid','amountPaid','payrollFrozen'])
        && after.diff(before).affectedKeys().hasOnly(['status','paidAt','payrollRecordId']) && after.status == 'Paid' && after.paidAt == request.time;
    }
    function cashShortageCasePaid(before,after,id) {
      let charge = getAfter(/databases/$(database)/documents/staff_deductions/$(id)).data;
      let notice = getAfter(/databases/$(database)/documents/staff_deduction_notices/$(id)).data;
      let payroll = getAfter(/databases/$(database)/documents/payroll_records/$(after.payrollRecordId)).data;
      // Links and all financial/source fields were established at authorization and are immutable in this transition.
      return cashShortagePaidChange(before,after) && before.status == 'Approved'
        && charge.status == 'Paid' && notice.status == 'Paid' && charge.amount == before.amount && notice.amount == before.amount
        && charge.reviewRevision == before.revision && notice.noticeRevision == before.revision
        && notice.replyRevision == before.replyRevisionReviewed && before.replyRevisionReviewed > 0 && notice.staffReply is string && notice.staffReply.size() > 0
        && charge.payrollRecordId == after.payrollRecordId && notice.payrollRecordId == after.payrollRecordId && charge.paidAt == request.time && notice.paidAt == request.time
        && payroll.staffId == before.staffId && payroll.frozenData.branch == before.staffBranch && payroll.frozenData.name == before.staffName
        && payroll.processedAt == request.time && payroll.frozenData.isPaid == true && before.effectiveDate <= payroll.endDate
        && payroll.cashShortageSettlements[id] == before.amount && {'id':id,'amount':before.amount} in payroll.frozenData.cashShortageRows;
    }
    function cashShortageCompanionPaid(before,after,id,revision) {
      let row = getAfter(/databases/$(database)/documents/cash_shortage_reviews/$(id)).data;
      return cashShortagePaidChange(before,after) && row.status == 'Paid' && row.staffId == before.staffId && row.amount == before.amount && row.revision == revision
        && row.payrollRecordId == after.payrollRecordId && row.paidAt == request.time;
    }
    match /cash_shortage_reviews/{id} {
      allow get, list: if offlineOwner() || staffRateHQ(resource.data.staffBranch);
      allow create: if cashShortageCreate(request.resource.data,id);
      allow update: if request.resource.data.status == 'Paid' ? cashShortageCasePaid(resource.data,request.resource.data,id) : cashShortageReview(resource.data,request.resource.data,id);
      allow delete: if false;
    }
    match /staff_deduction_notices/{id} {
      allow get, list: if offlineOwner() || docVaultOwn(resource.data.staffId) || (cashShortageKind(resource.data,id) && staffRateHQ(resource.data.branch));
      allow create: if cashShortageKind(request.resource.data,id) ? cashShortageNoticeCreate(request.resource.data,id) : refundNoticeCreate(request.resource.data,id);
      allow update: if cashShortageKind(resource.data,id) || cashShortageKind(request.resource.data,id)
        ? (request.resource.data.status == 'Paid' && resource.data.status != 'Paid' ? cashShortageCompanionPaid(resource.data,request.resource.data,id,resource.data.noticeRevision) : (refundNoticeStaffUpdate(resource.data,request.resource.data) || cashShortageNoticeReview(resource.data,request.resource.data,id)))
        : refundNoticeStaffUpdate(resource.data,request.resource.data)
        || refundNoticeOwnerUpdate(resource.data,request.resource.data,id) || refundPaid(resource.data,request.resource.data,id);
      allow delete: if false;
    }

    match /online_order_incidents/{id} {
      allow get, list: if offlineOwner();
      allow create: if onlineIncidentCreate(request.resource.data, id) || directIncidentCreate(request.resource.data,id);
      allow update: if onlineIncidentReview(resource.data, request.resource.data, id) || directIncidentReview(resource.data,request.resource.data,id) || refundPaid(resource.data,request.resource.data,id);
      allow delete: if false;
    }
    match /staff_deductions/{deductId} {
      allow read: if true;
      allow create: if cashShortageKind(request.resource.data,deductId) ? cashShortageChargeCreate(request.resource.data,deductId)
        : request.resource.data.get('type', '') == 'Online Order Refund' || deductId.matches('online-refund-.*')
        ? (onlineIncidentCharge(request.resource.data, deductId) || directIncidentCharge(request.resource.data,deductId))
        : request.resource.data.get('type', '') == 'Cancelled Food Purchase'
        ? (cancelledFoodWriter(request.resource.data.branch)
          && cancelledFoodChargeLink(request.resource.data, deductId))
        : isHQUser();
      allow update: if cashShortageKind(resource.data,deductId) || cashShortageKind(request.resource.data,deductId)
        ? (request.resource.data.status == 'Paid' ? cashShortageCompanionPaid(resource.data,request.resource.data,deductId,resource.data.reviewRevision) : cashShortageChargeReview(resource.data,request.resource.data,deductId))
        : resource.data.get('type', '') == 'Online Order Refund' || request.resource.data.get('type', '') == 'Online Order Refund' || deductId.matches('online-refund-.*')
        ? (offlineOwner() && resource.data.type == 'Online Order Refund' && request.resource.data.amount == 0
          && resource.data.status == 'Pending Review'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','responseRecorded','reviewedAt','reviewedBy'])
          && request.resource.data.responseRecorded == true
          && request.resource.data.status in ['Pending Review','Dismissed']
          && request.resource.data.status == getAfter(/databases/$(database)/documents/online_order_incidents/$(deductId)).data.status
          && request.resource.data.reviewedAt == request.time && request.resource.data.reviewedBy == request.auth.token.email) || (resource.data.get('type','') == 'Online Order Refund' && (directChargeReview(resource.data,request.resource.data,deductId) || refundPaid(resource.data,request.resource.data,deductId)))
        : resource.data.get('type', '') == 'Cancelled Food Purchase'
        ? verifiedHQ(resource.data.branch) : isHQUser();
      allow delete: if !cashShortageKind(resource.data,deductId) && resource.data.get('type', '') != 'Online Order Refund'
        && (resource.data.get('type', '') == 'Cancelled Food Purchase' ? verifiedHQ(resource.data.branch) : isHQUser());
    }
    match /staff_bonuses/{bonusId} { allow read: if true; allow write: if isHQUser(); }
    match /budgets/{budgetId} { allow read, write: if isHQUser(); }
    match /equipment_assets/{assetId} { allow read, write: if isHQUser(); }
    match /yield_logs/{yieldId} { allow read, write: if isHQUser(); }
    match /grab_payouts/{payoutId} { allow read, create: if true; allow update, delete: if isHQUser(); }
    match /foodpanda_payouts/{payoutId} { allow read, create: if true; allow update, delete: if isHQUser(); }
    match /payables/{payableId} { allow read, write: if isHQUser(); }
    match /hq_restocks/{restockId} { allow read, write: if isHQUser(); }
    match /suppliers/{document=**} { allow read, write: if isHQUser(); }
    match /daily_metrics/{document=**} { allow read, write: if isHQUser(); }
    match /archived_months/{document=**} { allow read, write: if isHQUser(); }
    match /franchise_ledger/{ledgerId} { allow read, create, update: if true; allow delete: if isHQUser(); }
    match /franchise_comms/{commId} { allow read, create, update: if true; allow delete: if isHQUser(); }
    match /franchise_accounts/{document=**} { allow read, write: if isHQUser(); }
    match /franchise_budgets/{document=**} { allow read, write: if isHQUser(); }
    match /riders/{riderId} { allow read, write: if isHQUser(); }
    match /rider_topups/{topupId} { allow read, write: if isHQUser(); }

    // Private Staff document vault. These new collections never use the legacy
    // isHQUser() helper or public cashiers/branches/settings as authority.
    function docVaultOwner() { return offlineOwner(); }
    function docVaultAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function docVaultId(value) {
      return value is string && value.matches('^[A-Za-z0-9_-]{1,128}$');
    }
    function docVaultKind(value) { return value in ['valid_id', 'health_card', 'clearance']; }
    function docVaultEnabled() {
      return exists(/databases/$(database)/documents/staff_document_config/current)
        && get(/databases/$(database)/documents/staff_document_config/current).data.enabled == true
        && get(/databases/$(database)/documents/staff_document_config/current).data.policyVersion == 2
        && get(/databases/$(database)/documents/staff_document_config/current).data.brokerEndpoint == 'https://asia-southeast1-takodeal-pos.cloudfunctions.net/staffDocumentBroker';
    }
    function docVaultHQ(branch) {
      let email = isSignedIn() ? request.auth.token.get('email', '') : '';
      let path = /databases/$(database)/documents/hq_email_access/$(email);
      return docVaultOwner() || (isSignedIn()
        && request.auth.token.get('email_verified', false) == true && email != ''
        && exists(path) && get(path).data.get('active', false) == true
        && get(path).data.get('permissions', []) is list
        && get(path).data.get('permissions', []).hasAny(['all', 'branches'])
        && get(path).data.get('allowedBranches', []) is list
        && get(path).data.get('allowedBranches', []).hasAny(['All', branch]));
    }
    function docVaultHQAll() {
      let email = isSignedIn() ? request.auth.token.get('email', '') : '';
      let path = /databases/$(database)/documents/hq_email_access/$(email);
      return docVaultOwner() || (isSignedIn()
        && request.auth.token.get('email_verified', false) == true && email != ''
        && exists(path) && get(path).data.get('active', false) == true
        && get(path).data.get('permissions', []) is list
        && 'all' in get(path).data.get('permissions', [])
        && get(path).data.get('allowedBranches', []) is list
        && 'All' in get(path).data.get('allowedBranches', []));
    }
    function docVaultOwn(staffId) {
      let uid = isSignedIn() ? request.auth.uid : '__unauthenticated__';
      let path = /databases/$(database)/documents/staff_document_devices/$(uid);
      return docVaultAnonymous() && exists(path)
        && get(path).data.uid == request.auth.uid
        && get(path).data.active == true && get(path).data.staffId == staffId;
    }
    function docVaultScope(staffId) {
      let path = /databases/$(database)/documents/staff_private_documents/$(staffId);
      return docVaultHQAll() || (exists(path) && get(path).data.staffId == staffId
        && docVaultHQ(get(path).data.branch));
    }
    function docVaultRequest(uid, data) {
      let path = /databases/$(database)/documents/staff_document_devices/$(uid);
      return docVaultEnabled() && docVaultAnonymous() && request.auth.uid == uid
        && data.keys().hasOnly(['uid', 'staffId', 'deviceId', 'deviceName', 'status', 'requestedAt'])
        && data.keys().hasAll(['uid', 'staffId', 'deviceId', 'deviceName', 'status', 'requestedAt'])
        && data.uid == uid && docVaultId(data.staffId)
        && data.deviceId is string && data.deviceId.size() <= 128
        && data.deviceName is string && data.deviceName.size() > 0 && data.deviceName.size() <= 80
        && data.status == 'pending' && data.requestedAt == request.time
        && (!exists(path) || (get(path).data.staffId == data.staffId && get(path).data.active == false));
    }
    function docVaultBinding(uid, data) {
      return docVaultId(uid) && data.keys().hasOnly(['uid', 'staffId', 'branch', 'active',
          'deviceId', 'deviceName', 'approvedAt', 'approvedByUid', 'updatedAt', 'updatedByUid', 'audit'])
        && data.keys().hasAll(['uid', 'staffId', 'branch', 'active', 'approvedAt',
          'approvedByUid', 'updatedAt', 'updatedByUid', 'audit'])
        && data.uid == uid && docVaultId(data.staffId)
        && data.branch is string && data.branch.size() > 0 && data.branch.size() <= 128
        && data.active is bool && data.approvedAt is timestamp && data.approvedByUid is string
        && data.updatedAt == request.time && data.updatedByUid == request.auth.uid
        && data.get('deviceId', '') is string && data.get('deviceId', '').size() <= 128
        && data.get('deviceName', '') is string && data.get('deviceName', '').size() <= 80
        && data.audit is map && data.audit.size() > 0 && data.audit.size() <= 100
        && data.audit.values().hasAny([{'active': data.active, 'actorUid': request.auth.uid, 'recordedAt': request.time}]);
    }
    function docVaultUpload(staffId, kind, data) {
      return docVaultEnabled() && docVaultOwn(staffId) && docVaultKind(kind)
        && data.keys().hasOnly(['staffId', 'branch', 'group', 'uploadId', 'uploadedByUid',
          'storagePath', 'contentType', 'size', 'sha256', 'clearanceType', 'expiresOn', 'status',
          'reviewNote', 'version', 'uploadedAt', 'updatedAt'])
        && data.keys().hasAll(['staffId', 'branch', 'group', 'uploadId', 'uploadedByUid',
          'storagePath', 'contentType', 'size', 'sha256', 'clearanceType', 'expiresOn', 'status',
          'reviewNote', 'version', 'uploadedAt', 'updatedAt'])
        && data.staffId == staffId
        && data.branch == get(/databases/$(database)/documents/staff_document_devices/$(request.auth.uid)).data.branch && data.group == kind
        && docVaultId(data.uploadId) && data.uploadedByUid == request.auth.uid
        && data.storagePath == 'staff_private_documents/' + request.auth.uid + '/' + staffId + '/' + kind + '/' + data.uploadId + '.jpg'
        && data.contentType == 'image/jpeg' && data.size is int && data.size > 0 && data.size <= 2097152
        && data.sha256 is string && data.sha256.matches('^[a-f0-9]{64}$')
        && data.clearanceType is string
        && ((kind == 'clearance' && data.clearanceType in ['NBI', 'POLICE'])
          || (kind != 'clearance' && data.clearanceType == ''))
        && data.expiresOn is string && (data.expiresOn == '' || data.expiresOn.matches('^\\d{4}-\\d{2}-\\d{2}$'))
        && data.status == 'pending_review' && data.reviewNote == ''
        && data.version is int && data.version > 0
        && data.uploadedAt == request.time && data.updatedAt == request.time;
    }
    function docVaultReview(staffId, kind, before, after) {
      let audit = getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/reviews/$(after.reviewId)).data;
      return docVaultHQ(before.branch) && docVaultKind(kind)
        && before.staffId == staffId && before.group == kind
        && after.diff(before).affectedKeys().hasOnly(['status', 'reviewId', 'reviewNote',
          'reviewedByUid', 'reviewedAt', 'updatedAt', 'version'])
        && after.status in ['approved', 'rejected'] && docVaultId(after.reviewId)
        && after.reviewNote is string && after.reviewNote.size() <= 300
        && (after.status != 'rejected' || after.reviewNote.size() >= 3)
        && after.reviewedByUid == request.auth.uid && after.reviewedAt == request.time
        && after.updatedAt == request.time && after.version == before.version + 1
        && audit.staffId == staffId && audit.branch == before.branch && audit.group == kind
        && audit.uploadId == before.uploadId && audit.recordVersion == after.version
        && audit.status == after.status && audit.note == after.reviewNote
        && audit.actorUid == request.auth.uid && audit.recordedAt == request.time;
    }
    match /staff_document_config/{id} {
      allow get: if id == 'current';
      allow list, delete: if false;
      allow create, update: if id == 'current' && docVaultOwner()
        && request.resource.data.keys().hasOnly(['enabled', 'policyVersion', 'brokerEndpoint'])
        && request.resource.data.keys().hasAll(['enabled', 'policyVersion', 'brokerEndpoint'])
        && request.resource.data.enabled is bool && request.resource.data.policyVersion == 2
        && request.resource.data.brokerEndpoint == 'https://asia-southeast1-takodeal-pos.cloudfunctions.net/staffDocumentBroker';
    }
    match /staff_document_requests/{uid} {
      allow get: if (isSignedIn() && request.auth.uid == uid) || docVaultHQAll();
      allow list: if docVaultHQAll();
      allow create: if docVaultRequest(uid, request.resource.data);
      allow update: if (docVaultRequest(uid, request.resource.data)
          && resource.data.uid == uid && request.resource.data.staffId == resource.data.staffId)
        || (docVaultHQAll()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedByUid', 'reviewNote'])
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.reviewedAt == request.time && request.resource.data.reviewedByUid == request.auth.uid
          && request.resource.data.reviewNote is string && request.resource.data.reviewNote.size() <= 300
          && (request.resource.data.status != 'approved'
            || (getAfter(/databases/$(database)/documents/staff_document_devices/$(uid)).data.active == true
              && getAfter(/databases/$(database)/documents/staff_document_devices/$(uid)).data.staffId == resource.data.staffId)));
      allow delete: if false;
    }
    match /staff_document_devices/{uid} {
      allow get: if (isSignedIn() && request.auth.uid == uid) || docVaultHQAll();
      allow list: if docVaultHQAll();
      allow create: if docVaultHQAll() && docVaultBinding(uid, request.resource.data)
        && request.resource.data.active == true && request.resource.data.approvedAt == request.time
        && request.resource.data.audit.size() == 1
        && request.resource.data.approvedByUid == request.auth.uid
        && get(/databases/$(database)/documents/staff_document_requests/$(uid)).data.status == 'pending'
        && get(/databases/$(database)/documents/staff_document_requests/$(uid)).data.staffId == request.resource.data.staffId
        && getAfter(/databases/$(database)/documents/staff_document_requests/$(uid)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/staff_private_documents/$(request.resource.data.staffId)).data.branch == request.resource.data.branch;
      allow update: if docVaultHQAll() && docVaultBinding(uid, request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'updatedAt', 'updatedByUid', 'audit'])
        && request.resource.data.audit.diff(resource.data.audit).changedKeys().size() == 0
        && request.resource.data.audit.diff(resource.data.audit).removedKeys().size() == 0
        && request.resource.data.audit.diff(resource.data.audit).addedKeys().size() == 1;
      allow delete: if false;
    }
    match /staff_private_documents/{staffId} {
      allow get: if docVaultOwn(staffId) || docVaultScope(staffId);
      allow list: if docVaultHQAll();
      allow create, update: if docVaultHQAll()
        && request.resource.data.keys().hasOnly(['staffId', 'branch', 'version', 'updatedAt', 'updatedByUid'])
        && request.resource.data.keys().hasAll(['staffId', 'branch', 'version', 'updatedAt', 'updatedByUid'])
        && request.resource.data.staffId == staffId && docVaultId(staffId)
        && request.resource.data.branch is string && request.resource.data.branch.size() > 0 && request.resource.data.branch.size() <= 128
        && request.resource.data.version == 1 && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid
        && (resource == null || (request.resource.data.staffId == resource.data.staffId && request.resource.data.branch == resource.data.branch));
      allow delete: if false;
      match /files/{kind} {
        allow get: if docVaultOwn(staffId) || docVaultScope(staffId);
        allow list: if docVaultOwn(staffId) || docVaultScope(staffId);
        allow create: if docVaultUpload(staffId, kind, request.resource.data)
          && request.resource.data.version == 1
          && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/versions/$(request.resource.data.uploadId)).data == request.resource.data;
        allow update: if (docVaultUpload(staffId, kind, request.resource.data)
            && request.resource.data.version == resource.data.version + 1 && request.resource.data.uploadId != resource.data.uploadId
            && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/versions/$(request.resource.data.uploadId)).data == request.resource.data)
          || (docVaultReview(staffId, kind, resource.data, request.resource.data)
            && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/versions/$(resource.data.uploadId)).data == request.resource.data);
        allow delete: if false;
      }
      match /versions/{uploadId} {
        allow get: if docVaultOwn(staffId) || (resource != null && docVaultHQ(resource.data.branch));
        allow list: if docVaultOwn(staffId) || docVaultHQ(resource.data.branch);
        allow create: if docVaultUpload(staffId, request.resource.data.group, request.resource.data)
          && uploadId == request.resource.data.uploadId
          && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/files/$(request.resource.data.group)).data == request.resource.data;
        allow update: if docVaultReview(staffId, resource.data.group, resource.data, request.resource.data)
          && uploadId == resource.data.uploadId
          && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/files/$(resource.data.group)).data == request.resource.data;
        allow delete: if false;
      }
      match /reviews/{reviewId} {
        allow get: if docVaultOwn(staffId) || (resource != null && docVaultHQ(resource.data.branch));
        allow list: if docVaultOwn(staffId) || docVaultHQ(resource.data.branch);
        allow create: if docVaultId(reviewId)
          && request.resource.data.keys().hasOnly(['staffId', 'branch', 'recordVersion', 'group', 'uploadId', 'status', 'note', 'actorUid', 'recordedAt'])
          && request.resource.data.keys().hasAll(['staffId', 'branch', 'recordVersion', 'group', 'uploadId', 'status', 'note', 'actorUid', 'recordedAt'])
          && request.resource.data.staffId == staffId && docVaultHQ(request.resource.data.branch)
          && docVaultKind(request.resource.data.group) && docVaultId(request.resource.data.uploadId)
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.note is string && request.resource.data.note.size() <= 300
          && request.resource.data.actorUid == request.auth.uid && request.resource.data.recordedAt == request.time
          && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/files/$(request.resource.data.group)).data.reviewId == reviewId
          && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/files/$(request.resource.data.group)).data.version == request.resource.data.recordVersion
          && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/files/$(request.resource.data.group)).data.branch == request.resource.data.branch
          && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/files/$(request.resource.data.group)).data.uploadId == request.resource.data.uploadId;
        allow update, delete: if false;
      }
    }
  }
}
