    }
    function earlyTimeOutHQ(branch) {
      let email = isSignedIn() ? request.auth.token.get('email', '') : '';
      let grant = /databases/$(database)/documents/hq_email_access/$(email);
      return offlineOwner() || (isSignedIn() && request.auth.token.get('email_verified', false) == true
        && exists(grant) && get(grant).data.get('active', false) == true
        && get(grant).data.get('permissions', []) is list
        && get(grant).data.permissions.hasAny(['all', 'payroll', 'inbox'])
        && get(grant).data.get('allowedBranches', []) is list
        && get(grant).data.allowedBranches.hasAny(['All', branch]));
    }
    function earlyTimeOutApproval(data, id) {
      let pending = get(/databases/$(database)/documents/staff_requests/$(id)).data;
      let reviewed = getAfter(/databases/$(database)/documents/staff_requests/$(id)).data;
      let start = get(/databases/$(database)/documents/attendance_logs/$(data.timeInLogId)).data;
      let person = get(/databases/$(database)/documents/cashiers/$(data.staffId)).data;
      return earlyTimeOutHQ(data.branch)
        && data.keys().hasOnly(['schemaVersion', 'requestId', 'requestVersion', 'requestToken', 'decision',
          'staffId', 'staffName', 'branch', 'timeInLogId', 'timeInAt', 'scheduledEndAt', 'scheduleFingerprint',
          'requestedDepartureAt', 'reviewedByUid', 'reviewedByEmail', 'reviewedAt', 'validUntil', 'reviewNote'])
        && data.keys().hasAll(['schemaVersion', 'requestId', 'requestVersion', 'requestToken', 'decision',
          'staffId', 'staffName', 'branch', 'timeInLogId', 'timeInAt', 'scheduledEndAt', 'scheduleFingerprint',
          'requestedDepartureAt', 'reviewedByUid', 'reviewedByEmail', 'reviewedAt', 'validUntil', 'reviewNote'])
        && data.schemaVersion == 1 && data.requestId == id && id.matches('^early-[a-f0-9]{64}$')
        && data.requestVersion is int && data.requestVersion > 0
        && data.requestToken is string && data.requestToken.matches('^[A-Za-z0-9_-]{8,120}$')
        && data.decision in ['Approved', 'Rejected'] && pending.type == 'Early Time Out'
        && pending.status == 'Pending' && reviewed.status == data.decision
