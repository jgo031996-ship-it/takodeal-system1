    function emergencyShiftHead(data, id) {
      return data.keys().hasOnly(['schemaVersion','status','revisionId','version','staffId','staffName','branch','timeInLogId','timeInAt','expectedStartAt','expectedEndAt','workDate','shiftName','sourceFingerprint','reviewedByUid','reviewedByEmail','reviewedAt'])
        && data.keys().hasAll(['schemaVersion','status','revisionId','version','staffId','staffName','branch','timeInLogId','timeInAt','expectedStartAt','expectedEndAt','workDate','shiftName','sourceFingerprint','reviewedByUid','reviewedByEmail','reviewedAt'])
