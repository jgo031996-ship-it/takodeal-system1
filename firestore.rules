rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner() {
      return isSignedIn() && (
        request.auth.token.email == 'jgo031996@gmail.com' ||
        (request.auth.token.email_verified == true && request.auth.token.email == 'jgo031996@gmail.com')
      );
    }
    function isHQUser() { return isSignedIn(); }
    function offlineOwner() {
      return isSignedIn() && request.auth.token.get('email', '') == 'jgo031996@gmail.com'
        && request.auth.token.get('email_verified', false) == true;
    }
    function offlineGate(branch) {
      return branch is string
        && exists(/databases/$(database)/documents/offline_policy/$(branch))
        && get(/databases/$(database)/documents/offline_policy/$(branch)).data.get('requireCashierForCustomerOrders', false) == true;
    }
    function protectedSales(branch) {
      return branch is string
        && exists(/databases/$(database)/documents/offline_policy/$(branch))
        && get(/databases/$(database)/documents/offline_policy/$(branch)).data.get('protectSalesV2', false) == true;
    }
    function verifiedHQ(branch) {
      let email = isSignedIn() ? request.auth.token.get('email', '') : '';
      return offlineOwner() || (isSignedIn()
        && request.auth.token.get('email_verified', false) == true
        && email != ''
        && exists(/databases/$(database)/documents/hq_email_access/$(email))
        && get(/databases/$(database)/documents/hq_email_access/$(email)).data.get('active', false) == true
        && ('All' in get(/databases/$(database)/documents/hq_email_access/$(email)).data.get('allowedBranches', [])
          || branch in get(/databases/$(database)/documents/hq_email_access/$(email)).data.get('allowedBranches', [])));
    }
    function approvedUID(uid, branch) {
      return exists(/databases/$(database)/documents/pos_bindings/$(uid))
        && get(/databases/$(database)/documents/pos_bindings/$(uid)).data.get('status', '') == 'Active'
        && get(/databases/$(database)/documents/pos_bindings/$(uid)).data.get('branch', '') == branch;
    }
    function trustedPOS(branch) {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && approvedUID(request.auth.uid, branch);
    }
    // Retain the staged policy for existing PIN-based Cashier devices. Locked
    // branches still require the same Owner-approved UID; revoked bindings are
    // never admitted through the compatibility route.
    function cancelledFoodWriter(branch) {
      return isSignedIn() && (request.auth.token.firebase.sign_in_provider == 'anonymous'
        ? (exists(/databases/$(database)/documents/pos_bindings/$(request.auth.uid))
          ? approvedUID(request.auth.uid, branch) : !protectedSales(branch) && !offlineGate(branch))
        : verifiedHQ(branch));
    }
    function ownTrustedDevice() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && exists(/databases/$(database)/documents/pos_bindings/$(request.auth.uid))
        && get(/databases/$(database)/documents/pos_bindings/$(request.auth.uid)).data.status == 'Active';
    }
    function freshCashier(branch) {
      let lease = get(/databases/$(database)/documents/cashier_leases/$(branch)).data;
      return lease.get('seenAt', null) is timestamp
        && lease.seenAt <= request.time
        && request.time < lease.seenAt + duration.value(3, 'm')
        && approvedUID(lease.get('uid', ''), branch);
    }
    function admittedCustomer(data) {
      let branch = data.get('branch', '');
      let state = get(/databases/$(database)/documents/settings/$('status_' + branch)).data;
      return isSignedIn() && request.auth.token.get('email_verified', false) == true
        && data.get('customerEmail', '') == request.auth.token.get('email', '')
        && data.get('status', '') == 'mobile_queue'
        && data.get('paymentStatus', 'unpaid') != 'paid'
        && data.get('totalAmount', -1) is number && data.totalAmount >= 0
        && data.get('items', []) is list && data.items.size() > 0
        && state.get('mobileOrdersActive', true) == true && freshCashier(branch);
    }
    function incomingCreate(data) {
      let branch = data.get('branch', '');
      return !offlineGate(branch) || trustedPOS(branch) || verifiedHQ(branch) || admittedCustomer(data);
    }
    function incomingUpdate(before, after) {
      let oldBranch = before.get('branch', '');
      let newBranch = after.get('branch', '');
      return (!offlineGate(oldBranch) && !offlineGate(newBranch))
        || (oldBranch == newBranch && (trustedPOS(oldBranch) || verifiedHQ(oldBranch)
          || !after.diff(before).affectedKeys().hasAny([
            'branch', 'items', 'totalAmount', 'customerEmail', 'customerName',
            'orderCode', 'orderType', 'contactNumber', 'deliveryAddress', 'mapLink',
            'preferredTime', 'paymentMode', 'paymentReference', 'changeFor',
            'deliveryFee', 'timestamp'
          ])));
    }
    // Sale-safety compatibility. Keep the existing staged branch policy.
    function saleWriter(branch) {
      return branch is string && branch.size() > 0
        && (!protectedSales(branch) || verifiedHQ(branch) || trustedPOS(branch));
    }
    function safetySale(data, id) {
      let marker = getAfter(/databases/$(database)/documents/pos_sale_commits/$(id)).data;
      return data.get('saleVersion', 0) == 2 && data.get('saleId', '') == id
        && data.get('inventoryMovements', null) is list
        && data.get('inventoryState', '') in ['applied', 'deferred']
        && marker.saleId == id && marker.branch == data.branch && marker.receiptId == data.receiptId;
    }
    function preparedShift(before, after) {
      let shift = get(/databases/$(database)/documents/shifts/$(before.shiftId)).data;
      let next = getAfter(/databases/$(database)/documents/shifts/$(before.shiftId)).data;
      return shift.branch == before.branch && shift.active == true && shift.get('status', '') != 'Closed'
        && next.active == true && next.get('salesRevision', 0) == shift.get('salesRevision', 0) + 1;
    }
    function preparedCancellation(before, after, id) {
      let detail = after.get('preparedCancellation', {});
      return before.get('saleVersion', 0) == 2 && before.get('saleId', '') == id
        && before.get('paymentMethod', '') is string
        && before.paymentMethod.trim().lower() in ['grab','foodpanda','panda']
        && before.get('status', '') != 'Voided' && before.get('status', '') != 'Parked'
        && before.get('inventoryState', '') in ['applied','deferred']
        && after.get('status', '') == 'Voided' && after.inventoryState == before.inventoryState
        && after.voidTime == request.time && after.voidedBy is string
        && detail.keys().hasOnly(['reason','label','platform','prepared']) && detail.prepared == true
        && detail.reason in ['customer','rider']
        && detail.label == (detail.reason == 'customer' ? 'Prepared but customer cancelled' : 'Prepared but rider cancelled')
        && detail.platform == (before.paymentMethod.trim().lower() == 'grab' ? 'Grab' : 'Foodpanda')
        && after.diff(before).affectedKeys().hasOnly(['status','voidTime','voidedBy','preparedCancellation'])
        && preparedShift(before, after);
    }
    function cancelledDiscount(config) {
      let value = config.get('cancelledFoodDiscountPct', 20);
      return value is number ? value
        : value is string && value.trim().matches('^[+]?([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][+-]?[0-9]+)?$') ? float(value.trim()) : -1;
    }
    function cancelledStaffPin(staff) {
      let value = staff.get('pin', null);
      return value == null || value == '' ? string(staff.get('securityPin', '')) : string(value);
    }
    function cancelledFoodSource(source, id, fingerprint) {
      let marker = get(/databases/$(database)/documents/pos_sale_commits/$(id)).data;
      return source.get('saleVersion', 0) == 2 && source.get('saleId', '') == id
        && source.get('paymentMethod', '') is string
        && source.paymentMethod.trim().lower() in ['grab','foodpanda','panda']
        && source.get('inventoryState', '') in ['applied','deferred']
        && source.get('inventoryMovements', null) is list
        && source.get('cart', null) is list && source.cart.size() > 0
        && marker.saleId == id && marker.branch == source.branch && marker.receiptId == source.receiptId
        && marker.fingerprint == fingerprint;
    }
    function cancelledFoodPurchase(data, id) {
      let prior = get(/databases/$(database)/documents/transactions/$(data.cancelledFoodSourceId)).data;
      let source = getAfter(/databases/$(database)/documents/transactions/$(data.cancelledFoodSourceId)).data;
      let staff = get(/databases/$(database)/documents/cashiers/$(data.cancelledFoodStaffId)).data;
      let config = exists(/databases/$(database)/documents/settings/global_pos_config)
        ? get(/databases/$(database)/documents/settings/global_pos_config).data : {};
      let charge = getAfter(/databases/$(database)/documents/staff_deductions/$(id)).data;
      let base = source.get('subTotalBeforeDiscount', null) == null ? source.netTotal : source.subTotalBeforeDiscount;
      let percent = cancelledDiscount(config);
      let baseCents = math.round(base * 100);
      let discountCents = math.round(baseCents * percent / 100.0);
      let quoted = data.get('cancelledFoodQuote', {});
      return id.matches('cancelled-food-.+') && !exists(/databases/$(database)/documents/transactions/$(id))
        && data.get('saleVersion', 0) == 2 && data.get('saleId', '') == id
        && config.get('cancelledFoodPurchaseEnabled', true) == true
        && cancelledFoodSource(prior, data.cancelledFoodSourceId, quoted.get('fingerprint', ''))
        && prior.status == 'Voided' && prior.get('preparedCancellation', {}).get('prepared', false) == true
        && prior.get('cancelledFoodPurchaseId', '') == ''
        && source.diff(prior).affectedKeys().hasOnly(['cancelledFoodPurchaseId'])
        && source.status == 'Voided' && source.get('preparedCancellation', {}).get('prepared', false) == true
        && source.cancelledFoodPurchaseId == id && data.branch == source.branch && data.shiftId == source.shiftId
        && preparedShift(source, source)
        && data.cart == source.cart && data.inventoryMovements == [] && data.inventoryState == 'applied'
        && data.status == 'Paid' && data.paymentMethod == 'Salary Deduction' && data.paymentVerified == true
        && data.cancelledFoodSourceReceiptId == source.receiptId && data.globalDiscountType == 'cancelled_food' && data.amountReceived == 0
        && data.timestamp == request.time && data.receiptId == 'CF-' + source.receiptId
        && base is number && base >= 0 && percent >= 0 && percent <= 100
        && data.globalDiscountValue == percent
        && data.subTotalBeforeDiscount == baseCents / 100.0
        && data.netTotal == (baseCents - discountCents) / 100.0
        && data.globalDiscountAmount == discountCents / 100.0
        && quoted.keys().hasOnly(['sourceSaleId','branch','shiftId','sourceReceiptId','platform','baseAmount','discountPct','discountAmount','amount','fingerprint'])
        && quoted.sourceSaleId == data.cancelledFoodSourceId && quoted.branch == data.branch && quoted.shiftId == data.shiftId
        && quoted.sourceReceiptId == source.receiptId
        && quoted.platform == (source.paymentMethod.trim().lower() == 'grab' ? 'Grab' : 'Foodpanda')
        && quoted.baseAmount == data.subTotalBeforeDiscount && quoted.discountPct == percent
        && quoted.discountAmount == data.globalDiscountAmount && quoted.amount == data.netTotal
        && quoted.fingerprint is string && quoted.fingerprint.size() > 0
        && cancelledStaffPin(staff).trim().upper() != 'REVOKED'
        && staff.get('active', true) != false && staff.get('archived', false) != true
        && !string(staff.get('status', '')).lower().matches('.*(blocked|inactive|terminated|archived|resigned|deleted).*')
        && staff.get('role', 'Staff') is string
        && staff.get('role', 'Staff').trim().lower() in ['staff','staff crew','crew','cashier','manager']
        && staff.get('cashierName', staff.get('fullName', staff.get('name', ''))) == data.customerName
        && charge.purchaseId == id && charge.staffId == data.cancelledFoodStaffId && charge.staffName == data.customerName
        && charge.branch == data.branch && charge.sourceSaleId == data.cancelledFoodSourceId
        && charge.amount == data.netTotal && charge.type == 'Cancelled Food Purchase'
        && charge.originalAmount == data.subTotalBeforeDiscount && charge.discountPct == percent
        && charge.discountAmount == data.globalDiscountAmount
        && charge.sourceReceiptId == source.receiptId && charge.sourcePlatform == quoted.platform
        && charge.receiptId == data.receiptId
        && charge.category == 'Foods' && charge.status == 'Unpaid' && charge.dateAdded == request.time;
    }
    function preparedPurchaseTransition(before, after, id) {
      let purchaseId = after.get('cancelledFoodPurchaseId', '');
      return before.get('saleVersion', 0) == 2 && before.get('saleId', '') == id
        && before.get('preparedCancellation', {}).get('prepared', false) == true && before.status == 'Voided'
        && before.get('cancelledFoodPurchaseId', '') == '' && purchaseId is string && purchaseId != ''
        && after.diff(before).affectedKeys().hasOnly(['cancelledFoodPurchaseId'])
        // A genuinely new companion receipt must pass its own complete create
        // validator. Do not repeat that validator here (Rules expression cap).
        && !exists(/databases/$(database)/documents/transactions/$(purchaseId))
        && getAfter(/databases/$(database)/documents/transactions/$(purchaseId)).data.cancelledFoodSourceId == id;
    }
    function cancelledFoodChargeLink(data, id) {
      let purchase = getAfter(/databases/$(database)/documents/transactions/$(id)).data;
      // The receipt create rule validates both this charge and its source
      // transition atomically. A prior receipt cannot authorize a new charge.
      return data.purchaseId == id && !exists(/databases/$(database)/documents/transactions/$(id))
        && purchase.get('cancelledFoodSourceId', '') != ''
        && purchase.branch == data.branch && purchase.cancelledFoodStaffId == data.staffId
        && purchase.customerName == data.staffName && purchase.netTotal == data.amount;
    }
    function cancelledPolicyWrite(id, before, after) {
      // Protect only this feature's policy fields. Existing unrelated settings
      // and staged branch policy behavior remain compatible.
      return id != 'global_pos_config'
        || !after.diff(before).affectedKeys().hasAny(['cancelledFoodPurchaseEnabled', 'cancelledFoodDiscountPct'])
        || ((offlineOwner() || verifiedHQ('All'))
          && (!after.keys().hasAny(['cancelledFoodPurchaseEnabled']) || after.cancelledFoodPurchaseEnabled is bool)
          && (!after.keys().hasAny(['cancelledFoodDiscountPct'])
            || (after.cancelledFoodDiscountPct is number && after.cancelledFoodDiscountPct >= 0 && after.cancelledFoodDiscountPct <= 100)));
    }
    function safetyTransition(before, after, id) {
      let changed = after.diff(before).affectedKeys();
      return before.get('saleVersion', 0) == 2 && before.get('saleId', '') == id
        && (
          (before.get('inventoryState', '') == 'deferred' && after.get('inventoryState', '') == 'applied'
            && after.inventoryAppliedAt == request.time && changed.hasOnly(['inventoryState', 'inventoryAppliedAt']))
          || (before.get('status', '') == 'Voided' && before.get('preparedCancellation', {}).get('prepared', false) != true && before.get('inventoryState', '') == 'deferred'
            && after.get('inventoryState', '') == 'cancelled' && changed.hasOnly(['inventoryState']))
          || (before.get('status', '') != 'Voided' && before.get('cancelledFoodSourceId', '') == '' && before.get('inventoryState', '') in ['applied', 'deferred']
            && after.get('status', '') == 'Voided' && after.get('voidedBy', null) is string
            && after.voidTime == request.time
            && after.get('inventoryState', '') == (before.inventoryState == 'applied' ? 'reversed' : 'cancelled')
            && changed.hasOnly(['status', 'voidedBy', 'voidTime', 'inventoryState']))
          || preparedCancellation(before, after, id) || preparedPurchaseTransition(before, after, id)
        );
    }
    function parkedAccountability(data, id) {
      let parkedId = data.get('parkedOrderId', '');
      return parkedId is string && parkedId.size() > 0 && id == 'parked-delete-' + parkedId
        && data.get('status', '') == 'Voided' && data.get('inventoryState', '') == 'none'
        && data.get('inventoryMovements', null) == []
        && exists(/databases/$(database)/documents/parked_orders/$(parkedId))
        && get(/databases/$(database)/documents/parked_orders/$(parkedId)).data.branch == data.branch
        && !existsAfter(/databases/$(database)/documents/parked_orders/$(parkedId));
    }
    function saleCounterWrite() {
      let after = request.resource.data;
      let id = after.get('lastSaleId', '');
      let branch = after.get('lastSaleBranch', '');
      let direction = after.get('lastSaleDirection', 0);
      let sale = getAfter(/databases/$(database)/documents/transactions/$(id)).data;
      let marker = getAfter(/databases/$(database)/documents/pos_sale_commits/$(id)).data;
      let prior = exists(/databases/$(database)/documents/settings/global_stats) ? resource.data : {};
      let beforeSale = exists(/databases/$(database)/documents/transactions/$(id))
        ? get(/databases/$(database)/documents/transactions/$(id)).data : {};
      return saleWriter(branch) && id is string && id.size() > 0 && direction in [1, -1]
        && sale.get('saleVersion', 0) == 2 && sale.saleId == id && sale.branch == branch
        && marker.saleId == id && marker.branch == branch && marker.receiptId == sale.receiptId
        && sale.ballsCounted is number && sale.ballsCounted > 0
        && after.diff(prior).affectedKeys().hasOnly([
          'totalTakoyakiBalls', 'balls_' + branch, 'lastSaleId', 'lastSaleBranch', 'lastSaleDirection'])
        && after.totalTakoyakiBalls == prior.get('totalTakoyakiBalls', 0) + direction * sale.ballsCounted
        && after.get('balls_' + branch, 0) == prior.get('balls_' + branch, 0) + direction * sale.ballsCounted
        && ((direction == 1 && !exists(/databases/$(database)/documents/transactions/$(id))
              && sale.get('status', '') != 'Voided')
          || (direction == -1 && beforeSale.get('saleVersion', 0) == 2
              && beforeSale.get('saleId', '') == id && beforeSale.get('branch', '') == branch
              && beforeSale.get('ballsCounted', 0) == sale.ballsCounted
              && beforeSale.get('status', '') != 'Voided' && sale.get('status', '') == 'Voided'));
    }
    function saleAuditWrite(id) {
      let data = request.resource.data;
      let branch = data.get('branch', '');
      // The present branch names use ASCII letters, spaces, dots and hyphens.
      // Other names keep the existing signed-in settings path.
      return branch is string && branch.matches('[A-Za-z0-9 _.-]+')
        && id == 'audit_' + branch.replace(' ', '%20').replace('[.]', '%2E')
        && saleWriter(branch) && data.keys().hasOnly(['active', 'branch', 'updatedBy', 'updatedAt'])
        && data.active is bool && data.updatedBy is string && data.updatedAt == request.time;
    }
    match /pos_sale_commits/{id} {
      // Missing markers must be readable before the first atomic sale commit.
      // Existing legacy-branch receipts already have public reads in this policy.
      allow get: if resource == null
        || !protectedSales(resource.data.branch) || verifiedHQ(resource.data.branch) || trustedPOS(resource.data.branch);
      allow list: if offlineOwner() || verifiedHQ(resource.data.branch) || trustedPOS(resource.data.branch);
      allow create: if saleWriter(request.resource.data.get('branch', ''))
        && request.resource.data.keys().hasOnly(['saleId', 'branch', 'receiptId', 'fingerprint', 'committedAt'])
        && request.resource.data.saleId == id && request.resource.data.receiptId is string
        && request.resource.data.fingerprint is string && request.resource.data.committedAt == request.time
        && !exists(/databases/$(database)/documents/transactions/$(id))
        && safetySale(getAfter(/databases/$(database)/documents/transactions/$(id)).data, id);
      allow update, delete: if false;
    }
    match /offline_policy/{branch} { allow read: if true; allow write: if offlineOwner(); }
    match /hq_email_access/{email} {
      allow read: if offlineOwner() || (isSignedIn() && request.auth.token.get('email', '') == email);
      allow write: if offlineOwner();
    }
    match /pos_bindings/{uid} {
      allow read: if offlineOwner() || (isSignedIn() && request.auth.uid == uid);
      allow create: if offlineOwner() || (isSignedIn()
        && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().hasOnly(['uid', 'deviceId', 'deviceName', 'branch', 'legacyDeviceDocId', 'status', 'requestedAt'])
        && request.resource.data.uid == uid && request.resource.data.status == 'Pending'
        && request.resource.data.branch is string && request.resource.data.branch.size() > 0
        && request.resource.data.deviceId is string && request.resource.data.legacyDeviceDocId is string
        && request.resource.data.deviceName is string && request.resource.data.requestedAt == request.time);
      allow update, delete: if offlineOwner();
    }
    match /cashier_presence/{uid} {
      allow read: if offlineOwner() || (isSignedIn() && request.auth.uid == uid) || verifiedHQ(resource.data.branch);
      allow create, update: if trustedPOS(request.resource.data.branch) && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'branch', 'deviceId', 'deviceName', 'cashier', 'shiftId', 'seenAt', 'accepting', 'pendingSales', 'pendingOperations', 'ownerReviews', 'lastReceipt', 'setupProblem'])
        && request.resource.data.uid == uid && request.resource.data.seenAt == request.time
        && request.resource.data.accepting is bool && request.resource.data.pendingSales is int
        && request.resource.data.pendingSales >= 0
        && request.resource.data.deviceId == get(/databases/$(database)/documents/pos_bindings/$(uid)).data.deviceId;
      allow delete: if offlineOwner();
    }
    match /cashier_leases/{branch} {
      allow read: if true;
      allow create, update: if trustedPOS(branch)
        && request.resource.data.keys().hasOnly(['branch', 'uid', 'seenAt'])
        && request.resource.data.branch == branch && request.resource.data.uid == request.auth.uid
        && request.resource.data.seenAt == request.time
        && getAfter(/databases/$(database)/documents/cashier_presence/$(request.auth.uid)).data.accepting == true
        && getAfter(/databases/$(database)/documents/cashier_presence/$(request.auth.uid)).data.seenAt == request.time;
      allow delete: if offlineOwner();
    }
    match /pos_operation_commits/{id} {
      allow get: if offlineOwner()
        || (!exists(/databases/$(database)/documents/pos_operation_commits/$(id)) && ownTrustedDevice())
        || verifiedHQ(resource.data.branch) || trustedPOS(resource.data.branch);
      allow list: if offlineOwner() || verifiedHQ(resource.data.branch) || trustedPOS(resource.data.branch);
      allow create: if offlineOwner() || (trustedPOS(request.resource.data.branch)
        && request.resource.data.state in ['synced', 'owner_review']);
      allow update: if offlineOwner();
      allow delete: if false;
    }
    match /pos_operation_reviews/{id} {
      allow get: if offlineOwner()
        || (!exists(/databases/$(database)/documents/pos_operation_reviews/$(id)) && ownTrustedDevice())
        || verifiedHQ(resource.data.branch) || trustedPOS(resource.data.branch);
      allow list: if offlineOwner() || verifiedHQ(resource.data.branch) || trustedPOS(resource.data.branch);
      allow create: if offlineOwner() || (trustedPOS(request.resource.data.branch)
        && request.resource.data.status == 'Pending' && request.resource.data.id == id
        && request.resource.data.deviceId == get(/databases/$(database)/documents/pos_bindings/$(request.auth.uid)).data.deviceId);
      allow update: if offlineOwner();
      allow delete: if false;
    }
    match /pos_branch_shifts/{branch} {
      allow read: if offlineOwner() || verifiedHQ(branch) || trustedPOS(branch);
      allow create, update: if offlineOwner() || (trustedPOS(branch) && request.resource.data.branch == branch);
      allow delete: if false;
    }
    match /pos_attendance_heads/{staff} {
      allow read: if isSignedIn();
      allow create, update: if offlineOwner() || trustedPOS(request.resource.data.branch);
      allow delete: if false;
    }
    match /pos_staff_meal_claims/{id} {
      allow get: if offlineOwner() || ownTrustedDevice();
      allow list: if offlineOwner();
      allow create: if offlineOwner() || (
        trustedPOS(request.resource.data.branch)
        && request.resource.data.deviceId == get(/databases/$(database)/documents/pos_bindings/$(request.auth.uid)).data.deviceId
        && request.resource.data.staffId is string && request.resource.data.day is string
        && id == request.resource.data.staffId + '__' + request.resource.data.day
        && exists(/databases/$(database)/documents/cashiers/$(request.resource.data.staffId))
        && get(/databases/$(database)/documents/cashiers/$(request.resource.data.staffId)).data.cashierName == request.resource.data.staffName
        && (
          (request.resource.data.get('saleId', '') != ''
            && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.saleId)).data.get('staffMealClaimId', '') == id
            && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.saleId)).data.branch == request.resource.data.branch
            && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.saleId)).data.globalDiscountType == 'staff_meal')
          || (request.resource.data.get('requestId', '') != ''
            && getAfter(/databases/$(database)/documents/staff_requests/$(request.resource.data.requestId)).data.get('staffId', '') == request.resource.data.staffId
            && getAfter(/databases/$(database)/documents/staff_requests/$(request.resource.data.requestId)).data.branch == request.resource.data.branch
            && getAfter(/databases/$(database)/documents/staff_requests/$(request.resource.data.requestId)).data.type == 'Staff Meal')
        )
      );
      allow update: if offlineOwner();
      allow delete: if false;
    }
    match /pos_staff_meal_exceptions/{id} { allow read, create: if offlineOwner(); allow update, delete: if false; }
    match /shift_metric_commits/{id} { allow read: if offlineOwner(); allow write: if false; }

    match /hq_managers/{managerId} { allow read: if isSignedIn(); allow write: if isOwner(); }
    match /settings/{docId} {
      allow read: if true;
