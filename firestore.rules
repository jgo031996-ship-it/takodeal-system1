rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner() {
      return isSignedIn() && (
        request.auth.token.email == 'jgo031996@gmail.com' ||
        (request.auth.token.email_verified == true && request.auth.token.email == 'jgo031996@gmail.com')
      );
    }
    function transactionBefore(id) { return get(/databases/$(database)/documents/transactions/$(id)).data; }
    function transactionAfter(id) { return getAfter(/databases/$(database)/documents/transactions/$(id)).data; }
    function staffDeductionAfter(id) { return getAfter(/databases/$(database)/documents/staff_deductions/$(id)).data; }
    function isHQUser() { return isSignedIn(); }
    function offlineOwner() {
      return isSignedIn() && request.auth.token.get('email', '') == 'jgo031996@gmail.com'
        && request.auth.token.get('email_verified', false) == true;
    }
    function offlineGate(branch) {
      return branch is string
        && exists(/databases/$(database)/documents/offline_policy/$(branch))
        && get(/databases/$(database)/documents/offline_policy/$(branch)).data.get('requireCashierForCustomerOrders', false) == true;
    }
    function protectedSales(branch) {
      return branch is string
        && exists(/databases/$(database)/documents/offline_policy/$(branch))
        && get(/databases/$(database)/documents/offline_policy/$(branch)).data.get('protectSalesV2', false) == true;
    }
    function verifiedHQ(branch) {
      let email = isSignedIn() ? request.auth.token.get('email', '') : '';
      let path = /databases/$(database)/documents/hq_email_access/$(email);
      let owner = offlineOwner();
      let eligible = !owner && isSignedIn() && request.auth.token.get('email_verified', false) == true && email != '';
      let grant = eligible && exists(path) ? get(path).data : {};
      return owner || (grant.get('active', false) == true
        && ('All' in grant.get('allowedBranches', []) || branch in grant.get('allowedBranches', [])));
    }
    function approvedUID(uid, branch) {
      let path = /databases/$(database)/documents/pos_bindings/$(uid);
      let present = exists(path);
      let binding = present ? get(path).data : {};
      return present && binding.get('status', '') == 'Active'
        && binding.get('branch', '') == branch;
    }
    function trustedPOS(branch) {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && approvedUID(request.auth.uid, branch);
    }
    // Retain the staged policy for existing PIN-based Cashier devices. Locked
    // branches still require the same Owner-approved UID; revoked bindings are
    // never admitted through the compatibility route.
    function ownTrustedDevice() {
      let eligible = isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
      let uid = eligible ? request.auth.uid : '__unauthenticated__';
      let path = /databases/$(database)/documents/pos_bindings/$(uid);
      return eligible && exists(path) && get(path).data.status == 'Active';
    }
    function freshCashier(branch) {
      let lease = get(/databases/$(database)/documents/cashier_leases/$(branch)).data;
      return lease.get('seenAt', null) is timestamp
        && lease.seenAt <= request.time
        && request.time < lease.seenAt + duration.value(3, 'm')
        && approvedUID(lease.get('uid', ''), branch);
    }
    function admittedCustomer(data) {
      let branch = data.get('branch', '');
      let state = get(/databases/$(database)/documents/settings/$('status_' + branch)).data;
      return isSignedIn() && request.auth.token.get('email_verified', false) == true
        && data.get('customerEmail', '') == request.auth.token.get('email', '')
        && data.get('status', '') == 'mobile_queue'
        && data.get('paymentStatus', 'unpaid') != 'paid'
        && data.get('totalAmount', -1) is number && data.totalAmount >= 0
        && data.get('items', []) is list && data.items.size() > 0
        && state.get('mobileOrdersActive', true) == true && freshCashier(branch);
    }
    function incomingCreate(data) {
      let branch = data.get('branch', '');
      return !offlineGate(branch) || trustedPOS(branch) || verifiedHQ(branch) || admittedCustomer(data);
    }
    function incomingUpdate(before, after) {
      let oldBranch = before.get('branch', '');
      let newBranch = after.get('branch', '');
      return (!offlineGate(oldBranch) && !offlineGate(newBranch))
        || (oldBranch == newBranch && (trustedPOS(oldBranch) || verifiedHQ(oldBranch)
          || !after.diff(before).affectedKeys().hasAny([
            'branch', 'items', 'totalAmount', 'customerEmail', 'customerName',
            'orderCode', 'orderType', 'contactNumber', 'deliveryAddress', 'mapLink',
            'preferredTime', 'paymentMode', 'paymentReference', 'changeFor',
            'deliveryFee', 'timestamp'
          ])));
    }
    // Sale-safety compatibility. Keep the existing staged branch policy.
    function saleWriter(branch) {
      return branch is string && branch.size() > 0
        && (!protectedSales(branch) || verifiedHQ(branch) || trustedPOS(branch));
    }
    function safetySale(data, id) {
      let marker = getAfter(/databases/$(database)/documents/pos_sale_commits/$(id)).data;
      return data.get('saleVersion', 0) == 2 && data.get('saleId', '') == id
        && data.get('inventoryMovements', null) is list
        && data.get('inventoryState', '') in ['applied', 'deferred']
        && marker.saleId == id && marker.branch == data.branch && marker.receiptId == data.receiptId;
    }
    function cancelledDiscount(config) {
      let value = config.get('cancelledFoodDiscountPct', 20);
      return value is number ? value
        : value is string && value.trim().matches('^[+]?([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][+-]?[0-9]+)?$') ? float(value.trim()) : -1;
    }
    function cancelledFoodChargeLink(data, id) {
      let purchase = transactionAfter(id);
      // The receipt create rule validates both this charge and its source
      // transition atomically. A prior receipt cannot authorize a new charge.
      return data.purchaseId == id && !exists(/databases/$(database)/documents/transactions/$(id))
        && purchase.get('cancelledFoodSourceId', '') != ''
        && purchase.branch == data.branch && purchase.cancelledFoodStaffId == data.staffId
        && purchase.customerName == data.staffName && purchase.netTotal == data.amount
        && (purchase.get('cancelledFoodPortionVersion',0) != 1 || data.purchasedItems == purchase.cart);
    }
    // One serialized allocation map per original receipt makes concurrent
    // partial purchases mutually exclusive without re-consuming ingredients.
    function portionLine(source, purchase, prior, next, slot, percent) {
      let chosen = purchase.cancelledFoodSelection[slot];
      let original = source.cart[chosen.lineIndex];
      let item = purchase.cart[slot];
      let quantity = original.qty;
      let key = string(chosen.lineIndex);
      let previous = prior.get(key, 0);
      let total = original.get('lineTotalFinal', null) != null ? math.round(original.lineTotalFinal * 100)
        : math.round(original.get('price', original.get('variantPrice', original.get('basePrice', 0))) * original.qty * 100);
      let start = math.round(total * previous / quantity);
      let end = math.round(total * (previous + chosen.qty) / quantity);
      return chosen == {'lineIndex':chosen.lineIndex,'qty':chosen.qty,'allocationId':source.saleId,
          'priorPurchasedQty':previous,'baseCents':end-start,
          'discountCents':math.round(end * percent / 100.0)-math.round(start * percent / 100.0)}
        && chosen.lineIndex is int && chosen.lineIndex >= 0
        && (slot == 0 || chosen.lineIndex > purchase.cancelledFoodSelection[slot - 1].lineIndex)
        && quantity is int && quantity > 0 && quantity <= 100000
        && chosen.qty is int && chosen.qty > 0 && previous is int && previous >= 0
        && previous + chosen.qty <= quantity && next.get(key, 0) == previous + chosen.qty
        && total >= 0 && total <= 10000000000
        && item.diff(original).affectedKeys().hasOnly(['qty','lineTotalFinal','sourceLineIndex','sourceOriginalQty','baseAmount','discountAmount','amount'])
        && item.qty == chosen.qty && item.lineTotalFinal == chosen.baseCents / 100.0
        && item.sourceLineIndex == chosen.lineIndex
        && item.sourceOriginalQty == quantity
        && item.baseAmount == item.lineTotalFinal
        && item.discountAmount == chosen.discountCents / 100.0
        && item.amount == (chosen.baseCents-chosen.discountCents) / 100.0;
    }
    function portionProof(purchase, slot) {
      return getAfter(/databases/$(database)/documents/cancelled_food_purchase_lines/$(purchase.saleId+'--'+string(slot))).data
        == {'purchaseId':purchase.saleId,'sourceSaleId':purchase.cancelledFoodSourceId,'selectionSlot':slot};
    }
    function portionLines(source, purchase, prior, next) {
      let selection = purchase.cancelledFoodSelection;
      return selection is list && selection.size() > 0 && selection.size() <= 6
        && purchase.cart is list && purchase.cart.size() == selection.size()
        && next.diff(prior).affectedKeys().hasOnly([
          string(selection[0].lineIndex),
          selection.size() > 1 ? string(selection[1].lineIndex) : string(selection[0].lineIndex),
          selection.size() > 2 ? string(selection[2].lineIndex) : string(selection[0].lineIndex),
          selection.size() > 3 ? string(selection[3].lineIndex) : string(selection[0].lineIndex),
          selection.size() > 4 ? string(selection[4].lineIndex) : string(selection[0].lineIndex),
          selection.size() > 5 ? string(selection[5].lineIndex) : string(selection[0].lineIndex)])
        && portionProof(purchase,0)
        && (selection.size() < 2 || portionProof(purchase,1))
        && (selection.size() < 3 || portionProof(purchase,2))
        && (selection.size() < 4 || portionProof(purchase,3))
        && (selection.size() < 5 || portionProof(purchase,4))
        && (selection.size() < 6 || portionProof(purchase,5));
    }
    function cancelledPortionProof(data, id) {
      let purchase=transactionAfter(data.purchaseId);
      let source=transactionBefore(data.sourceSaleId);
      let prior=exists(/databases/$(database)/documents/cancelled_food_allocations/$(data.sourceSaleId))
        ? get(/databases/$(database)/documents/cancelled_food_allocations/$(data.sourceSaleId)).data.purchasedQuantities : {};
      let ledger=getAfter(/databases/$(database)/documents/cancelled_food_allocations/$(data.sourceSaleId)).data;
      let config=exists(/databases/$(database)/documents/settings/global_pos_config)
        ? get(/databases/$(database)/documents/settings/global_pos_config).data : {};
      return data.keys().hasOnly(['purchaseId','sourceSaleId','selectionSlot'])
        && data.selectionSlot is int && data.selectionSlot>=0 && data.selectionSlot<6
        && id==data.purchaseId+'--'+string(data.selectionSlot)
        && !exists(/databases/$(database)/documents/transactions/$(data.purchaseId))
        && purchase.cancelledFoodSourceId==data.sourceSaleId && purchase.cancelledFoodPortionVersion==1
        && ledger.lastPurchaseId==data.purchaseId
        && portionLine(source,purchase,prior,ledger.purchasedQuantities,data.selectionSlot,cancelledDiscount(config));
    }
    function cancelledPortionAllocation(data, sourceId) {
      let source = transactionBefore(sourceId);
      let purchase = transactionAfter(data.lastPurchaseId);
      let prior = resource == null ? {} : resource.data.purchasedQuantities;
      return data.keys().hasOnly(['sourceSaleId','sourceReceiptId','branch','shiftId','purchasedQuantities','lastPurchaseId','updatedAt'])
        && data.sourceSaleId == sourceId && data.sourceReceiptId == source.receiptId
        && data.branch == source.branch && data.shiftId == source.shiftId && data.updatedAt == request.time
        && data.purchasedQuantities is map && data.lastPurchaseId is string
        && !exists(/databases/$(database)/documents/transactions/$(data.lastPurchaseId))
        && purchase.cancelledFoodSourceId == sourceId && purchase.cancelledFoodPortionVersion == 1
        && source.get('cancelledFoodPurchaseId', '') == '' && source.status == 'Voided'
        && source.get('preparedCancellation', {}).get('prepared', false) == true
        && portionLines(source,purchase,prior,data.purchasedQuantities);
    }
    function cancelledPolicyWrite(id, before, after) {
      // Protect only this feature's policy fields. Existing unrelated settings
      // and staged branch policy behavior remain compatible.
      return id != 'global_pos_config'
        || !after.diff(before).affectedKeys().hasAny(['cancelledFoodPurchaseEnabled', 'cancelledFoodDiscountPct'])
        || ((offlineOwner() || verifiedHQ('All'))
          && (!after.keys().hasAny(['cancelledFoodPurchaseEnabled']) || after.cancelledFoodPurchaseEnabled is bool)
          && (!after.keys().hasAny(['cancelledFoodDiscountPct'])
            || (after.cancelledFoodDiscountPct is number && after.cancelledFoodDiscountPct >= 0 && after.cancelledFoodDiscountPct <= 100)));
    }
    function saleCounterWrite() {
      let after = request.resource.data;
      let id = after.get('lastSaleId', '');
      let branch = after.get('lastSaleBranch', '');
      let direction = after.get('lastSaleDirection', 0);
      let sale = transactionAfter(id);
      let marker = getAfter(/databases/$(database)/documents/pos_sale_commits/$(id)).data;
      let prior = exists(/databases/$(database)/documents/settings/global_stats) ? resource.data : {};
      let beforeSale = exists(/databases/$(database)/documents/transactions/$(id))
        ? transactionBefore(id) : {};
      return saleWriter(branch) && id is string && id.size() > 0 && direction in [1, -1]
        && sale.get('saleVersion', 0) == 2 && sale.saleId == id && sale.branch == branch
        && marker.saleId == id && marker.branch == branch && marker.receiptId == sale.receiptId
        && sale.ballsCounted is number && sale.ballsCounted > 0
        && after.diff(prior).affectedKeys().hasOnly([
          'totalTakoyakiBalls', 'balls_' + branch, 'lastSaleId', 'lastSaleBranch', 'lastSaleDirection'])
        && after.totalTakoyakiBalls == prior.get('totalTakoyakiBalls', 0) + direction * sale.ballsCounted
        && after.get('balls_' + branch, 0) == prior.get('balls_' + branch, 0) + direction * sale.ballsCounted
        && ((direction == 1 && !exists(/databases/$(database)/documents/transactions/$(id))
              && sale.get('status', '') != 'Voided')
          || (direction == -1 && beforeSale.get('saleVersion', 0) == 2
              && beforeSale.get('saleId', '') == id && beforeSale.get('branch', '') == branch
              && beforeSale.get('ballsCounted', 0) == sale.ballsCounted
              && beforeSale.get('status', '') != 'Voided' && sale.get('status', '') == 'Voided'));
    }
    function saleAuditWrite(id) {
      let data = request.resource.data;
      let branch = data.get('branch', '');
      // The present branch names use ASCII letters, spaces, dots and hyphens.
      // Other names keep the existing signed-in settings path.
      return branch is string && branch.matches('[A-Za-z0-9 _.-]+')
        && id == 'audit_' + branch.replace(' ', '%20').replace('[.]', '%2E')
        && saleWriter(branch) && data.keys().hasOnly(['active', 'branch', 'updatedBy', 'updatedAt'])
        && data.active is bool && data.updatedBy is string && data.updatedAt == request.time;
    }
    match /pos_sale_commits/{id} {
      // Missing markers must be readable before the first atomic sale commit.
      // Existing legacy-branch receipts already have public reads in this policy.
      allow get: if resource == null
        || !protectedSales(resource.data.branch) || verifiedHQ(resource.data.branch) || trustedPOS(resource.data.branch);
      allow list: if offlineOwner() || verifiedHQ(resource.data.branch) || trustedPOS(resource.data.branch);
      function selectorPosSaleCommitsCreate(data) {
        return saleWriter(data.get('branch', ''))
        && data.keys().hasOnly(['saleId', 'branch', 'receiptId', 'fingerprint', 'committedAt'])
        && data.saleId == id && data.receiptId is string
        && data.fingerprint is string && data.committedAt == request.time
        && !exists(/databases/$(database)/documents/transactions/$(id))
        && safetySale(getAfter(/databases/$(database)/documents/transactions/$(id)).data, id);
      }
      allow create: if selectorPosSaleCommitsCreate(request.resource.data);
      allow update, delete: if false;
    }
    match /offline_policy/{branch} { allow read: if true; allow write: if offlineOwner(); }
    match /hq_email_access/{email} {
      allow read: if offlineOwner() || (isSignedIn() && request.auth.token.get('email', '') == email);
      allow write: if offlineOwner();
    }
    match /pos_bindings/{uid} {
      allow read: if offlineOwner() || (isSignedIn() && request.auth.uid == uid);
      function selectorPosBindingsCreate(data) {
        return offlineOwner() || (isSignedIn()
        && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && data.keys().hasOnly(['uid', 'deviceId', 'deviceName', 'branch', 'legacyDeviceDocId', 'status', 'requestedAt'])
        && data.uid == uid && data.status == 'Pending'
        && data.branch is string && data.branch.size() > 0
        && data.deviceId is string && data.legacyDeviceDocId is string
        && data.deviceName is string && data.requestedAt == request.time);
      }
      allow create: if selectorPosBindingsCreate(request.resource.data);
      allow update, delete: if offlineOwner();
    }
    match /cashier_presence/{uid} {
      allow read: if offlineOwner() || (isSignedIn() && request.auth.uid == uid) || verifiedHQ(resource.data.branch);
      function selectorCashierPresenceCreateUpdate(data) {
        return trustedPOS(data.branch) && request.auth.uid == uid
        && data.keys().hasOnly(['uid', 'branch', 'deviceId', 'deviceName', 'cashier', 'shiftId', 'seenAt', 'accepting', 'pendingSales', 'pendingOperations', 'ownerReviews', 'lastReceipt', 'setupProblem'])
        && data.uid == uid && data.seenAt == request.time
        && data.accepting is bool && data.pendingSales is int
        && data.pendingSales >= 0
        && data.deviceId == get(/databases/$(database)/documents/pos_bindings/$(uid)).data.deviceId;
      }
      allow create, update: if selectorCashierPresenceCreateUpdate(request.resource.data);
      allow delete: if offlineOwner();
    }
    match /cashier_leases/{branch} {
      allow read: if true;
      function selectorCashierLeasesCreateUpdate(data) {
        return trustedPOS(branch)
        && data.keys().hasOnly(['branch', 'uid', 'seenAt'])
        && data.branch == branch && data.uid == request.auth.uid
        && data.seenAt == request.time
        && getAfter(/databases/$(database)/documents/cashier_presence/$(request.auth.uid)).data.accepting == true
        && getAfter(/databases/$(database)/documents/cashier_presence/$(request.auth.uid)).data.seenAt == request.time;
      }
      allow create, update: if selectorCashierLeasesCreateUpdate(request.resource.data);
      allow delete: if offlineOwner();
    }
    match /pos_operation_commits/{id} {
      allow get: if offlineOwner()
        || (!exists(/databases/$(database)/documents/pos_operation_commits/$(id)) && ownTrustedDevice())
        || verifiedHQ(resource.data.branch) || trustedPOS(resource.data.branch);
      allow list: if offlineOwner() || verifiedHQ(resource.data.branch) || trustedPOS(resource.data.branch);
      allow create: if offlineOwner() || (trustedPOS(request.resource.data.branch)
        && request.resource.data.state in ['synced', 'owner_review']);
      allow update: if offlineOwner();
      allow delete: if false;
    }
    match /pos_operation_reviews/{id} {
      allow get: if offlineOwner()
        || (!exists(/databases/$(database)/documents/pos_operation_reviews/$(id)) && ownTrustedDevice())
        || verifiedHQ(resource.data.branch) || trustedPOS(resource.data.branch);
      allow list: if offlineOwner() || verifiedHQ(resource.data.branch) || trustedPOS(resource.data.branch);
      function selectorPosOperationReviewsCreate(data) {
        return offlineOwner() || (trustedPOS(data.branch)
        && data.status == 'Pending' && data.id == id
        && data.deviceId == get(/databases/$(database)/documents/pos_bindings/$(request.auth.uid)).data.deviceId);
      }
      allow create: if selectorPosOperationReviewsCreate(request.resource.data);
      allow update: if offlineOwner();
      allow delete: if false;
    }
    match /pos_branch_shifts/{branch} {
      allow read: if offlineOwner() || verifiedHQ(branch) || trustedPOS(branch);
      allow create, update: if offlineOwner() || (trustedPOS(branch) && request.resource.data.branch == branch);
      allow delete: if false;
    }
    match /pos_attendance_heads/{staff} {
      allow read: if isSignedIn();
      allow create, update: if offlineOwner() || trustedPOS(request.resource.data.branch);
      allow delete: if false;
    }
    match /pos_staff_meal_claims/{id} {
      allow get: if offlineOwner() || ownTrustedDevice();
      allow list: if offlineOwner();
      function posStaffMealSale(data) {
        let sale = transactionAfter(data.saleId);
        return sale.get('staffMealClaimId', '') == id
          && sale.branch == data.branch && sale.globalDiscountType == 'staff_meal';
      }
      function posStaffMealRequest(data) {
        let mealRequest = getAfter(/databases/$(database)/documents/staff_requests/$(data.requestId)).data;
        return mealRequest.get('staffId', '') == data.staffId
          && mealRequest.branch == data.branch && mealRequest.type == 'Staff Meal';
      }
      function posStaffMealClaimCreate(data) {
        return offlineOwner() || (
            trustedPOS(data.branch)
            && data.deviceId == get(/databases/$(database)/documents/pos_bindings/$(request.auth.uid)).data.deviceId
            && data.staffId is string && data.day is string
            && id == data.staffId + '__' + data.day
            && exists(/databases/$(database)/documents/cashiers/$(data.staffId))
            && get(/databases/$(database)/documents/cashiers/$(data.staffId)).data.cashierName == data.staffName
            && (
              (data.get('saleId', '') != ''
                && posStaffMealSale(data))
              || (data.get('requestId', '') != ''
                && posStaffMealRequest(data))
            )
          );
      }
      allow create: if posStaffMealClaimCreate(request.resource.data);
      allow update: if offlineOwner();
      allow delete: if false;
    }
    match /pos_staff_meal_exceptions/{id} { allow read, create: if offlineOwner(); allow update, delete: if false; }
    match /shift_metric_commits/{id} { allow read: if offlineOwner(); allow write: if false; }

    match /hq_managers/{managerId} { allow read: if isSignedIn(); allow write: if isOwner(); }
    match /settings/{docId} {
      function disciplinePolicyFields(level) { return level.keys().hasOnly(['id','label','suspensionDays']) && level.size() == 3; }
      function disciplineLevels(levels) {
        let size = levels.size();
        let ids = [size>0?levels[0].id:'',size>1?levels[1].id:'',size>2?levels[2].id:'',size>3?levels[3].id:'',size>4?levels[4].id:'',
          size>5?levels[5].id:'',size>6?levels[6].id:'',size>7?levels[7].id:'',size>8?levels[8].id:'',size>9?levels[9].id:'',
          size>10?levels[10].id:'',size>11?levels[11].id:'',size>12?levels[12].id:'',size>13?levels[13].id:'',size>14?levels[14].id:'',
          size>15?levels[15].id:'',size>16?levels[16].id:'',size>17?levels[17].id:'',size>18?levels[18].id:'',size>19?levels[19].id:''];
        return levels is list && size >= 1 && size <= 20
          && ids.removeAll(['']).toSet().size() == levels.size()
          && disciplinePolicyFields(levels[0]) && (size<2||disciplinePolicyFields(levels[1])) && (size<3||disciplinePolicyFields(levels[2])) && (size<4||disciplinePolicyFields(levels[3])) && (size<5||disciplinePolicyFields(levels[4])) && (size<6||disciplinePolicyFields(levels[5])) && (size<7||disciplinePolicyFields(levels[6])) && (size<8||disciplinePolicyFields(levels[7])) && (size<9||disciplinePolicyFields(levels[8])) && (size<10||disciplinePolicyFields(levels[9])) && (size<11||disciplinePolicyFields(levels[10])) && (size<12||disciplinePolicyFields(levels[11])) && (size<13||disciplinePolicyFields(levels[12])) && (size<14||disciplinePolicyFields(levels[13])) && (size<15||disciplinePolicyFields(levels[14])) && (size<16||disciplinePolicyFields(levels[15])) && (size<17||disciplinePolicyFields(levels[16])) && (size<18||disciplinePolicyFields(levels[17])) && (size<19||disciplinePolicyFields(levels[18])) && (size<20||disciplinePolicyFields(levels[19]));
      }
      function disciplinePolicyWrite(data,oldRevision) {
        return protectedHROwner() && data.keys().hasOnly(['version','revision','levels','changeId','intent','updatedAt','updatedByUid','updatedByEmail'])
          && data.version == 1 && disciplineInt(oldRevision) && disciplineInt(data.revision) && data.revision == oldRevision + 1
          && data.changeId is string && data.changeId.matches('^[A-Za-z0-9_-]{1,128}$')
          && disciplineText(data.intent,1,20000) && data.updatedAt == request.time
          && data.updatedByUid == request.auth.uid && data.updatedByEmail == request.auth.token.email
          && disciplineLevels(data.levels);
      }
      function disciplineCounter(data,before,id) {
        let casePath = /databases/$(database)/documents/hr_sanctions/$(data.lastCaseId);
        let notice = getAfter(casePath).data;
        return disciplineHQ(data.branch) && data.keys().hasOnly(['version','staffId','staffName','branch','lastCaseNumber','lastCaseId','seededLegacyCount','updatedAt','updatedByUid','updatedByEmail'])
          && data.version == 1 && protectedHRId(data.staffId) && id == 'discipline_case_' + data.staffId
          && disciplineStaff(data.staffId,data.staffName,data.branch) && protectedHRId(data.lastCaseId)
          && disciplineInt(data.lastCaseNumber) && data.lastCaseNumber > 0 && disciplineInt(data.seededLegacyCount)
          && (before.size() == 0 ? data.lastCaseNumber > data.seededLegacyCount
            : before.version == 1 && data.staffId == before.staffId && data.seededLegacyCount == before.seededLegacyCount && data.lastCaseNumber == before.lastCaseNumber + 1)
          && disciplineActor(data,'updatedAt','updatedByUid','updatedByEmail') && !exists(casePath)
          && notice.caseVersion == 2 && notice.caseKey == data.staffId && notice.staffId == data.staffId
          && notice.staffName == data.staffName && notice.branch == data.branch && notice.caseNumber == data.lastCaseNumber
          && notice.issuedByUid == request.auth.uid && notice.issuedAt == request.time;
      }

      allow read: if true;
      allow create: if !docId.matches('discipline_.*') && (isHQUser() || docId.matches("status_.*"))
        && cancelledPolicyWrite(docId, {}, request.resource.data);
      allow update: if !docId.matches('discipline_.*') && (isHQUser() || docId.matches("status_.*"))
        && cancelledPolicyWrite(docId, resource.data, request.resource.data);
      allow delete: if !docId.matches('discipline_.*') && (isHQUser() || docId.matches("status_.*"))
        && cancelledPolicyWrite(docId, resource.data, {});
      // PIN-only legacy Cashiers can update counters only with their atomic sale
      // or first void, with exact deltas. No general settings write is opened.
      allow create, update: if docId == 'global_stats' && saleCounterWrite();
      allow create, update: if docId.matches('audit_.*') && saleAuditWrite(docId);
      allow create, update: if docId == 'discipline_policy' && disciplinePolicyWrite(request.resource.data, resource == null ? 0 : resource.data.revision);
      allow create, update: if docId.matches('discipline_case_.*') && disciplineCounter(request.resource.data, resource == null ? {} : resource.data, docId);
    }
    match /global_addons/{addonId} { allow read: if true; allow write: if isOwner(); }
    match /bom/{bomId} { allow read: if true; allow write: if isOwner(); }
    match /branches/{branchId} { allow read, write: if true; }
    match /menu/{menuId} { allow read, update: if true; allow create, delete: if isOwner(); }
    match /announcements/{document=**} { allow read, write: if true; }
    match /acknowledgments/{document=**} { allow read, write: if true; }
    match /reviews/{document=**} { allow read, create: if true; allow update, delete: if isHQUser(); }
    match /customer_feedback/{document=**} { allow create: if true; allow read, update, delete: if isHQUser(); }
    match /franchise_leads/{document=**} { allow create: if true; allow read, update, delete: if isHQUser(); }
    match /customer_app_categories/{document=**} { allow read, write: if isHQUser(); }

    match /transactions/{txId} {
      function cancelledFoodWriter(branch) {
        return isSignedIn() && (request.auth.token.firebase.sign_in_provider == 'anonymous'
          ? (exists(/databases/$(database)/documents/pos_bindings/$(request.auth.uid))
            ? approvedUID(request.auth.uid, branch) : !protectedSales(branch) && !offlineGate(branch))
          : verifiedHQ(branch));
      }
      function preparedShift(before, after) {
        let shift = get(/databases/$(database)/documents/shifts/$(before.shiftId)).data;
        let next = getAfter(/databases/$(database)/documents/shifts/$(before.shiftId)).data;
        return shift.branch == before.branch && shift.active == true && shift.get('status', '') != 'Closed'
          && next.active == true && next.get('salesRevision', 0) == shift.get('salesRevision', 0) + 1;
      }
      function preparedCancellation(before, after, id) {
        let detail = after.get('preparedCancellation', {});
        return before.get('saleVersion', 0) == 2 && before.get('saleId', '') == id
          && before.get('paymentMethod', '') is string
          && before.paymentMethod.trim().lower() in ['grab','foodpanda','panda']
          && before.get('status', '') != 'Voided' && before.get('status', '') != 'Parked'
          && before.get('inventoryState', '') in ['applied','deferred']
          && after.get('status', '') == 'Voided' && after.inventoryState == before.inventoryState
          && after.voidTime == request.time && after.voidedBy is string
          && detail.keys().hasOnly(['reason','label','platform','prepared']) && detail.prepared == true
          && detail.reason in ['customer','rider']
          && detail.label == (detail.reason == 'customer' ? 'Prepared but customer cancelled' : 'Prepared but rider cancelled')
          && detail.platform == (before.paymentMethod.trim().lower() == 'grab' ? 'Grab' : 'Foodpanda')
          && after.diff(before).affectedKeys().hasOnly(['status','voidTime','voidedBy','preparedCancellation'])
          && preparedShift(before, after);
      }
      function cancelledStaffPin(staff) {
        let value = staff.get('pin', null);
        return value == null || value == '' ? string(staff.get('securityPin', '')) : string(value);
      }
      function cancelledFoodSource(source, id, fingerprint) {
        let marker = get(/databases/$(database)/documents/pos_sale_commits/$(id)).data;
        return source.get('saleVersion', 0) == 2 && source.get('saleId', '') == id
          && source.get('paymentMethod', '') is string
          && source.paymentMethod.trim().lower() in ['grab','foodpanda','panda']
          && source.get('inventoryState', '') in ['applied','deferred']
          && source.get('inventoryMovements', null) is list
          && source.get('cart', null) is list && source.cart.size() > 0
          && marker.saleId == id && marker.branch == source.branch && marker.receiptId == source.receiptId
          && marker.fingerprint == fingerprint;
      }
      function cancelledBuyer(staff, name) {
        return cancelledStaffPin(staff).trim().upper() != 'REVOKED'
          && staff.get('active',true) != false && staff.get('archived',false) != true
          && !string(staff.get('status','')).lower().matches('.*(blocked|inactive|terminated|archived|resigned|deleted).*')
          && staff.get('role','Staff').trim().lower() in ['staff','staff crew','crew','cashier','manager']
          && staff.get('cashierName',staff.get('fullName',staff.get('name',''))) == name;
      }
      function cancelledCharge(data, charge, id, source) {
        return charge.diff({
          'staffId':data.cancelledFoodStaffId,'staffName':data.customerName,'branch':data.branch,
          'type':'Cancelled Food Purchase','category':'Foods','status':'Unpaid','amount':data.netTotal,
          'originalAmount':data.subTotalBeforeDiscount,'discountPct':data.globalDiscountValue,
          'discountAmount':data.globalDiscountAmount,'sourceSaleId':source.saleId,
          'sourceReceiptId':source.receiptId,'sourcePlatform':data.cancelledFoodQuote.platform,
          'purchaseId':id,'receiptId':data.receiptId,'item':charge.item,
          'dateAdded':request.time,'loggedBy':data.cashier
        }).affectedKeys().hasOnly(['purchasedItems','cancelledFoodSelection']);
      }
      function cancelledFoodPurchase(data, id) {
        let prior = transactionBefore(data.cancelledFoodSourceId);
        let source = transactionAfter(data.cancelledFoodSourceId);
        let config = exists(/databases/$(database)/documents/settings/global_pos_config)
          ? get(/databases/$(database)/documents/settings/global_pos_config).data : {};
        let base = prior.get('subTotalBeforeDiscount',prior.netTotal);
        let percent = cancelledDiscount(config);
        let baseCents = math.round(base * 100);
        let discountCents = math.round(baseCents * percent / 100.0);
        let quote = data.cancelledFoodQuote;
        return id.matches('cancelled-food-.+') && !exists(/databases/$(database)/documents/transactions/$(id))
          && config.get('cancelledFoodPurchaseEnabled',true) == true
          && cancelledFoodSource(prior,data.cancelledFoodSourceId,quote.fingerprint)
          && prior.status == 'Voided' && prior.preparedCancellation.prepared == true
          && prior.get('cancelledFoodPurchaseId','') == '' && prior.get('cancelledFoodAllocationVersion',0) == 0
          && source.diff(prior).affectedKeys().hasOnly(['cancelledFoodPurchaseId']) && source.cancelledFoodPurchaseId == id
          && [data.branch,data.shiftId,data.saleId,data.saleVersion,data.status,data.paymentMethod,data.paymentVerified,data.inventoryState,data.globalDiscountType,data.cancelledFoodSourceReceiptId,data.receiptId]
            == [source.branch,source.shiftId,id,2,'Paid','Salary Deduction',true,'applied','cancelled_food',source.receiptId,'CF-'+source.receiptId]
          && preparedShift(source,source) && data.cart == source.cart && data.inventoryMovements == [] && data.amountReceived == 0
          && data.timestamp == request.time && base is number && base >= 0 && percent >= 0 && percent <= 100
          && data.globalDiscountValue == percent && data.subTotalBeforeDiscount == baseCents / 100.0
          && data.globalDiscountAmount == discountCents / 100.0 && data.netTotal == (baseCents-discountCents) / 100.0
          && quote == {'sourceSaleId':source.saleId,'branch':data.branch,'shiftId':data.shiftId,'sourceReceiptId':source.receiptId,
            'platform':source.paymentMethod.trim().lower() == 'grab' ? 'Grab' : 'Foodpanda','baseAmount':data.subTotalBeforeDiscount,
            'discountPct':data.globalDiscountValue,'discountAmount':data.globalDiscountAmount,'amount':data.netTotal,'fingerprint':quote.fingerprint}
          && cancelledBuyer(get(/databases/$(database)/documents/cashiers/$(data.cancelledFoodStaffId)).data,data.customerName)
          && cancelledCharge(data,staffDeductionAfter(id),id,source);
      }
      function preparedPurchaseTransition(before, after, id) {
        let purchaseId = after.get('cancelledFoodPurchaseId', '');
        return before.get('saleVersion', 0) == 2 && before.get('saleId', '') == id
          && before.get('preparedCancellation', {}).get('prepared', false) == true && before.status == 'Voided'
          && before.get('cancelledFoodPurchaseId', '') == '' && purchaseId is string && purchaseId != ''
          && before.get('cancelledFoodAllocationVersion', 0) == 0
          && after.diff(before).affectedKeys().hasOnly(['cancelledFoodPurchaseId'])
          // A genuinely new companion receipt must pass its own complete create
          // validator. Do not repeat that validator here (Rules expression cap).
          && !exists(/databases/$(database)/documents/transactions/$(purchaseId))
          && transactionAfter(purchaseId).cancelledFoodSourceId == id;
      }
      function portionSum(selection, key) {
        return selection[0][key]
          + (selection.size() > 1 ? selection[1][key] : 0)
          + (selection.size() > 2 ? selection[2][key] : 0)
          + (selection.size() > 3 ? selection[3][key] : 0)
          + (selection.size() > 4 ? selection[4][key] : 0)
          + (selection.size() > 5 ? selection[5][key] : 0);
      }
      function cancelledPortionPurchase(data, id) {
        let source = transactionBefore(data.cancelledFoodSourceId);
        let ledger = getAfter(/databases/$(database)/documents/cancelled_food_allocations/$(data.cancelledFoodSourceId)).data;
        let config = exists(/databases/$(database)/documents/settings/global_pos_config)
          ? get(/databases/$(database)/documents/settings/global_pos_config).data : {};
        let quote = data.cancelledFoodQuote;
        let selection = data.cancelledFoodSelection;
        let base = portionSum(selection,'baseCents');
        let discount = portionSum(selection,'discountCents');
        let percent = cancelledDiscount(config);
        let charge = staffDeductionAfter(id);
        return id.matches('^cancelled-food-.+-portion-'+quote.operationId+'$')
          && quote.operationId.matches('^[a-f0-9]{32}$') && !exists(/databases/$(database)/documents/transactions/$(id))
          && config.get('cancelledFoodPurchaseEnabled',true) == true
          && cancelledFoodSource(source,data.cancelledFoodSourceId,quote.fingerprint)
          && source.status == 'Voided' && source.preparedCancellation.prepared == true && source.get('cancelledFoodPurchaseId','') == ''
          && transactionAfter(data.cancelledFoodSourceId).cancelledFoodLastPurchaseId == id
          && [ledger.lastPurchaseId,ledger.sourceSaleId,ledger.branch,ledger.shiftId,ledger.updatedAt]
            == [id,source.saleId,source.branch,source.shiftId,request.time]
          && [data.branch,data.shiftId,data.saleId,data.saleVersion,data.status,data.paymentMethod,data.paymentVerified,data.inventoryState,data.inventoryReviewRequired,data.globalDiscountType,data.cancelledFoodSourceReceiptId,data.receiptId,data.cancelledFoodPortionVersion]
            == [source.branch,source.shiftId,id,2,'Paid','Salary Deduction',true,'applied',false,'cancelled_food',source.receiptId,'CF-'+source.receiptId+'-'+quote.operationId,1]
          && selection.size()>0 && selection.size()<=6 && data.cart.size()==selection.size()
          && data.inventoryMovements == [] && data.amountReceived==0 && data.timestamp==request.time
          && data.globalDiscountValue==percent && percent>=0 && percent<=100
          && data.subTotalBeforeDiscount==base / 100.0 && data.globalDiscountAmount==discount / 100.0
          && data.netTotal==(base-discount) / 100.0 && data.netTotal>=0
          && quote == {'portionVersion':1,'operationId':quote.operationId,'selection':selection,
            'sourceSaleId':source.saleId,'branch':data.branch,'shiftId':data.shiftId,'sourceReceiptId':source.receiptId,
            'platform':source.paymentMethod.trim().lower() == 'grab' ? 'Grab' : 'Foodpanda',
            'baseAmount':data.subTotalBeforeDiscount,'discountPct':data.globalDiscountValue,
            'discountAmount':data.globalDiscountAmount,'amount':data.netTotal,'fingerprint':quote.fingerprint}
          && cancelledBuyer(get(/databases/$(database)/documents/cashiers/$(data.cancelledFoodStaffId)).data,data.customerName)
          && cancelledCharge(data,charge,id,source) && charge.cancelledFoodSelection==selection;
      }
      function preparedPortionTransition(before, after, id) {
        let purchaseId = after.get('cancelledFoodLastPurchaseId', '');
        let purchase = transactionAfter(purchaseId);
        return before.get('saleVersion', 0) == 2 && before.get('saleId', '') == id
          && before.status == 'Voided' && before.get('preparedCancellation', {}).get('prepared', false) == true
          && before.get('cancelledFoodPurchaseId', '') == ''
          && before.get('cancelledFoodAllocationVersion', 0) in [0,1]
          && after.diff(before).affectedKeys().hasOnly(['cancelledFoodAllocationVersion','cancelledFoodLastPurchaseId','cancelledFoodPurchasedUnits'])
          && after.cancelledFoodAllocationVersion == 1
          && !exists(/databases/$(database)/documents/transactions/$(purchaseId))
          && purchase.cancelledFoodSourceId == id && purchase.cancelledFoodPortionVersion == 1
          && after.cancelledFoodPurchasedUnits == before.get('cancelledFoodPurchasedUnits',0) + portionSum(purchase.cancelledFoodSelection,'qty')
          && preparedShift(before,after);
      }
      function ordinaryTransactionUpdate(before, after, id) {
        return before.get('preparedCancellation',{}).get('prepared',false) == true
          ? (before.inventoryState == 'deferred' && after.inventoryState == 'applied'
            && after.inventoryAppliedAt == request.time
            && after.diff(before).affectedKeys().hasOnly(['inventoryState','inventoryAppliedAt']) && saleWriter(before.branch))
          : before.get('cancelledFoodSourceId','') != '' ? false
          : (!protectedSales(before.get('branch','')) && !protectedSales(after.get('branch','')))
          || (before.get('branch','') == after.get('branch','')
            && (verifiedHQ(before.get('branch','')) || (trustedPOS(before.get('branch',''))
              && ((before.get('inventoryState','') == 'audit_pending' && after.get('inventoryState','') == 'applied'
                && after.diff(before).affectedKeys().hasOnly(['inventoryState'])) || safetyTransition(before,after,id)))));
      }
      function safetyTransition(before, after, id) {
        let changed = after.diff(before).affectedKeys();
        return before.get('saleVersion', 0) == 2 && before.get('saleId', '') == id
          && (
            (before.get('inventoryState', '') == 'deferred' && after.get('inventoryState', '') == 'applied'
              && after.inventoryAppliedAt == request.time && changed.hasOnly(['inventoryState', 'inventoryAppliedAt']))
            || (before.get('status', '') == 'Voided' && before.get('preparedCancellation', {}).get('prepared', false) != true && before.get('inventoryState', '') == 'deferred'
              && after.get('inventoryState', '') == 'cancelled' && changed.hasOnly(['inventoryState']))
            || (before.get('status', '') != 'Voided' && before.get('cancelledFoodSourceId', '') == '' && before.get('inventoryState', '') in ['applied', 'deferred']
              && after.get('status', '') == 'Voided' && after.get('voidedBy', null) is string
              && after.voidTime == request.time
              && after.get('inventoryState', '') == (before.inventoryState == 'applied' ? 'reversed' : 'cancelled')
              && changed.hasOnly(['status', 'voidedBy', 'voidTime', 'inventoryState']))
            || preparedCancellation(before, after, id) || preparedPurchaseTransition(before, after, id)
          );
      }
      function parkedAccountability(data, id) {
        let parkedId = data.get('parkedOrderId', '');
        return parkedId is string && parkedId.size() > 0 && id == 'parked-delete-' + parkedId
          && data.get('status', '') == 'Voided' && data.get('inventoryState', '') == 'none'
          && data.get('inventoryMovements', null) == []
          && exists(/databases/$(database)/documents/parked_orders/$(parkedId))
          && get(/databases/$(database)/documents/parked_orders/$(parkedId)).data.branch == data.branch
          && !existsAfter(/databases/$(database)/documents/parked_orders/$(parkedId));
      }

      allow read: if true;
      function selectorTransactionsCreate(data) {
        return data.get('cancelledFoodSourceId', '') != ''
        ? (cancelledFoodWriter(data.branch)
          && (data.get('cancelledFoodPortionVersion',0) == 1
            ? cancelledPortionPurchase(data,txId) : cancelledFoodPurchase(data, txId))
          && safetySale(data, txId))
        : (!protectedSales(data.get('branch', ''))
        || verifiedHQ(data.get('branch', ''))
        || (trustedPOS(data.get('branch', ''))
          && ((data.get('localSaleId', '') == txId && data.get('syncVersion', 0) == 2)
