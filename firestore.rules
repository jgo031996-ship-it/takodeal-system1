    function emergencyShiftOrigin(data, id) {
      let start = get(/databases/$(database)/documents/attendance_logs/$(id)).data;
      let person = get(/databases/$(database)/documents/cashiers/$(data.staffId)).data;
      let date = data.workDate.split('-');
      let midnight = timestamp.date(int(date[0]), int(date[1]), int(date[2])) - duration.value(8, 'h');
      return data.timeInLogId == id && data.timeInAt == start.timestamp
        && start.type == 'TIME IN' && start.timestamp is timestamp && start.timestamp <= request.time
        && start.branch == data.branch && start.staffName == data.staffName
        && start.get('deleted', false) != true && !(start.get('status', '') in ['Voided', 'Cancelled'])
        && (start.get('staffId', '') == data.staffId || start.get('staffId', '') == '')
        && person.cashierName == data.staffName && person.get('active', true) != false
