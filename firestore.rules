    match /attendance_logs/{logId} { allow read, create, update: if true; allow delete: if isHQUser(); }
    match /manager_alerts/{alertId} { allow read, create, update: if true; allow delete: if isHQUser(); }
    match /sop_logs/{sopId} { allow read, create, update: if true; allow delete: if isHQUser(); }
    match /shift_swaps/{swapId} { allow read, create, update: if true; allow delete: if isHQUser(); }
    match /shifts/{shiftId} { allow read, create, update: if true; allow delete: if isOwner(); }
    match /expenses/{expenseId} { allow read, create, update: if true; allow delete: if isHQUser(); }
    match /remittances/{remitId} { allow read, create, update: if true; allow delete: if isOwner(); }
    match /store_use_logs/{document=**} { allow read, create, update: if true; allow delete: if isHQUser(); }
    match /account_logs/{logId} { allow read, create, update: if true; allow delete: if isHQUser(); }
    match /cash_accounts/{accountId} { allow read, create, update: if true; allow delete: if isHQUser(); }
    match /inventory/{itemId} { allow read, create, update: if true; allow delete: if isOwner(); }
    match /stock_counts/{countId} { allow read, create, update: if true; allow delete: if isOwner(); }
    match /inventory_logs/{document=**} { allow read, create, update: if true; allow delete: if isHQUser(); }
    match /purchase_orders/{poId} { allow read, create, update: if true; allow delete: if isHQUser(); }
