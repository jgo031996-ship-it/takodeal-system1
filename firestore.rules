    function staffRateProfileLink(id, before, after) {
      let auditId = after.get('staffRateAuditId', '');
      let path = /databases/$(database)/documents/staff_rate_changes/$(auditId);
      let audit = getAfter(path).data;
      return auditId is string && auditId.matches('^[A-Za-z0-9_-]{1,128}$')
        && !exists(path) && staffRateHQ(after.get('branch', ''))
        && (!before.keys().hasAny(['branch']) || before.branch == after.branch || staffRateHQ(before.branch))
        && audit.staffId == id && audit.branch == after.branch
