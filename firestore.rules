        && reviewed.processedAt == request.time && reviewed.processedBy == request.auth.token.email
        && reviewed.managerReply == data.reviewNote && reviewed.staffAcknowledged == false
        && data.staffId is string && data.staffName is string && data.branch is string
        && data.timeInLogId is string && data.timeInAt is string && data.scheduleFingerprint is string
        && start.type == 'TIME IN' && start.branch == data.branch && start.timestamp is timestamp
        && start.get('deleted', false) != true && !(start.get('status', '') in ['Voided', 'Cancelled'])
        && (start.get('staffId', '') == data.staffId || (start.get('staffId', '') == '' && start.staffName == person.cashierName))
        && person.cashierName == data.staffName && person.get('active', true) != false
        && person.get('archived', false) != true && person.get('blocked', false) != true
        && !(person.get('status', '') in ['Blocked', 'Revoked', 'Terminated', 'Resigned', 'Inactive', 'Disabled', 'Archived', 'Deleted'])
        && data.reviewedByUid == request.auth.uid && data.reviewedByEmail == request.auth.token.email
        && data.reviewedAt == request.time && data.reviewNote is string && data.reviewNote.size() <= 1500
        && (data.decision == 'Rejected' ? data.validUntil == null
          : data.scheduledEndAt is string && data.validUntil is timestamp && data.validUntil > request.time
            && data.validUntil <= request.time + duration.value(30, 'm')
            && data.validUntil <= start.timestamp + duration.value(24, 'h'));
    }
    // PIN-based attendance clients may read only a known request's decision.
    // They cannot manufacture an authoritative HQ approval through staff_requests.
    function emergencyShiftHQAny() {
      let email = isSignedIn() ? request.auth.token.get('email', '') : '';
      let grant = /databases/$(database)/documents/hq_email_access/$(email);
      return offlineOwner() || (isSignedIn() && request.auth.token.get('email_verified', false) == true
        && exists(grant) && get(grant).data.get('active', false) == true
        && get(grant).data.get('permissions', []) is list
