    }
    function sssSavedPayroll(row,staffId,staffName) {
      let saved = get(/databases/$(database)/documents/payroll_records/$(row.payrollRecordId)).data;
      let frozen = saved.frozenData;
      let net = saved.get('finalNetPay',null);
      let frozenNet = frozen.get('finalNetPay',net);
      let ids = [saved.get('staffId',''),frozen.get('staffId',''),frozen.get('profile',{}).get('staffId','')];
      let start = row.startDate;
      let end = row.endDate;
      return [saved.startDate,saved.endDate,frozen.get('start',start),frozen.get('end',end)] == [start,end,start,end]
        && start <= end && complianceDay(start) && complianceDay(end)
