      let oldRate = staffRateValue(before);
      let newRate = staffRateValue(after);
      return data.keys().hasOnly(['version', 'staffId', 'staffName', 'branch', 'previousBranch', 'eventType',
          'fromDailyRate', 'toDailyRate', 'inputHash', 'actorUid', 'actorEmail', 'actorName', 'recordedAt'])
        && data.keys().hasAll(['version', 'staffId', 'staffName', 'branch', 'previousBranch', 'eventType',
          'fromDailyRate', 'toDailyRate', 'inputHash', 'actorUid', 'actorEmail', 'actorName', 'recordedAt'])
        && id.matches('^[A-Za-z0-9_-]{1,128}$') && data.version == 1
        && after.get('salaryRateVersion', 0) != 1
        && data.staffId is string && data.staffId.matches('^[A-Za-z0-9_-]{1,128}$')
        && staffRateHQ(data.branch) && (!exists(profile) || before.get('branch','') == data.branch || staffRateHQ(before.get('branch', '')))
        && data.staffName == after.cashierName && data.branch == after.branch
        && data.previousBranch == before.get('branch', '')
        && staffRateValid(oldRate) && staffRateValid(newRate) && newRate != null
        && data.fromDailyRate == oldRate && data.toDailyRate == newRate
        && data.eventType == staffRateEvent(oldRate, newRate)
        && after.get('staffRateAuditId', '') == id
        && after.get('latestRateRaise', null) == staffRateMarker(before, data.eventType, id)
        && data.actorUid == request.auth.uid
        && data.actorEmail == request.auth.token.get('email', '').lower()
        && data.actorName is string && data.actorName.size() > 0 && data.actorName.size() <= 256
        && data.inputHash is string && data.inputHash.matches('^[a-f0-9]{64}$')
        && data.recordedAt == request.time;
    }
    function staffRateDatedMarker(before, data, id) {
      return data.appliesNow
        ? (data.eventType == 'increase' ? {'eventId': id, 'version': 1} : null)
        : before.get('latestRateRaise', null);
    }
    function staffRateLegacyCorrection(data, before, after) {
      let legacyId = data.get('legacyAuditId','__no_legacy__');
      let legacyPath = /databases/$(database)/documents/staff_rate_changes/$(legacyId);
      let legacy = exists(legacyPath) ? get(legacyPath).data : {};
      let salaryPath = /databases/$(database)/documents/staff_salary_rates/$(data.staffId);
      return data.keys().hasAny(['legacyAuditId']) && legacyId is string && legacyId.matches('^[A-Za-z0-9_-]{1,128}$')
        && exists(legacyPath) && legacy.version == 1 && legacy.eventType == 'increase' && legacy.get('effectiveDate',null) == null
        && before.get('salaryRateVersion',0) == 0 && before.get('salaryRateRevision',null) == null && !exists(salaryPath)
        && before.get('staffRateAuditId','') == legacyId && before.get('latestRateRaise',null) == {'eventId':legacyId,'version':1}
        && legacy.staffId == data.staffId && legacy.staffName == before.cashierName && legacy.branch == before.branch
        && legacy.fromDailyRate is number && legacy.fromDailyRate > 0 && staffRateValid(legacy.fromDailyRate)
        && legacy.toDailyRate is number && legacy.toDailyRate > legacy.fromDailyRate && staffRateValid(legacy.toDailyRate)
        && staffRateValue(before) == legacy.toDailyRate && data.fromDailyRate == legacy.fromDailyRate && data.toDailyRate == legacy.toDailyRate
        && data.eventType == 'increase' && data.rateChange == true && data.rateRevision == 1
        && data.appliesNow == (data.effectiveDate <= data.projectionDate)
        && data.projectionDailyRate == (data.appliesNow ? legacy.toDailyRate : legacy.fromDailyRate)
        && after.diff(before).affectedKeys().hasOnly(['hourlyRate','staffRateAuditId','latestRateRaise','salaryRateVersion','salaryRateRevision']);
    }
    function staffRateAuditCreateV2(data, id) {
      let profile = /databases/$(database)/documents/cashiers/$(data.staffId);
      let before = exists(profile) ? get(profile).data : {};
      let after = getAfter(profile).data;
      let salary = getAfter(/databases/$(database)/documents/staff_salary_rates/$(data.staffId)).data;
      return data.keys().hasOnly(['version','staffId','staffName','branch','previousBranch','eventType','fromDailyRate','toDailyRate','effectiveDate','rateChange','appliesNow','rateRevision','projectionDate','projectionDailyRate','inputHash','actorUid','actorEmail','actorName','recordedAt','legacyAuditId'])
        && data.keys().hasAll(['version','staffId','staffName','branch','previousBranch','eventType','fromDailyRate','toDailyRate','effectiveDate','rateChange','appliesNow','rateRevision','projectionDate','projectionDailyRate','inputHash','actorUid','actorEmail','actorName','recordedAt'])
        && data.version == 2 && id.matches('^[A-Za-z0-9_-]{1,128}$')
        && data.staffId is string && data.staffId.matches('^[A-Za-z0-9_-]{1,128}$')
        && staffRateHQ(data.branch) && (!exists(profile) || before.get('branch','') == data.branch || staffRateHQ(before.get('branch','')))
        && data.staffName == after.cashierName && data.branch == after.branch && data.previousBranch == before.get('branch','')
        && staffRateValid(data.fromDailyRate) && staffRateValid(data.toDailyRate) && data.toDailyRate != null
        && (data.keys().hasAny(['legacyAuditId'])
          ? staffRateLegacyCorrection(data,before,after)
          : before.get('salaryRateVersion',0) == 1 || data.fromDailyRate == staffRateValue(before))
        && data.rateChange is bool && data.eventType == (data.rateChange ? staffRateEvent(data.fromDailyRate,data.toDailyRate) : 'unchanged')
        && data.appliesNow is bool && (!data.appliesNow || data.rateChange && data.projectionDailyRate == data.toDailyRate)
        && data.effectiveDate is string && data.effectiveDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.projectionDate is string && data.projectionDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.projectionDailyRate is number && staffRateValid(data.projectionDailyRate) && staffRateValue(after) == data.projectionDailyRate
        && after.salaryRateVersion == 1 && after.salaryRateRevision == id && after.staffRateAuditId == id
        && after.get('latestRateRaise',null) == staffRateDatedMarker(before,data,id)
        && salary.staffId == data.staffId && salary.branch == data.branch && salary.revisionId == id && salary.revision == data.rateRevision
        && data.actorUid == request.auth.uid && data.actorEmail == request.auth.token.get('email','').lower()
        && data.actorName is string && data.actorName.size() > 0 && data.actorName.size() <= 256
        && data.inputHash is string && data.inputHash.matches('^[a-f0-9]{64}$') && data.recordedAt == request.time;
    }
    function staffRateAuditCreate(data, id) {
      return data.get('version',0) == 2 ? staffRateAuditCreateV2(data,id) : staffRateAuditCreateV1(data,id);
    }
    function staffSalaryWrite(id, before, after) {
      let auditId = after.revisionId;
      let auditPath = /databases/$(database)/documents/staff_rate_changes/$(auditId);
      let audit = getAfter(auditPath).data;
      let profilePath = /databases/$(database)/documents/cashiers/$(id);
      let priorRate = exists(profilePath) ? staffRateValue(get(profilePath).data) : null;
      let oldRates = before.get('rates', {});
      return after.keys().hasOnly(['version','staffId','branch','baselineDailyRate','rates','revision','revisionId','updatedAt','updatedByUid'])
        && after.keys().hasAll(['version','staffId','branch','baselineDailyRate','rates','revision','revisionId','updatedAt','updatedByUid'])
        && after.version == 1 && after.staffId == id && staffRateHQ(after.branch)
        && (!before.keys().hasAny(['branch']) || before.branch == after.branch || staffRateHQ(before.branch))
        && staffRateValid(after.baselineDailyRate)
        && (audit.keys().hasAny(['legacyAuditId'])
          ? (!before.keys().hasAny(['version']) && staffRateLegacyCorrection(audit,get(profilePath).data,getAfter(profilePath).data) && after.baselineDailyRate == audit.fromDailyRate)
          : after.baselineDailyRate == before.get('baselineDailyRate',priorRate))
        && after.revision is int && after.revision == before.get('revision',0) + 1
        && after.revisionId is string && after.revisionId.matches('^[A-Za-z0-9_-]{1,128}$')
        && after.rates is map && after.rates.size() <= 500
        && !exists(auditPath) && audit.version == 2 && audit.staffId == id && audit.branch == after.branch
        && audit.rateRevision == after.revision && audit.actorUid == request.auth.uid && audit.recordedAt == request.time
        && (audit.rateChange ? (!oldRates.keys().hasAny([auditId]) && after.rates.size() == oldRates.size() + 1
          && after.rates.diff(oldRates).affectedKeys().hasOnly([auditId])
          && after.rates[auditId] == {'dailyRate':audit.toDailyRate,'effectiveDate':audit.effectiveDate,'sequence':after.revision}) : after.rates == oldRates)
        && after.updatedAt == request.time && after.updatedByUid == request.auth.uid;
