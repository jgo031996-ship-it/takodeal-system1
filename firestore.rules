      }
      allow create, update: if docVaultProfileWrite(request.resource.data,resource == null ? null : resource.data);
      allow delete: if false;
      match /files/{kind} {
        allow get, list: if docVaultOwn(staffId) || docVaultScope(staffId);
        function docVaultFileCreate(data) {
          return docVaultUpload(staffId, kind, data)
            && data.version == 1
            && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/versions/$(data.uploadId)).data == data;
        }
        allow create: if docVaultFileCreate(request.resource.data);
        function docVaultFileUpdate(data,before) {
          return (docVaultUpload(staffId, kind, data)
              && data.version == before.version + 1 && data.uploadId != before.uploadId
              && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/versions/$(data.uploadId)).data == data)
            || (docVaultReview(staffId, kind, before, data)
              && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/versions/$(before.uploadId)).data == data);
        }
        allow update: if docVaultFileUpdate(request.resource.data,resource == null ? null : resource.data);
        allow delete: if false;
      }
      match /versions/{uploadId} {
        allow get: if docVaultOwn(staffId) || (resource != null && docVaultHQ(resource.data.branch));
        allow list: if docVaultOwn(staffId) || docVaultHQ(resource.data.branch);
        function docVaultVersionCreate(data) {
          return docVaultUpload(staffId, data.group, data)
            && uploadId == data.uploadId
            && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/files/$(data.group)).data == data;
        }
        allow create: if docVaultVersionCreate(request.resource.data);
        function docVaultVersionUpdate(data,before) {
          return docVaultReview(staffId, before.group, before, data)
            && uploadId == before.uploadId
            && getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/files/$(before.group)).data == data;
        }
        allow update: if docVaultVersionUpdate(request.resource.data,resource == null ? null : resource.data);
        allow delete: if false;
      }
      match /reviews/{reviewId} {
        allow get: if docVaultOwn(staffId) || (resource != null && docVaultHQ(resource.data.branch));
        allow list: if docVaultOwn(staffId) || docVaultHQ(resource.data.branch);
        function docVaultAuditCreate(data) {
          let eligible = docVaultId(reviewId)
            && data.keys().hasOnly(['staffId', 'branch', 'recordVersion', 'group', 'uploadId', 'status', 'note', 'actorUid', 'recordedAt']) && data.size() == 9
            && data.staffId == staffId && docVaultHQ(data.branch)
            && docVaultKind(data.group) && docVaultId(data.uploadId)
            && data.status in ['approved', 'rejected']
            && data.note is string && data.note.size() <= 300
            && data.actorUid == request.auth.uid && data.recordedAt == request.time;
          let saved = eligible ? getAfter(/databases/$(database)/documents/staff_private_documents/$(staffId)/files/$(data.group)).data : {};
          return eligible && saved.reviewId == reviewId
            && saved.version == data.recordVersion
            && saved.branch == data.branch
            && saved.uploadId == data.uploadId;
        }
        allow create: if docVaultAuditCreate(request.resource.data);
        allow update, delete: if false;
      }
    }
  }
}
