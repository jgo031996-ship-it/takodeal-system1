    }
    match /staff_rate_changes/{auditId} {
      allow get: if (resource == null && staffRateHQAny()) || (resource != null && staffRateHQ(resource.data.branch));
      allow list: if staffRateHQ(resource.data.branch);
      allow create: if staffRateAuditCreate(request.resource.data, auditId);
      allow update, delete: if false;
    }
    match /staff_salary_rates/{staffId} {
      allow get: if (resource == null && staffRateHQAny()) || (resource != null && (staffRateHQ(resource.data.branch) || docVaultOwn(staffId)));
      allow list: if staffRateHQ(resource.data.branch);
