      allow update,delete: if false;
    }
    match /stock_logs/{logId} { allow read, create, update: if true; allow delete: if isOwner(); }
    // Only the verified Google Owner may issue these reviewed HR markers.
    // Existing ordinary profile/attendance fields retain their preceding policy.
    function protectedHROwner() {
      return offlineOwner() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function protectedHRId(value) { return value is string && value.matches('^[-A-Za-z0-9_]{1,180}$'); }
    function protectedHRReason(value) { return value is string && value.trim().size() >= 8 && value.size() <= 1500; }
    function protectedHRDate(value) {
      return value is string && value.matches('^[1-9][0-9]{3}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }
    function amendmentReviewMarker(marker, before, logId) {
      let prior = before.get('scheduleAmendmentReview', {});
      let auditPath = /databases/$(database)/documents/attendance_amendment_reviews/$(marker.auditId);
      let audit = getAfter(auditPath).data;
      return protectedHROwner() && marker is map
        && marker.keys().hasOnly(['version','revision','auditId','sourceFingerprint','choice','lateMinutes','exempt','reason','actorUid','actorEmail','reviewedAt'])
        && before.type == 'TIME IN' && protectedHRId(before.staffId)
        && marker.version == 1 && marker.revision is int && marker.revision == prior.get('revision',0) + 1
        && marker.auditId == 'amendment-' + logId + '-' + string(marker.revision)
        && marker.sourceFingerprint is string && marker.sourceFingerprint.size() > 0 && marker.sourceFingerprint.size() <= 30000
        && marker.choice in ['Keep saved lateness decision','Use corrected schedule minutes','Waive lateness']
        && marker.lateMinutes is int && marker.lateMinutes >= 0 && marker.lateMinutes <= 1080 && marker.exempt is bool
        && (marker.choice != 'Waive lateness' || marker.lateMinutes == 0 && marker.exempt == true)
        && protectedHRReason(marker.reason) && marker.actorUid == request.auth.uid
        && marker.actorEmail == request.auth.token.email && marker.reviewedAt == request.time
        && !exists(auditPath) && audit.attendanceId == logId && audit.staffId == before.staffId
        && audit.staffName == before.staffName && audit.branch == before.branch
        && audit.previousReview == before.get('scheduleAmendmentReview',null)
        && audit.version == marker.version && audit.revision == marker.revision && audit.auditId == marker.auditId
        && audit.sourceFingerprint == marker.sourceFingerprint && audit.choice == marker.choice && audit.lateMinutes == marker.lateMinutes
        && audit.exempt == marker.exempt && audit.reason == marker.reason && audit.actorUid == marker.actorUid
        && audit.actorEmail == marker.actorEmail && audit.reviewedAt == marker.reviewedAt;
    }
    function amendmentReviewAudit(data, auditId) {
      let path = /databases/$(database)/documents/attendance_logs/$(data.attendanceId);
      let before = get(path).data;
      let after = getAfter(path).data;
      let decision = {'lateMinutes':before.get('lateMinutes',null),'reviewedLateMinutes':before.get('reviewedLateMinutes',null),'lateExempted':before.get('lateExempted',false) == true,'lateDecision':before.get('lateDecision',null),'lateReviewRequestId':before.get('lateReviewRequestId',null)};
      return protectedHROwner() && protectedHRId(data.attendanceId)
        && data.keys().hasOnly(['version','revision','auditId','sourceFingerprint','choice','lateMinutes','exempt','reason','actorUid','actorEmail','reviewedAt','attendanceId','staffId','staffName','branch','workDate','previousReview','previousDecision'])
        && data.auditId == auditId && protectedHRDate(data.workDate) && data.previousDecision == decision
        && after.diff(before).affectedKeys().hasOnly(['scheduleAmendmentReview'])
