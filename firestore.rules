    match /acknowledgments/{document=**} { allow read, write: if true; }
    match /reviews/{document=**} { allow read, create: if true; allow update, delete: if isHQUser(); }
    match /customer_feedback/{document=**} { allow create: if true; allow read, update, delete: if isHQUser(); }
