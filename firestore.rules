    function sssRecord(data,id) {
      let staff = get(/databases/$(database)/documents/cashiers/$(data.staffId)).data;
      let ledger = getAfter(/databases/$(database)/documents/staff_sss_allocation_totals/$(data.staffId)).data;
      let rows = data.allocations;
      let employee = data.employeeShareCents;
      let employer = data.employerShareCents;
      let ec = data.ecShareCents;
      let total = data.totalCents;
      return data.keys().hasOnly(['version','recordId','staffId','staffName','branch','contributionMonth','remittedDate','employeeShareCents','employerShareCents','ecShareCents','totalCents','reference','referenceKey','notes','evidenceReference','allocations','proof','intent','recordedAt','recordedByUid','recordedBy'])
        && data.version == 1 && data.recordId == id && id.matches('^sss-[a-f0-9]{64}$') && complianceId(data.staffId)
        && data.staffName == staff.get('cashierName',staff.get('fullName',staff.get('name',''))) && data.branch == staff.branch
        && complianceMonth(data.contributionMonth) && complianceDay(data.remittedDate)
        && complianceText(data.reference,120) && data.reference.size() >= 3 && complianceText(data.referenceKey,240) && data.referenceKey.size()>0
        && complianceText(data.notes,1500) && complianceText(data.evidenceReference,500) && complianceText(data.intent,30000)
