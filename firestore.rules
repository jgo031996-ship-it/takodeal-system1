      allow create: if selectorTransactionsCreate(request.resource.data);
      function selectorTransactionsUpdate(data,before) {
        return data.diff(before).affectedKeys().hasAny(['cancelledFoodPurchaseId','cancelledFoodAllocationVersion','cancelledFoodLastPurchaseId','cancelledFoodPurchasedUnits'])
        ? (before.branch == data.branch
          && (data.get('cancelledFoodAllocationVersion',0) == 1
