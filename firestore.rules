        && (!(request.resource.data.diff(resource.data).affectedKeys().hasAny(['latestRateRaise', 'staffRateAuditId','salaryRateVersion','salaryRateRevision'])
          || (resource.data.get('salaryRateVersion',0) == 1 && request.resource.data.diff(resource.data).affectedKeys().hasAny(['hourlyRate','dailyRate','branch'])))
          || staffRateProfileLink(cashierId, resource.data, request.resource.data));
