      return offlineOwner() && before.status in ['Pending Review','Approved']
        && after.diff(before).affectedKeys().hasOnly(['status','amount','effectiveDate','noticeRevision','lawfulBasis','authorityReference','finding','ownerReply','updatedAt'])
        && after.noticeRevision == before.noticeRevision + 1 && after.updatedAt == request.time && after.status == row.status
        && cashShortageLinks(row,charge,after,id) && row.reviewedAt == request.time
        && (row.status == 'Dismissed' ? after.ownerReply == row.dismissalReason : (after.ownerReply == row.finding && after.lawfulBasis == row.lawfulBasis && after.authorityReference == row.authorityReference && after.finding == row.finding));
    }
    function cashShortagePayrollRow(item,map,recordId) {
      let row = getAfter(/databases/$(database)/documents/cash_shortage_reviews/$(item.id)).data;
      return item.keys().hasOnly(['id','amount']) && item.id is string && item.amount is number && item.amount > 0 && map[item.id] == item.amount
        && row.status == 'Paid' && row.amount == item.amount && row.payrollRecordId == recordId && row.paidAt == request.time;
    }
    function cashShortageRow(rows,map,index,recordId) { return rows.size() <= index || cashShortagePayrollRow(rows[index],map,recordId); }
    function cashShortageProtectedPayroll(payroll) {
      return payroll.get('cashShortageSettlements',{}).size() > 0 || payroll.get('frozenData',{}).get('cashShortages',0) > 0 || payroll.get('frozenData',{}).get('cashShortageRows',[]).size() > 0;
    }
    function cashShortageSignedAcknowledgment(before,after) {
      return docVaultOwn(before.staffId) && before.get('acknowledged',false) == false
        && after.diff(before).affectedKeys().hasOnly(['acknowledged','acknowledgedAt','signatureBase64'])
        && after.acknowledged == true && after.acknowledgedAt == request.time
        && after.signatureBase64 is string && after.signatureBase64.size() >= 64 && after.signatureBase64.size() <= 500000
        && (after.signatureBase64.size() - 22) % 4 == 0
        && after.signatureBase64.matches('^data:image/png;base64,iVBORw0KGgo[A-Za-z0-9+/]+={0,2}$');
    }
    // Validate the full tuple list once per payroll, not once for each of the three protected case records.
    function cashShortagePayrollMetadata(payroll,recordId) {
      let rows = payroll.get('frozenData',{}).get('cashShortageRows',[]);
      let map = payroll.get('cashShortageSettlements',{});
      return rows is list && rows.size() <= 6 && rows.toSet().size() == rows.size()
        && map is map && map.size() == rows.size()
        && cashShortageRow(rows,map,0,recordId) && cashShortageRow(rows,map,1,recordId) && cashShortageRow(rows,map,2,recordId) && cashShortageRow(rows,map,3,recordId) && cashShortageRow(rows,map,4,recordId) && cashShortageRow(rows,map,5,recordId)
        && payroll.get('frozenData',{}).get('cashShortages',0) == (rows.size() > 0 ? rows[0].amount : 0) + (rows.size() > 1 ? rows[1].amount : 0) + (rows.size() > 2 ? rows[2].amount : 0) + (rows.size() > 3 ? rows[3].amount : 0) + (rows.size() > 4 ? rows[4].amount : 0) + (rows.size() > 5 ? rows[5].amount : 0)
        && (rows.size() == 0 || (offlineOwner() && payroll.frozenData.isPaid == true && payroll.processedAt == request.time && payroll.processedBy == request.auth.token.email && rows.size() + payroll.get('refundSettlements',{}).size() <= 6));
    }
    function cashShortagePaidChange(before,after) {
      return offlineOwner() && before.type == 'Cash Shortage' && before.status in ['Approved','Unpaid'] && before.amount > 0
        && !before.keys().hasAny(['paidAt','payrollRecordId','partialPaid','amountPaid','payrollFrozen'])
        && after.diff(before).affectedKeys().hasOnly(['status','paidAt','payrollRecordId']) && after.status == 'Paid' && after.paidAt == request.time;
    }
    function cashShortageCompanionPaid(before,after,id,revision) {
      let row = getAfter(/databases/$(database)/documents/cash_shortage_reviews/$(id)).data;
      return cashShortagePaidChange(before,after) && row.status == 'Paid' && row.staffId == before.staffId && row.amount == before.amount && row.revision == revision
        && row.payrollRecordId == after.payrollRecordId && row.paidAt == request.time;
    }
    match /cash_shortage_reviews/{id} {
      function cashShortageSource(data,id) {
        let shift = get(/databases/$(database)/documents/shifts/$(data.sourceShiftId)).data;
        let staff = get(/databases/$(database)/documents/cashiers/$(data.staffId)).data;
        return id == 'cash-shortage-' + data.sourceShiftId && data.sourceShiftId.matches('^[-A-Za-z0-9_]{1,160}$')
          && shift.status == 'Closed' && shift.active == false && shift.startTime is timestamp && shift.endTime is timestamp && shift.endTime >= shift.startTime
          && shift.expectedCash is number && shift.expectedCash >= 0 && shift.declaredCash is number && shift.declaredCash >= 0
          && data.expectedCash == int(shift.expectedCash * 100 + 0.5) / 100.0 && data.declaredCash == int(shift.declaredCash * 100 + 0.5) / 100.0
          && data.sourceShortageCents is int && data.sourceShortageCents > 5
          && data.sourceShortageCents == int(shift.expectedCash * 100 + 0.5) - int(shift.declaredCash * 100 + 0.5)
          && data.sourceShortage == data.sourceShortageCents / 100.0 && data.branch == shift.branch
          && data.staffName == staff.cashierName && data.staffBranch == staff.branch
          && staff.get('active',true) != false && staff.get('archived',false) != true && staff.get('blocked',false) != true
          && !(staff.get('status','').lower() in ['blocked','inactive','disabled','revoked','terminated','archived','resigned','deleted'])
          && data.sourceReceiptId == data.sourceShiftId && data.sourcePlatform == 'Z-reading'
          && data.sourceFingerprint is string && data.sourceFingerprint.size() > 0 && data.sourceFingerprint.size() <= 30000;
      }
      function cashShortageCreate(data,id) {
        let charge = staffDeductionAfter(id);
        let notice = getAfter(/databases/$(database)/documents/staff_deduction_notices/$(id)).data;
        return offlineOwner() && cashShortageSource(data,id) && cashShortageLinks(data,charge,notice,id)
          && data.keys().hasOnly(['schemaVersion','id','type','sourceShiftId','sourceReceiptId','sourcePlatform','branch','staffId','staffName','staffBranch','expectedCash','declaredCash','sourceShortage','sourceShortageCents','sourceFingerprint','details','evidence','revision','status','amount','authorizedAmount','effectiveDate','openIntent','createdAt','createdByUid','createdBy'])
          && data.status == 'Pending Review' && data.amount == 0 && data.revision == 1 && data.effectiveDate == null
          && charge.status == 'Pending Review' && notice.status == 'Pending Review' && notice.replyRevision == 0 && notice.readRevision == 0
          && data.details is string && data.details.size() >= 8 && data.details.size() <= 1500
          && data.evidence is string && data.evidence.size() >= 5 && data.evidence.size() <= 1000
          && data.openIntent is string && data.openIntent.size() > 0 && data.openIntent.size() <= 40000
          && data.createdAt == request.time && data.createdByUid == request.auth.uid && data.createdBy == request.auth.token.email;
      }
      function cashShortageReview(before,after,id) {
        let charge = staffDeductionAfter(id);
        let notice = getAfter(/databases/$(database)/documents/staff_deduction_notices/$(id)).data;
        let response = get(/databases/$(database)/documents/staff_deduction_notices/$(id)).data;
        let due = after.get('effectiveDate','2000-01-01') == null ? ['2000','01','01'] : after.effectiveDate.split('-');
        return offlineOwner() && before.status in ['Pending Review','Approved'] && !before.keys().hasAny(['paidAt','payrollRecordId','partialPaid','amountPaid','payrollFrozen'])
          && after.diff(before).affectedKeys().hasOnly(['status','amount','authorizedAmount','effectiveDate','revision','lawfulBasis','authorityReference','finding','responsibilityConfirmed','lawfulAuthorityConfirmed','replyRevisionReviewed','approvalIntent','reviewedAt','reviewedBy','dismissalReason'])
          && after.revision == before.revision + 1 && after.reviewedAt == request.time && after.reviewedBy == request.auth.token.email
          && cashShortageLinks(after,charge,notice,id) && notice.status == after.status
          && (after.status == 'Dismissed' ? (after.amount == 0 && charge.status == 'Dismissed' && after.dismissalReason is string && after.dismissalReason.size() >= 8 && after.dismissalReason.size() <= 1500)
            : (after.status == 'Approved' && charge.status == 'Unpaid' && cashShortageSource(after,id)
              && after.amount is number && after.amount > 0 && after.amount <= after.sourceShortageCents / 100.0 && after.amount == int(after.amount * 100 + 0.5) / 100.0
              && after.effectiveDate is string && after.effectiveDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
              && timestamp.date(int(due[0]),int(due[1]),int(due[2])) + duration.value(16,'h') > request.time
              && after.lawfulBasis in ['Legal authority permitting this deduction','Court / authorized agency order']
              && after.responsibilityConfirmed == true && after.lawfulAuthorityConfirmed == true
              && after.authorityReference is string && after.authorityReference.size() >= 8 && after.authorityReference.size() <= 1500
              && after.finding is string && after.finding.size() >= 15 && after.finding.size() <= 1500
              && response.replyRevision is int && response.replyRevision > 0 && response.staffReply is string && response.staffReply.size() > 0
              && after.replyRevisionReviewed == response.replyRevision && notice.replyRevision == response.replyRevision));
      }
      function cashShortageCasePaid(before,after,id) {
        let charge = staffDeductionAfter(id);
        let notice = getAfter(/databases/$(database)/documents/staff_deduction_notices/$(id)).data;
        let payroll = getAfter(/databases/$(database)/documents/payroll_records/$(after.payrollRecordId)).data;
        // Links and all financial/source fields were established at authorization and are immutable in this transition.
        return cashShortagePaidChange(before,after) && before.status == 'Approved'
          && charge.status == 'Paid' && notice.status == 'Paid' && charge.amount == before.amount && notice.amount == before.amount
          && charge.reviewRevision == before.revision && notice.noticeRevision == before.revision
          && notice.replyRevision == before.replyRevisionReviewed && before.replyRevisionReviewed > 0 && notice.staffReply is string && notice.staffReply.size() > 0
          && charge.payrollRecordId == after.payrollRecordId && notice.payrollRecordId == after.payrollRecordId && charge.paidAt == request.time && notice.paidAt == request.time
          && payroll.staffId == before.staffId && payroll.frozenData.branch == before.staffBranch && payroll.frozenData.name == before.staffName
          && payroll.processedAt == request.time && payroll.frozenData.isPaid == true && before.effectiveDate <= payroll.endDate
          && payroll.cashShortageSettlements[id] == before.amount && {'id':id,'amount':before.amount} in payroll.frozenData.cashShortageRows;
      }

      allow get, list: if offlineOwner() || staffRateHQ(resource.data.staffBranch);
      allow create: if cashShortageCreate(request.resource.data,id);
      function selectorCashShortageReviewsUpdate(data,before) {
        return data.status == 'Paid' ? cashShortageCasePaid(before,data,id) : cashShortageReview(before,data,id);
      }
      allow update: if selectorCashShortageReviewsUpdate(request.resource.data,resource == null ? null : resource.data);
      allow delete: if false;
    }
    match /staff_deduction_notices/{id} {
      allow get, list: if offlineOwner() || docVaultOwn(resource.data.staffId) || (cashShortageKind(resource.data,id) && staffRateHQ(resource.data.branch));
      function selectorStaffDeductionNoticesCreate(data) {
        return cashShortageKind(data,id) ? cashShortageNoticeCreate(data,id) : refundNoticeCreate(data,id);
      }
      allow create: if selectorStaffDeductionNoticesCreate(request.resource.data);
      function selectorStaffDeductionNoticesUpdate(data,before) {
        return cashShortageKind(before,id) || cashShortageKind(data,id)
        ? (data.status == 'Paid' && before.status != 'Paid' ? cashShortageCompanionPaid(before,data,id,before.noticeRevision) : (refundNoticeStaffUpdate(before,data) || cashShortageNoticeReview(before,data,id)))
        : refundNoticeStaffUpdate(before,data)
        || refundNoticeOwnerUpdate(before,data,id) || refundPaid(before,data,id);
      }
      allow update: if selectorStaffDeductionNoticesUpdate(request.resource.data,resource == null ? null : resource.data);
      allow delete: if false;
    }

    match /online_order_incidents/{id} {
      function onlineIncidentCreate(data, id) {
        let sale = transactionBefore(data.sourceSaleId);
        let staff = get(/databases/$(database)/documents/cashiers/$(data.staffId)).data;
        let charge = staffDeductionAfter(id);
        return offlineOwner() && data.version == 1 && data.id == id
          && id == 'online-refund-' + data.sourceSaleId
          && data.sourceReceiptId == sale.receiptId && data.branch == sale.branch
          && sale.paymentMethod.lower() in ['grab','foodpanda','panda']
          && sale.get('cancelledFoodSourceId', '') == '' && !sale.keys().hasAny(['preparedCancellation'])
          && !(sale.get('status', '') in ['Voided','Parked','mobile_queue'])
          && data.staffName == staff.get('cashierName', staff.get('fullName', staff.get('name', '')))
          && staff.get('active', true) == true && staff.get('archived', false) == false
          && data.type == 'Online Order Refund' && data.category == 'Online Order Refunds'
          && data.status == 'Pending Review' && data.amount == 0 && data.reviewRevision == 0
          && data.refundAmount is number && data.refundAmount >= 0 && data.refundAmount <= sale.netTotal
          && data.orderAmount == sale.netTotal && data.refundConfirmed is bool
          && (data.refundConfirmed || data.refundAmount == 0)
          && data.createdBy == request.auth.token.email && data.createdAt == request.time
          && data.evidence is string && data.evidence.size() > 0 && data.evidence.size() <= 1000
          && data.details is string && data.details.size() > 0 && data.details.size() <= 1500
          && data.reason in ['wrong_food','wrong_instructions','missing_item','other']
          && charge.incidentId == id && charge.sourceSaleId == data.sourceSaleId
          && charge.staffId == data.staffId && charge.staffName == data.staffName
          && charge.proposedAmount == data.refundAmount && charge.status == data.status && charge.amount == 0;
      }
      function onlineIncidentReview(before, after, id) {
        let charge = staffDeductionAfter(id);
        return offlineOwner() && before.status == 'Pending Review' && before.amount == 0
          && after.diff(before).affectedKeys().hasOnly(['status','staffResponse','reviewNote','reviewedAt','reviewedBy','reviewRevision'])
          && after.status in ['Pending Review','Dismissed'] && after.reviewRevision == before.reviewRevision + 1
          && after.staffResponse is string && after.staffResponse.size() > 0 && after.staffResponse.size() <= 1500
          && after.reviewNote is string && after.reviewNote.size() > 0 && after.reviewNote.size() <= 1500
          && after.reviewedAt == request.time && after.reviewedBy == request.auth.token.email
          && charge.status == after.status && charge.amount == 0
          && charge.responseRecorded == true && charge.reviewedAt == request.time;
      }
      function directIncidentCreate(data, id) {
        let sale = transactionBefore(data.sourceSaleId);
        let staff = get(/databases/$(database)/documents/cashiers/$(data.staffId)).data;
        let charge = staffDeductionAfter(id);
        let notice = getAfter(/databases/$(database)/documents/staff_deduction_notices/$(id)).data;
        return offlineOwner() && data.version == 2 && data.id == id && id == 'online-refund-' + data.sourceSaleId
          && data.sourceReceiptId == sale.receiptId && data.branch == sale.branch && data.orderAmount == sale.netTotal
          && sale.paymentMethod.lower() in ['grab','foodpanda','panda'] && sale.get('cancelledFoodSourceId','') == ''
          && !sale.keys().hasAny(['preparedCancellation']) && !(sale.get('status','') in ['Voided','Parked','mobile_queue'])
          && data.sourcePlatform == (sale.paymentMethod.lower() == 'grab' ? 'Grab' : 'Foodpanda')
          && data.staffName == staff.get('cashierName',staff.get('fullName',staff.get('name','')))
          && staff.get('active',true) == true && staff.get('archived',false) == false
          && !(staff.get('status','') in ['Blocked','Inactive','Terminated','Archived','Resigned','Deleted'])
          && data.type == 'Online Order Refund' && data.category == 'Online Order Refunds' && data.policyReviewed == true
          && data.refundAmount is number && data.refundAmount >= 0 && data.refundAmount <= sale.netTotal
          && data.refundConfirmed is bool && (data.refundConfirmed || data.refundAmount == 0)
          && data.amount == data.refundAmount && data.authorizedAmount == data.amount
          && data.status == (data.amount > 0 ? 'Unpaid' : 'No Charge') && data.reviewRevision == 0
          && data.createdAt == request.time && data.createdBy == request.auth.token.email
          && data.reason in ['wrong_food','wrong_instructions','missing_item','other']
          && data.details is string && data.details.size() > 0 && data.details.size() <= 1500
          && data.evidence is string && data.evidence.size() > 0 && data.evidence.size() <= 1000
          && data.reviewNote is string && data.reviewNote.size() > 0 && data.reviewNote.size() <= 1500
          && charge.incidentId == id && charge.staffId == data.staffId && charge.staffName == data.staffName
          && charge.sourceSaleId == data.sourceSaleId && charge.sourceReceiptId == data.sourceReceiptId
          && charge.amount == data.amount && charge.status == data.status && charge.authorizedAmount == data.amount
          && notice.id == id && notice.incidentId == id && notice.staffId == data.staffId && notice.amount == data.amount && notice.status == data.status;
      }
      function directIncidentReview(before,after,id) {
        let charge = staffDeductionAfter(id);
        let notice = getAfter(/databases/$(database)/documents/staff_deduction_notices/$(id)).data;
        return offlineOwner() && before.status in ['Pending Review','Unpaid']
          && after.diff(before).affectedKeys().hasOnly(['status','amount','authorizedAmount','policyReviewed','staffResponse','reviewNote','reviewedAt','reviewedBy','reviewRevision'])
          && after.status in ['Unpaid','No Charge','Dismissed'] && after.reviewRevision == before.reviewRevision + 1
          && after.amount == (after.status == 'Dismissed' ? 0 : before.refundAmount) && after.authorizedAmount == after.amount
          && (after.status == 'Dismissed' || (after.policyReviewed == true && (before.refundConfirmed || before.refundAmount == 0)))
          && after.staffResponse is string && after.staffResponse.size() > 0 && after.staffResponse.size() <= 1500
          && after.reviewNote is string && after.reviewNote.size() > 0 && after.reviewNote.size() <= 1500
          && after.reviewedAt == request.time && after.reviewedBy == request.auth.token.email
          && charge.amount == after.amount && charge.authorizedAmount == after.amount && charge.status == after.status
          && charge.responseRecorded == true && notice.incidentId == id && notice.staffId == after.staffId
          && notice.amount == after.amount && notice.status == after.status;
      }

      allow get, list: if offlineOwner();
      allow create: if onlineIncidentCreate(request.resource.data, id) || directIncidentCreate(request.resource.data,id);
      function selectorOnlineOrderIncidentsUpdate(data,before) {
        return onlineIncidentReview(before, data, id) || directIncidentReview(before,data,id) || refundPaid(before,data,id);
      }
      allow update: if selectorOnlineOrderIncidentsUpdate(request.resource.data,resource == null ? null : resource.data);
      allow delete: if false;
    }
    match /staff_deductions/{deductId} {
      allow read: if true;
      function selectorStaffDeductionsCreate(data) {
        return cashShortageKind(data,deductId) ? cashShortageChargeCreate(data,deductId)
        : data.get('type', '') == 'Online Order Refund' || deductId.matches('online-refund-.*')
        ? (onlineIncidentCharge(data, deductId) || directIncidentCharge(data,deductId))
        : data.get('type', '') == 'Cancelled Food Purchase'
        ? cancelledFoodChargeLink(data, deductId)
        : isHQUser();
      }
      allow create: if selectorStaffDeductionsCreate(request.resource.data);
      function selectorStaffDeductionsUpdate(data,before) {
        return cashShortageKind(before,deductId) || cashShortageKind(data,deductId)
        ? (data.status == 'Paid' ? cashShortageCompanionPaid(before,data,deductId,before.reviewRevision) : cashShortageChargeReview(before,data,deductId))
        : before.get('type', '') == 'Online Order Refund' || data.get('type', '') == 'Online Order Refund' || deductId.matches('online-refund-.*')
        ? (offlineOwner() && before.type == 'Online Order Refund' && data.amount == 0
          && before.status == 'Pending Review'
          && data.diff(before).affectedKeys().hasOnly(['status','responseRecorded','reviewedAt','reviewedBy'])
          && data.responseRecorded == true
          && data.status in ['Pending Review','Dismissed']
          && data.status == getAfter(/databases/$(database)/documents/online_order_incidents/$(deductId)).data.status
          && data.reviewedAt == request.time && data.reviewedBy == request.auth.token.email) || (before.get('type','') == 'Online Order Refund' && (directChargeReview(before,data,deductId) || refundPaid(before,data,deductId)))
        : before.get('type', '') == 'Cancelled Food Purchase'
        ? verifiedHQ(before.branch) : isHQUser();
      }
      allow update: if selectorStaffDeductionsUpdate(request.resource.data,resource == null ? null : resource.data);
      function selectorStaffDeductionsDelete(before) {
        return !cashShortageKind(before,deductId) && before.get('type', '') != 'Online Order Refund'
        && (before.get('type', '') == 'Cancelled Food Purchase' ? verifiedHQ(before.branch) : isHQUser());
      }
      allow delete: if selectorStaffDeductionsDelete(resource == null ? null : resource.data);
    }
    match /staff_bonuses/{bonusId} { allow read: if true; allow write: if isHQUser(); }
    // Owner compliance records are independent of payroll and bank postings.
    function complianceOwner() {
      return offlineOwner() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function complianceText(value, maximum) { return value is string && value.size() <= maximum; }
    function complianceId(value) { return value is string && value.matches('^[A-Za-z0-9_-]{1,180}$'); }
    function complianceDay(value) { return value is string && value.matches('^2[01][0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'); }
    function complianceMonth(value) { return value is string && value.matches('^2[01][0-9]{2}-(0[1-9]|1[0-2])$'); }
    function permitRecordDay(value) { return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'); }
    function complianceCents(value) { return value is int && value >= 0 && value <= 1000000000; }
    function complianceFileDescriptor(value, kind, recordId) {
      return value is map && value.keys().hasOnly(['id','kind','recordId','fileName','contentType','size','sha256','chunkCount'])
        && value.id is string && value.id.matches('^[a-fA-F0-9-]{36}$') && value.kind == kind && value.recordId == recordId
        && complianceText(value.fileName,160) && value.fileName.size() > 0
        && value.contentType in ['application/pdf','image/jpeg','image/png']
        && value.size is int && value.size > 0 && value.size <= 2097152
        && value.sha256 is string && value.sha256.matches('^[a-f0-9]{64}$')
        && value.chunkCount is int && value.chunkCount >= 1 && value.chunkCount <= 15
        && value.chunkCount == int(math.ceil(value.size / 147456.0));
    }
    function complianceAttachment(value, kind, recordId) {
      return value == null || (complianceFileDescriptor(value,kind,recordId)
        && getAfter(/databases/$(database)/documents/owner_record_files/$(value.id)).data.diff(value).affectedKeys().hasOnly([
          'schemaVersion','chunkSize','operationId','createdAt','createdByUid','createdByEmail']));
    }
    function permitBusiness(data) {
      return {'branch':data.branch,'permitType':data.permitType,'permitName':data.permitName,'agency':data.agency,
        'permitNumber':data.permitNumber,'issueDate':data.issueDate,'expiryDate':data.expiryDate,'renewalStatus':data.renewalStatus,
        'notes':data.notes,'attachment':data.attachment,'archived':data.archived};
    }
    function permitShape(data, id) {
      return data.keys().hasOnly(['schemaVersion','recordId','branch','permitType','permitName','agency','permitNumber','issueDate','expiryDate','renewalStatus','notes','attachment','archived','revision','createdAt','createdByUid','createdByEmail','updatedAt','updatedByUid','updatedByEmail','lastChangeId'])
        && data.schemaVersion == 1 && data.recordId == id && complianceId(id)
        && complianceText(data.branch,120) && data.branch.size() > 0
        && complianceText(data.permitType,80) && data.permitType.size() > 0
        && complianceText(data.permitName,160) && data.permitName.size() > 0
        && complianceText(data.agency,160) && complianceText(data.permitNumber,120)
        && (data.issueDate == '' || permitRecordDay(data.issueDate)) && (data.expiryDate == '' || permitRecordDay(data.expiryDate))
        && (data.issueDate == '' || data.expiryDate == '' || data.expiryDate >= data.issueDate)
        && data.renewalStatus in ['Not started','Preparing','Submitted','Completed','Not required']
        && complianceText(data.notes,4000) && data.archived is bool && data.revision is int && data.revision > 0
        && complianceAttachment(data.attachment,'government_permit',id) && complianceId(data.lastChangeId)
        && data.updatedAt == request.time && data.updatedByUid == request.auth.uid && data.updatedByEmail == request.auth.token.email;
    }
    function permitChange(data,id,before,action) {
      let event = getAfter(/databases/$(database)/documents/government_permits/$(id)/changes/$(data.lastChangeId)).data;
      return event.schemaVersion == 1 && event.operationId == data.lastChangeId && event.recordId == id
        && event.revision == data.revision && event.action == action && event.before == before && event.after == permitBusiness(data)
        && event.recordedAt == request.time && event.recordedByUid == request.auth.uid && event.recordedByEmail == request.auth.token.email;
    }
    match /government_permits/{id} {
      allow read: if complianceOwner();
      function selectorGovernmentPermitsCreateUpdate(data,before) {
