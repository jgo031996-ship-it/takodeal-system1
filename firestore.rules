    function staffRateHQAny() {
      let email = isSignedIn() ? request.auth.token.get('email', '') : '';
      let path = /databases/$(database)/documents/hq_email_access/$(email);
      return offlineOwner() || (isSignedIn()
        && request.auth.token.get('email_verified', false) == true && email != ''
        && exists(path) && get(path).data.get('active', false) == true
        && get(path).data.get('permissions', []) is list
        && get(path).data.get('permissions', []).hasAny(['all', 'payroll', 'feed'])
